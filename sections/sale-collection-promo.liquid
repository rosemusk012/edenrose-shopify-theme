{%- assign promo_collection = section.settings.collection -%}
<section class="sale-collection-promo" aria-labelledby="SalePromo-{{ section.id }}">
  <div class="page-width sale-collection-promo__inner">
    <div class="sale-collection-promo__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="sale-collection-promo__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="SalePromo-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}{% if section.settings.code != blank %} <strong>{{ section.settings.code | escape }}</strong>.{% endif %}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="sale-collection-promo__button" href="{% if promo_collection != blank %}{{ promo_collection.url }}{% else %}{{ routes.collections_url }}/15-off-selected-styles{% endif %}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>
      {%- endif -%}
      {%- if section.settings.note != blank -%}<p class="sale-collection-promo__note">{{ section.settings.note | escape }}{% if section.settings.note_code != blank %} <strong>{{ section.settings.note_code | escape }}</strong>.{% endif %}</p>{%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.sale-collection-promo{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--soft)}
.sale-collection-promo__inner{padding:3rem 16px;text-align:center}
.sale-collection-promo__copy{max-width:680px;margin:0 auto}
.sale-collection-promo__eyebrow{margin:0 0 .6rem;font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.sale-collection-promo h2{margin:0 0 .75rem;font-size:clamp(1.7rem,4vw,2.6rem);line-height:1.05}
.sale-collection-promo__copy>p:not(.sale-collection-promo__eyebrow):not(.sale-collection-promo__note){margin:0 auto 1.25rem;max-width:560px;color:var(--muted)}
.sale-collection-promo__button{display:inline-block;padding:.75rem 1.1rem;border:1px solid var(--ink);color:var(--ink);text-decoration:none;font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}
.sale-collection-promo__button span{margin-left:.25rem}
.sale-collection-promo__note{margin:1rem 0 0;font-size:.7rem;color:var(--muted)}
@media(max-width:749px){.sale-collection-promo__inner{padding:2.25rem 12px}}
{% endstylesheet %}

{% schema %}
{"name":"15% off selected styles","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Selected styles"},
{"type":"text","id":"heading","label":"Heading","default":"15% off selected styles"},
{"type":"text","id":"text","label":"Text","default":"Enjoy 15% off the selected EdenRose edit with code"},
{"type":"text","id":"code","label":"Discount code","default":"EDENROSE15"},
{"type":"collection","id":"collection","label":"Sale collection","info":"Leave empty to use /collections/15-off-selected-styles"},
{"type":"text","id":"button_label","label":"Button label","default":"Shop 15% off styles"},
{"type":"text","id":"note","label":"Note","default":"Storewide offer: 10% off is also available across EdenRose with code"},
{"type":"text","id":"note_code","label":"Note discount code","default":"EDENROSE10"}
],"presets":[{"name":"15% off selected styles"}]}
{% endschema %}
