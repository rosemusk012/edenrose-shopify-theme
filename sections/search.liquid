<section class="search-page"><div class="page-width"><div class="search-heading"><p class="eyebrow">{{ 'templates.search.eyebrow' | t }}</p><h1>{{ 'templates.search.title' | t }}</h1><p>{{ 'templates.search.intro' | t }}</p></div><form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchInput">{{ 'templates.search.placeholder' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'templates.search.placeholder' | t }}" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="SearchHint"><span id="SearchHint" class="search-hint">{{ 'templates.search.placeholder' | t }}</span><button class="button" type="submit">{{ 'general.search' | t }}</button></form>{% if search.performed %}<div class="search-results-head"><p>{{ search.results_count }} {{ 'templates.search.results' | t }}</p>{% if search.terms != blank %}<a href="{{ routes.search_url }}">{{ 'templates.search.clear' | t }}</a>{% endif %}</div>{% if search.results.size > 0 %}{% paginate search.results by 24 %}<div class="search-results">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'card-product', product: item %}{% else %}<a class="search-content-result" href="{{ item.url }}"><span class="search-content-type">{{ item.object_type | capitalize }}</span><h2>{{ item.title | escape }}</h2>{% if item.content != blank %}<p>{{ item.content | strip_html | truncatewords: 28 }}</p>{% endif %}<span>{{ 'templates.search.open_result' | t }} →</span></a>{% endif %}{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% else %}<div class="search-empty"><span class="empty-mark" aria-hidden="true">E</span><h2>{{ 'templates.search.no_results' | t }}</h2><p>{{ 'templates.search.try_again' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'templates.search.browse_all' | t }}</a></div>{% endif %}{% endif %}</div></section>
{% stylesheet %}.search-page{padding:clamp(2.5rem,6vw,5.5rem) 0 4rem}.search-heading{max-width:700px}.search-heading h1{font:normal clamp(3rem,7vw,6rem)/.95 Georgia,serif;letter-spacing:-.04em;margin:0 0 1rem}.search-heading>p:last-child{color:var(--muted);font-size:1rem}.search-form{display:grid;grid-template-columns:1fr auto;gap:.6rem;margin:2.25rem 0 1.25rem;max-width:820px}.search-form{position:relative}.search-form input{min-height:54px;padding:.9rem 1rem;border:1px solid var(--ink);background:transparent;font:inherit}.search-form input:focus-visible{border-color:var(--ink)}.search-hint{position:absolute;left:0;top:calc(100% + .45rem);font-size:.72rem;color:var(--muted)}.search-form input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.search-results-head{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-block:1px solid var(--line);margin-bottom:1.5rem;font-size:.82rem}.search-results-head p{margin:0;color:var(--muted)}.search-results-head a{text-decoration:underline;text-underline-offset:3px}.search-results-head a:focus-visible{outline:var(--focus);outline-offset:3px}.search-results{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.search-content-result{padding:1.25rem;border:1px solid var(--line);min-height:190px;display:flex;flex-direction:column}.search-content-result h2{font:normal 1.6rem/1.05 Georgia,serif;margin:.5rem 0}.search-content-result p{color:var(--muted);font-size:.9rem;margin:0}.search-content-result>span:last-child{margin-top:auto;font-size:.8rem;text-decoration:underline}.search-content-type{text-transform:uppercase;letter-spacing:.1em;font-size:.68rem;color:var(--muted)}.pagination{margin-top:2.5rem}.search-empty{text-align:center;padding:clamp(4rem,9vw,7rem) 1rem;border-top:1px solid var(--line)}.empty-mark{display:block;font:5rem Georgia,serif;color:var(--line);line-height:1}.search-empty h2{font:normal 2.2rem Georgia,serif;margin:.5rem 0}.search-empty p{color:var(--muted);margin-bottom:1.5rem}.search-empty .button{display:inline-flex}@media(max-width:900px){.search-results{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.search-page{padding-top:2rem}.search-form{grid-template-columns:1fr}.search-hint{position:static;margin-top:-.2rem}.search-results{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.search-content-result{grid-column:1/-1}.search-results-head{align-items:start}}
{% endstylesheet %}{% schema %}{"name":"t:sections.search.name"}{% endschema %}