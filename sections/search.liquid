<section class="section"><div class="page-width"><p class="eyebrow">Search</p><h1>{{ 'templates.search.title' | t }}</h1><form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;margin:25px 0"><label class="visually-hidden" for="SearchInput">{{ 'templates.search.placeholder' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'templates.search.placeholder' | t }}" style="flex:1;padding:14px;border:1px solid var(--line);background:transparent"><button class="button" type="submit">{{ 'general.search' | t }}</button></form>{% if search.performed %}<p>{{ search.results_count }} {{ 'templates.search.results' | t }}</p>{% if search.results.size > 0 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'card-product', product: item %}{% endif %}{% endfor %}</div>{% else %}<p>{{ 'templates.search.no_results' | t }}</p>{% endif %}{% endif %}</div></section>
{% schema %}{"name":"t:sections.search.name"}{% endschema %}