{% if request.page_type != "cart" or cart.item_count > 0 %}<section class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ cart.items.first.product.id | default: product.id }}&limit={{ section.settings.products_to_show }}">
  <div class="page-width">
    <div class="recommendation-heading"><div><p class="eyebrow">{{ 'templates.product.recommended_eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading | escape }}</p>{% endif %}</div><a class="recommendation-link" href="{{ routes.all_products_collection_url }}">{{ 'general.view_all' | t }} →</a></div>
    <div class="recommendation-grid" aria-live="polite">
      {% if recommendations.performed and recommendations.products_count > 0 %}{% for product in recommendations.products limit: section.settings.products_to_show %}{% render 'card-product', product: product %}{% endfor %}{% else %}{% for product in collections['new-arrivals'].products limit: section.settings.products_to_show %}{% render 'card-product', product: product %}{% endfor %}{% endif %}
    </div>
  </div>
</section>
<script>(function(){function load(el){if(el.dataset.initialized)return;var grid=el.querySelector('.recommendation-grid');if(!grid)return;el.dataset.initialized='true';fetch(el.dataset.url).then(function(r){if(!r.ok)throw new Error('Recommendations unavailable');return r.text()}).then(function(html){var doc=new DOMParser().parseFromString(html,'text/html'),source=doc.querySelector('.recommendation-grid');if(source&&source.children.length)grid.replaceChildren.apply(grid,Array.from(source.children));}).catch(function(){/* Keep the New Arrivals fallback visible. */})}function init(){document.querySelectorAll('.product-recommendations[data-url]').forEach(function(el){if('IntersectionObserver' in window){var observer=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting){observer.disconnect();load(el)}})},{rootMargin:'600px 0px'});observer.observe(el)}else{load(el)}})}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init()})();</script>{% endif %}
{% stylesheet %}
.product-recommendations{padding:clamp(3rem,7vw,6rem) 0;border-top:1px solid var(--line)}.recommendation-heading{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1.5rem}.recommendation-link{font-size:.8rem;text-decoration:underline;text-underline-offset:3px;white-space:nowrap}.recommendation-link:focus-visible{outline:var(--focus);outline-offset:3px}.recommendation-heading h2{font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.04em;margin:.2rem 0 .5rem}.recommendation-heading p:not(.eyebrow){color:var(--muted);margin:0}.recommendation-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}@media(max-width:749px){.recommendation-heading{align-items:start}.recommendation-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.product_recommendations.name","settings":[{"type":"text","id":"heading","label":"t:sections.product_recommendations.settings.heading","default":"You may also like"},{"type":"text","id":"subheading","label":"t:sections.product_recommendations.settings.subheading","default":"Keep exploring EdenRose."},{"type":"range","id":"products_to_show","label":"t:sections.product_recommendations.settings.products_to_show","min":2,"max":8,"step":1,"default":4}]}{% endschema %}
