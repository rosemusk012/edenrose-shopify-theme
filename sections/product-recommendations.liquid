<section class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}">
  <div class="page-width">
    <div class="recommendation-heading"><div><p class="eyebrow">{{ 'templates.product.recommended_eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading | escape }}</p>{% endif %}</div><a class="recommendation-link" href="{{ routes.all_products_collection_url }}">{{ 'general.view_all' | t }} →</a></div>
    <div class="recommendation-grid" aria-live="polite">
      {% if recommendations.performed %}{% for product in recommendations.products limit: section.settings.products_to_show %}{% render 'card-product', product: product %}{% endfor %}{% endif %}
    </div>
  </div>
</section>
<script>
(function(){const el=document.currentScript.previousElementSibling;if(!el)return;fetch(el.dataset.url).then(r=>{if(!r.ok)throw new Error('Recommendations unavailable');return r.text()}).then(html=>{const doc=new DOMParser().parseFromString(html,'text/html');const grid=doc.querySelector('.recommendation-grid');if(grid&&grid.children.length){el.querySelector('.recommendation-grid').replaceChildren(...grid.children)}else{el.hidden=true}}).catch(()=>{el.hidden=true})})();
</script>
{% stylesheet %}
.product-recommendations[hidden]{display:none}.product-recommendations{padding:clamp(3rem,7vw,6rem) 0;border-top:1px solid var(--line)}.recommendation-heading{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1.5rem}.recommendation-link{font-size:.8rem;text-decoration:underline;text-underline-offset:3px;white-space:nowrap}.recommendation-link:focus-visible{outline:var(--focus);outline-offset:3px}.recommendation-heading h2{font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.04em;margin:.2rem 0 .5rem}.recommendation-heading p:not(.eyebrow){color:var(--muted);margin:0}.recommendation-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.recommendation-grid:empty{display:none}@media(max-width:749px){.recommendation-heading{align-items:start}.recommendation-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}}
{% endstylesheet %}
{% schema %}{"name":"Product recommendations","settings":[{"type":"text","id":"heading","label":"Heading","default":"You may also like"},{"type":"text","id":"subheading","label":"Subheading","default":"Keep exploring EdenRose."},{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":8,"step":1,"default":4}]}{% endschema %}