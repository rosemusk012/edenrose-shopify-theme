{% render 'breadcrumbs' %}
{%- liquid
  assign all_handles = ''
  paginate collections by 250
    for item in collections
      if item.products_count > 0
        assign all_handles = all_handles | append: item.handle | append: ','
      endif
    endfor
  endpaginate
  capture more_handles
    render 'edenrose-collection-more', all_handles: all_handles
  endcapture
  assign more_handles = more_handles | strip
  assign group_women = 'templates.collection.group_women' | t
  assign group_men = 'templates.collection.group_men' | t
  assign group_jewellery = 'templates.collection.group_jewellery' | t
  assign group_shoes_swim = 'templates.collection.group_shoes_swim' | t
  assign group_edits = 'templates.collection.group_edits' | t
  assign group_more = 'templates.collection.group_more' | t
-%}
<section class="section list-collections">
  <div class="page-width">
    <div class="section-head list-collections__head">
      <div>
        <p class="eyebrow">{{ 'templates.collection.eyebrow' | t }}</p>
        <h1>{{ section.settings.heading | escape }}</h1>
        <p class="list-collections__intro">{{ 'templates.collection.list_intro' | t }}</p>
      </div>
      <nav class="list-collections__jump" aria-label="{{ 'templates.collection.jump_to' | t }}">
        <a href="#CollectionsWomen">{{ group_women }}</a>
        <a href="#CollectionsMen">{{ group_men }}</a>
        <a href="#CollectionsJewellery">{{ group_jewellery }}</a>
        <a href="#CollectionsShoesSwim">{{ group_shoes_swim }}</a>
        <a href="#CollectionsEdits">{{ group_edits }}</a>
      </nav>
    </div>
    {% render 'edenrose-collection-group', handles: settings.collection_group_women, title: group_women, group_id: 'CollectionsWomen', show_counts: true %}
    {% render 'edenrose-collection-group', handles: settings.collection_group_men, title: group_men, group_id: 'CollectionsMen', show_counts: true, strip_prefix: 'Men ' %}
    {% render 'edenrose-collection-group', handles: settings.collection_group_jewellery, title: group_jewellery, group_id: 'CollectionsJewellery', show_counts: true %}
    {% render 'edenrose-collection-group', handles: settings.collection_group_shoes_swim, title: group_shoes_swim, group_id: 'CollectionsShoesSwim', show_counts: true %}
    {% render 'edenrose-collection-group', handles: settings.collection_group_edits, title: group_edits, group_id: 'CollectionsEdits', show_counts: true %}
    {%- if section.settings.show_more and more_handles != blank -%}
      {% render 'edenrose-collection-group', handles: more_handles, title: group_more, group_id: 'CollectionsMore', show_counts: true %}
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
.list-collections.section{padding-top:clamp(1.5rem,3.5vw,2.75rem)}.list-collections h1{font:normal clamp(2.4rem,5vw,4.5rem)/.95 var(--display);letter-spacing:-.045em;margin:.3rem 0 0}
.list-collections__head{display:flex;justify-content:space-between;align-items:end;gap:2rem;flex-wrap:wrap}
.list-collections__intro{color:var(--muted);max-width:34rem;line-height:1.6;margin:.8rem 0 0}
.list-collections__jump{display:flex;flex-wrap:wrap;gap:.45rem}
.list-collections__jump a{display:inline-flex;align-items:center;min-height:40px;padding:.45rem .95rem;border:1px solid var(--line);border-radius:999px;font-size:.78rem;letter-spacing:.04em;background:var(--paper)}
.list-collections__jump a:hover,.list-collections__jump a:focus-visible{border-color:var(--ink)}
.list-collections__group{padding-top:clamp(2rem,4vw,3.25rem);scroll-margin-top:110px}
.list-collections__group-title{display:flex;align-items:baseline;gap:.6rem;font:normal clamp(1.8rem,3.4vw,2.8rem)/1 var(--display);letter-spacing:-.035em;margin:0 0 1.2rem;padding-bottom:.8rem;border-bottom:1px solid var(--line)}
.list-collections__group-title small{font:600 .7rem/1 var(--body);letter-spacing:.12em;color:var(--muted)}
.list-collections__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.15rem}
.list-collections__card{display:grid;gap:.7rem;color:inherit;align-content:start}
.list-collections__media{aspect-ratio:4/5;overflow:hidden;border-radius:10px;background:var(--soft);box-shadow:0 12px 30px rgba(33,26,27,.06)}
.list-collections__media img,.list-collections__media svg{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s ease}
.list-collections__card:hover img{transform:scale(1.03)}
.list-collections__title{display:grid;gap:.15rem;font-weight:600}
.list-collections__title small{font-weight:400;color:var(--muted);font-size:.8rem}
@media(max-width:989px){.list-collections__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:749px){.list-collections__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.list-collections__head{display:block}.list-collections__jump{margin-top:1rem}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.main_list_collections.name","settings":[{"type":"text","id":"heading","label":"t:sections.main_list_collections.settings.heading","default":"Shop by collection"},{"type":"checkbox","id":"show_more","label":"t:sections.main_list_collections.settings.show_more","default":true}]}{% endschema %}
