{% if section.settings.product != blank %}
<section class="edenrose-editorial" aria-labelledby="edenrose-editorial-title-{{ section.id }}">
  <div class="edenrose-editorial__wash"></div>
  <div class="edenrose-editorial__inner">
    <div class="edenrose-editorial__copy">
      <p class="edenrose-editorial__eyebrow">{{ 'sections.editorial_feature.eyebrow' | t }}</p>
      <h2 id="edenrose-editorial-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p class="edenrose-editorial__text">{{ section.settings.text }}</p>
      <a class="edenrose-editorial__link" href="{{ section.settings.product.url }}">{{ 'sections.editorial_feature.shop' | t }} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="edenrose-editorial__stage">
      <a class="edenrose-editorial__main" href="{{ section.settings.product.url }}" aria-label="{{ section.settings.product.title | escape }}">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '550,750,950,1100', sizes: '(min-width: 900px) 58vw, 90vw', alt: section.settings.product.title }}
        {% elsif section.settings.product.featured_image != blank %}
          {{ section.settings.product.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '550,750,950,1100', sizes: '(min-width: 900px) 58vw, 90vw', alt: section.settings.product.title }}
        {% endif %}
      </a>
      <div class="edenrose-editorial__tag edenrose-editorial__tag--one">
        <span>{{ 'sections.editorial_feature.tag_one' | t }}</span>
        <strong>{{ section.settings.product.title }}</strong>
      </div>
      {% if section.settings.secondary_product != blank %}
        <a class="edenrose-editorial__mini edenrose-editorial__mini--two" href="{{ section.settings.secondary_product.url }}" aria-label="{{ section.settings.secondary_product.title | escape }}">
          {% if section.settings.secondary_product.featured_image != blank %}
            {{ section.settings.secondary_product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '210,320,420', sizes: '(min-width: 900px) 22vw, 45vw', alt: section.settings.secondary_product.title }}
          {% endif %}
        </a>
      {% endif %}
      {% if section.settings.third_product != blank %}
        <a class="edenrose-editorial__mini edenrose-editorial__mini--three" href="{{ section.settings.third_product.url }}" aria-label="{{ section.settings.third_product.title | escape }}">
          {% if section.settings.third_product.featured_image != blank %}
            {{ section.settings.third_product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '210,320,420', sizes: '(min-width: 900px) 22vw, 45vw', alt: section.settings.third_product.title }}
          {% endif %}
        </a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{% stylesheet %}
.edenrose-editorial {
  position: relative;
  overflow: hidden;
  padding: clamp(56px, 9vw, 120px) 20px;
  background: var(--paper);
}
.edenrose-editorial__wash {
  position: absolute;
  width: 44vw;
  height: 44vw;
  max-width: 620px;
  max-height: 620px;
  border-radius: 50%;
  background: var(--rose);
  left: -16vw;
  top: 8%;
  opacity: .72;
}
.edenrose-editorial__inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(220px, .7fr) minmax(0, 1.7fr);
  gap: clamp(28px, 6vw, 88px);
  max-width: var(--max);
  margin: 0 auto;
  align-items: center;
}
.edenrose-editorial__copy { position: relative; z-index: 3; min-width:0; }
.edenrose-editorial__eyebrow {
  margin: 0 0 12px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--wine);
}
.edenrose-editorial h2 {
  max-width: 420px;
  margin: 0;
  font-family: var(--display);
  font-size: clamp(42px, 6vw, 86px);
  font-weight: 400;
  line-height: .95;
  letter-spacing: -.035em;
}
.edenrose-editorial__text {
  max-width: 360px;
  margin: 24px 0 28px;
  color: var(--muted);
  line-height: 1.7;
}
.edenrose-editorial__link {
  display: inline-flex;
  gap: 10px;
  align-items: center;
  min-height: 44px;
  padding-bottom: 6px;
  border-bottom: 1px solid currentColor;
  color: var(--ink);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.edenrose-editorial__stage {
  position: relative;
  min-height: clamp(460px, 52vw, 760px);
}
.edenrose-editorial__main {
  position: absolute;
  inset: 0 9% 0 9%;
  display: block;
  overflow: hidden;
  border-radius: 2px;
  background: var(--soft);
  transform: rotate(-2deg);
  box-shadow: 0 22px 60px rgba(33,26,27,.13);
}
.edenrose-editorial__main img,
.edenrose-editorial__mini img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}
.edenrose-editorial__main img { min-width:0; transition: transform .5s ease; }
.edenrose-editorial__main:hover img { transform: scale(1.025); }
.edenrose-editorial__tag {
  position: absolute;
  left: 1%;
  bottom: 8%;
  z-index: 3;
  max-width: 240px;
  padding: 15px 18px;
  background: var(--paper);
  box-shadow: 0 12px 32px rgba(33,26,27,.14);
  transform: rotate(-4deg);
}
.edenrose-editorial__tag span,
.edenrose-editorial__tag strong {
  display: block;
}
.edenrose-editorial__tag span {
  margin-bottom: 5px;
  font-size: 10px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--muted);
}
.edenrose-editorial__tag strong {
  font-family: var(--display);
  font-size: 20px;
  font-weight: 400;
}
.edenrose-editorial__mini {
  position: absolute;
  z-index: 4;
  display: block;
  width: 24%;
  aspect-ratio: .76;
  overflow: hidden;
  background: var(--soft);
  box-shadow: 0 16px 38px rgba(33,26,27,.18);
  transition: transform .35s ease;
}
.edenrose-editorial__mini:hover { transform: translateY(-8px) rotate(0deg); }
.edenrose-editorial__mini--two {
  right: 0;
  top: 7%;
  transform: rotate(5deg);
}
.edenrose-editorial__mini--three {
  right: 2%;
  bottom: 5%;
  transform: rotate(-5deg);
}
@media (max-width: 760px) {
  .edenrose-editorial { padding-inline: 14px; }
  .edenrose-editorial__inner { display: block; }
  .edenrose-editorial__copy { margin: 0 8px 32px; }
  .edenrose-editorial h2 { font-size: clamp(44px, 15vw, 72px); max-width:9ch; }
  .edenrose-editorial__text { margin-block: 18px 22px; }
  .edenrose-editorial__stage { min-height: 108vw; min-width:0; }
  .edenrose-editorial__main { inset: 0 7% 0 5%; }
  .edenrose-editorial__mini { width: 29%; }
  .edenrose-editorial__tag { left: 0; bottom: 6%; max-width:min(240px,72vw); }
}
@media (prefers-reduced-motion: reduce) {
  .edenrose-editorial__main img,
  .edenrose-editorial__mini { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial product feature",
  "settings": [
    { "type": "product", "id": "product", "label": "Main product" },
    { "type": "product", "id": "secondary_product", "label": "Floating product 1" },
    { "type": "product", "id": "third_product", "label": "Floating product 2" },
    { "type": "image_picker", "id": "image", "label": "Main image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little something extra." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One piece, styled as its own little editorial moment." }
  ],
  "presets": [
    {
      "name": "Editorial product feature",
      "settings": { "heading": "A little something extra.", "text": "One piece, styled as its own little editorial moment." }
    }
  ]
}
{% endschema %}