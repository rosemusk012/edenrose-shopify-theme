<footer class="site-footer"><div class="page-width footer-grid"><div><h2>{{ shop.name | escape }}</h2><p class="footer-note">{{ 'sections.footer.note' | t }}</p></div><div><h3>{{ 'sections.footer.shop' | t }}</h3>{% for link in linklists[section.settings.menu].links %}<p><a href="{{ link.url }}">{{ link.title | escape }}</a></p>{% endfor %}</div><div><h3>{{ 'sections.footer.help' | t }}</h3><p><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a></p><p><a href="{{ routes.cart_url }}">{{ 'general.cart' | t }}</a></p></div></div></footer>
{% schema %}{"name":"t:sections.footer.name","settings":[{"type":"link_list","id":"menu","label":"t:sections.footer.settings.menu","default":"footer"}]}{% endschema %}