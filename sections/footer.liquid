<footer class="site-footer" aria-label="{{ shop.name | escape }}">
  <div class="page-width">
    <div class="footer-trust">
      <div><strong>{{ 'sections.footer.shipping_title' | t }}</strong><span>{{ 'sections.footer.shipping_text' | t }}</span></div>
      <div><strong>{{ 'sections.footer.returns_title' | t }}</strong><span>{{ 'sections.footer.returns_text' | t }}</span></div>
      <div><strong>{{ 'sections.footer.secure_title' | t }}</strong><span>{{ 'sections.footer.secure_text' | t }}</span></div>
    </div>
    <div class="footer-intro"><span class="footer-spark" aria-hidden="true">✦</span><div><p class="footer-editorial">The EdenRose edit, beyond the expected.</p><a class="footer-shop-link" href="{{ routes.all_products_collection_url }}">Explore everything →</a></div></div><div class="footer-grid">
      <div><p class="footer-brand">{{ shop.name | escape }}</p><p class="footer-note">{{ 'sections.footer.note' | t }}</p></div>
      <nav aria-label="{{ 'sections.footer.shop' | t }}"><h2>{{ 'sections.footer.shop' | t }}</h2>{% for link in linklists[section.settings.menu].links %}<p><a href="{{ link.url }}">{{ link.title | escape }}</a></p>{% endfor %}</nav>
      <nav aria-label="{{ 'sections.footer.help' | t }}"><h2>{{ 'sections.footer.help' | t }}</h2><p><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a></p><p><a href="{{ routes.cart_url }}">{{ 'general.cart' | t }}</a></p><p><a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a></p>{% if shop.refund_policy %}<p><a href="{{ shop.refund_policy.url }}">{{ 'sections.footer.returns_title' | t }}</a></p>{% endif %}{% if shop.shipping_policy %}<p><a href="{{ shop.shipping_policy.url }}">{{ 'sections.footer.shipping_title' | t }}</a></p>{% endif %}{% if shop.privacy_policy %}<p><a href="{{ shop.privacy_policy.url }}">{{ 'sections.footer.privacy' | t }}</a></p>{% endif %}{% if shop.terms_of_service %}<p><a href="{{ shop.terms_of_service.url }}">{{ 'sections.footer.terms' | t }}</a></p>{% endif %}</nav>
    </div>
    <div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><a href="{{ routes.root_url }}">{{ 'sections.footer.back_to_store' | t }}</a></div>
  </div>
</footer>
{% stylesheet %}
.site-footer{margin-top:4rem;border-top:1px solid var(--line);padding:2rem 0 1.25rem}.footer-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding-bottom:2rem;border-bottom:1px solid var(--line)}.footer-trust div{display:grid;gap:.3rem}.footer-trust span{font-size:.82rem;color:var(--muted);line-height:1.45}.footer-intro{display:flex;align-items:center;gap:1rem;padding:1.4rem 0;border-bottom:1px solid var(--line)}.footer-spark{font-size:1.4rem;color:var(--accent)}.footer-editorial{font:normal clamp(1.4rem,3vw,2.2rem)/1.05 var(--display);margin:0 0 .4rem}.footer-shop-link{text-decoration:underline;text-underline-offset:4px;font-size:.8rem}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1.2fr;gap:2rem;padding:2.5rem 0}.footer-brand{font-size:1.3rem;font-weight:700;margin:0 0 .5rem}.footer-note{max-width:28rem;color:var(--muted);line-height:1.5}.footer-grid h2{font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;margin:0 0 .75rem}.footer-grid p{margin:.45rem 0}.footer-grid a,.footer-bottom a{color:inherit;text-decoration:none}.footer-grid a:hover,.footer-grid a:focus-visible,.footer-bottom a:hover,.footer-bottom a:focus-visible{text-decoration:underline}.footer-bottom{display:flex;justify-content:space-between;gap:1rem;padding-top:1rem;border-top:1px solid var(--line);font-size:.78rem;color:var(--muted)}
@media(max-width:749px){.footer-intro{align-items:flex-start}.footer-trust{grid-template-columns:1fr;gap:1.25rem}.footer-grid{grid-template-columns:1fr 1fr;gap:1.5rem;padding:2rem 0}.footer-grid>div:first-child{grid-column:1/-1}.footer-bottom{display:grid}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.footer.name","settings":[{"type":"link_list","id":"menu","label":"t:sections.footer.settings.menu","default":"footer"}]}{% endschema %}