<section class="shop-by-category" aria-labelledby="shop-by-category-heading">
  <div class="page-width">
    <div class="category-intro">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="shop-by-category-heading">{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.intro != blank %}<p class="category-intro__text">{{ section.settings.intro | escape }}</p>{% endif %}
    </div>

    {% assign used_category_images = '|' %}
    {% comment %}Customer-facing landing categories use the main Shopify collections; granular filter collections stay in collection pages/navigation. {% endcomment %}
    <div class="category-grid category-grid--all">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          {% assign category = block.settings.collection %}
          {% assign category_image = category.featured_image %}
          {% assign category_image_key = blank %}
          {% if category_image != blank %}
            {% assign category_image_key = category_image | image_url: width: 1200 %}
          {% endif %}
          {% if category_image == blank or used_category_images contains category_image_key %}
            {% for product in category.products limit: 12 %}
              {% if product.featured_image != blank %}
                {% assign candidate_key = product.featured_image | image_url: width: 1200 %}
                {% unless used_category_images contains candidate_key %}
                  {% assign category_image = product.featured_image %}
                  {% assign category_image_key = candidate_key %}
                  {% break %}
                {% endunless %}
              {% endif %}
            {% endfor %}
          {% endif %}
          {% if category_image != blank and category_image_key != blank %}
            {% assign used_category_images = used_category_images | append: category_image_key | append: '|' %}
          {% endif %}
          <a class="category-card category-card--{{ forloop.index }}" href="{{ category.url }}" {{ block.shopify_attributes }}>
            <div class="category-card__media">
              {% if category_image != blank %}
                {{ category_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 750px) 33vw, 100vw', alt: category.title | escape }}
              {% else %}
                <div class="category-card__placeholder" aria-hidden="true"><span>{{ category.title | slice: 0 | escape }}</span></div>
              {% endif %}
              <div class="category-card__veil"></div>
            </div>
            <div class="category-card__content">
              <span class="category-card__number">{{ forloop.index | prepend: '0' }}</span>
              <span class="category-card__name">{{ category.title | escape }}<small>{{ category.products_count }} {{ 'templates.collection.products' | t }}</small></span>
              <span class="category-card__arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
    {% assign visible_categories = 0 %}{% for block in section.blocks %}{% if block.settings.collection != blank %}{% assign visible_categories = visible_categories | plus: 1 %}{% endif %}{% endfor %}{% if visible_categories > 6 %}<div class="category-more"><button class="button" type="button" data-category-toggle aria-expanded="false" data-show-all="Show all collections" data-show-fewer="Show fewer collections">Show all collections</button></div>{% endif %}
  </div>
</section>

{% stylesheet %}
.shop-by-category{padding:clamp(4rem,8vw,8rem) 0;background:var(--paper,#f5f1e9)}
.category-intro{display:flex;align-items:end;justify-content:space-between;gap:3rem;margin-bottom:2.5rem;min-width:0}.category-intro>div{min-width:0}.category-intro h2{margin:.35rem 0 0;font-size:clamp(2.4rem,5vw,4.8rem);line-height:.95;letter-spacing:-.045em;max-width:10ch;overflow-wrap:anywhere}.category-intro__text{max-width:25rem;margin:0 0 .2rem;color:var(--muted);line-height:1.65}
.category-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:1rem}.category-card:nth-child(n+7){display:none}.category-more{margin-top:1.5rem;display:flex;justify-content:center}.category-card{position:relative;display:block;color:#fff;grid-column:span 4;min-height:28rem;overflow:hidden;border-radius:2px;isolation:isolate;transition:transform .25s ease,box-shadow .25s ease;}.category-card:visited{color:#fff}.category-card:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(23,20,17,.10);color:#fffaf0;text-decoration:none;background:#ddd5c8}.category-card:nth-child(3n+2){margin-top:3rem}.category-card__media,.category-card__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.category-card__media img{transition:transform .55s cubic-bezier(.2,.65,.2,1)}.category-card__veil{position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(12,11,9,.72) 100%);transition:opacity .3s ease}.category-card:hover .category-card__media img,.category-card:focus-visible .category-card__media img{transform:scale(1.055)}.category-card:hover .category-card__veil{opacity:.88}.category-card__content{position:absolute;right:1.2rem;bottom:1.1rem;left:1.2rem;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:end;gap:.7rem}.category-card__content,.category-card__content *{color:#fff}.category-card__name{min-width:0;overflow-wrap:anywhere}.category-card__number{font-size:.68rem;letter-spacing:.12em;opacity:.72;padding-bottom:.3rem}.category-card__name{font-size:clamp(1.15rem,2vw,1.55rem);font-weight:500;letter-spacing:-.02em;overflow-wrap:anywhere}.category-card__name small{display:block;font-size:.68rem;letter-spacing:.04em;font-weight:400;opacity:.72;margin-top:.25rem}.category-card__arrow{font-size:1.3rem;line-height:1;transform:translateY(-.1rem);transition:transform .25s ease}.category-card:hover .category-card__arrow,.category-card:focus-visible .category-card__arrow{transform:translate(.15rem,-.15rem)}.category-card__placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#e6ded1,#cfc5b7);color:rgba(30,28,25,.3);font-size:5rem}
.category-more .button{min-width:180px}.shop-by-category.show-all .category-card:nth-child(n+7){display:block}@media(max-width:749px){.shop-by-category{padding:3.25rem 0}.category-intro{display:block;gap:1rem}.category-intro h2{max-width:9ch}.category-intro h2{font-size:clamp(2.3rem,10vw,3.4rem);max-width:9ch;}.category-intro{margin-bottom:1.75rem}.category-intro__text{margin-top:1rem}.category-grid{grid-template-columns:1fr 1fr;gap:.75rem}.category-card{grid-column:span 1;min-height:18rem}.category-card:nth-child(2n){margin-top:1.25rem}.category-card:nth-child(3n+2){margin-top:0}.category-card:nth-child(4n+1){min-height:22rem}.category-card__content{right:.8rem;bottom:.8rem;left:.8rem}.category-card__number{display:none}.category-card__name{font-size:1.05rem}}
@media(max-width:480px){.category-grid{grid-template-columns:1fr;gap:.9rem}.category-card,.category-card:nth-child(4n+1),.category-card:nth-child(2n){min-height:21rem;margin-top:0}.category-card__name{font-size:1.1rem}.category-more .button{width:100%}}
{% endstylesheet %}
{% if visible_categories > 6 %}<script>(function(){function init(){document.querySelectorAll('.shop-by-category').forEach(function(s){var b=s.querySelector('[data-category-toggle]');if(!b||b.dataset.initialized)return;b.dataset.initialized='true';b.addEventListener('click',function(){var open=b.getAttribute('aria-expanded')==='true';s.classList.toggle('show-all',!open);b.setAttribute('aria-expanded',String(!open));b.textContent=open?b.dataset.showAll:b.dataset.showFewer})})}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init()})();</script>{% endif %}

{% schema %}
{"name":"t:sections.shop_by_category.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.shop_by_category.settings.eyebrow","default":"Explore EdenRose"},{"type":"text","id":"heading","label":"t:sections.shop_by_category.settings.heading","default":"Find your way in."},{"type":"textarea","id":"intro","label":"t:sections.shop_by_category.settings.intro","default":"Clothing, jewellery and pieces for wherever the day takes you."}],"blocks":[{"type":"category","name":"t:sections.shop_by_category.blocks.category","settings":[{"type":"collection","id":"collection","label":"t:sections.shop_by_category.blocks.collection"}]}],"presets":[{"name":"t:sections.shop_by_category.name","blocks":[{"type":"category","settings":{"collection":"new-arrivals"}},{"type":"category","settings":{"collection":"apparel"}},{"type":"category","settings":{"collection":"dresses"}},{"type":"category","settings":{"collection":"tops-blouses"}},{"type":"category","settings":{"collection":"bottoms-sets"}},{"type":"category","settings":{"collection":"jumpsuits-rompers"}},{"type":"category","settings":{"collection":"sweaters-hoodies"}},{"type":"category","settings":{"collection":"jewelry"}},{"type":"category","settings":{"collection":"rings"}},{"type":"category","settings":{"collection":"shoes"}},{"type":"category","settings":{"collection":"swimwear"}},{"type":"category","settings":{"collection":"plus-size"}},{"type":"category","settings":{"collection":"15-off-selected-styles"}}]}]}
{% endschema %}