<section class="shop-by-category" aria-labelledby="shop-by-category-heading">
  <div class="page-width">
    <div class="section-heading">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="shop-by-category-heading">{{ section.settings.heading }}</h2>
    </div>
    <div class="category-grid">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          {% assign category = block.settings.collection %}
          <a class="category-card" href="{{ category.url }}" {{ block.shopify_attributes }}>
            {% if category.featured_image %}
              {{ category.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: category.title }}
            {% elsif category.products.first.featured_image %}
              {{ category.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: category.title }}
            {% endif %}
            <span class="category-card__label">
              <span>{{ category.title }}</span>
              <span aria-hidden="true">→</span>
            </span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .shop-by-category {
    padding: 4.5rem 0;
    background: var(--paper, #f5f1e9);
  }

  .section-heading {
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .category-card {
    position: relative;
    display: block;
    min-height: 18rem;
    overflow: hidden;
    background: #e8e1d6;
    color: inherit;
    text-decoration: none;
  }

  .category-card img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 18rem;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .category-card:hover img,
  .category-card:focus-visible img {
    transform: scale(1.03);
  }

  .category-card__label {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.1rem;
    background: rgb(12 11 9 / 82%);
    color: #fffaf0;
    font-size: 1rem;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .shop-by-category {
      padding: 3rem 0;
    }

    .category-grid {
      grid-template-columns: 1fr 1fr;
    }

    .category-card,
    .category-card img {
      min-height: 13rem;
    }
  }

  @media screen and (max-width: 480px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Explore EdenRose"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "collection": "clothing" } },
        { "type": "category", "settings": { "collection": "dresses" } },
        { "type": "category", "settings": { "collection": "jewellery" } },
        { "type": "category", "settings": { "collection": "rings" } },
        { "type": "category", "settings": { "collection": "tops-blouses" } },
        { "type": "category", "settings": { "collection": "new-arrivals" } }
      ]
    }
  ]
}
{% endschema %}