<section class="product-page">
  <div class="page-width product-layout">
    <div class="product-media">
      {% for image in product.images %}
        <figure class="product-media-item">{{ image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700,1000,1400', sizes: '(min-width: 750px) 55vw, 100vw', alt: image.alt | default: product.title }}</figure>
      {% endfor %}
    </div>
    <div class="product-info">
      <p class="eyebrow">{{ product.type | default: 'EdenRose' | escape }}</p>
      <h1>{{ product.title | escape }}</h1>
      <div class="product-price"><span>{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s><span class="sale-note">{{ 'templates.product.on_sale' | t }}</span>{% endif %}</div>
      {% if product.available %}<p class="availability"><span aria-hidden="true">●</span> {{ 'templates.product.available' | t }}</p>{% endif %}

      {% form 'product', product, class: 'product-form' %}
        {% unless product.has_only_default_variant %}
          <div class="field"><label for="Variant-{{ section.id }}">{{ 'templates.product.variant' | t }}</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'templates.product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select></div>
        {% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
        {% if product.available %}
          <div class="purchase-row"><div class="quantity-field"><label for="Quantity-{{ section.id }}">{{ 'templates.product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1"></div><button class="button add-to-cart" type="submit">{{ 'templates.product.add_to_cart' | t }}</button></div>
        {% else %}<button class="button" type="button" disabled>{{ 'templates.product.sold_out' | t }}</button>{% endif %}
      {% endform %}

      {% if product.description != blank %}<details class="product-details" open><summary>{{ 'templates.product.details' | t }}</summary><div class="product-description">{{ product.description }}</div></details>{% endif %}
      <div class="product-trust">
        <div><strong>{{ 'templates.product.shipping_title' | t }}</strong><span>{{ 'templates.product.shipping_text' | t }}</span>{% if shop.shipping_policy %}<a href="{{ shop.shipping_policy.url }}">{{ 'sections.footer.shipping_title' | t }} →</a>{% endif %}</div>
        <div><strong>{{ 'templates.product.returns_title' | t }}</strong><span>{{ 'templates.product.returns_text' | t }}</span>{% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">{{ 'sections.footer.returns_title' | t }} →</a>{% endif %}</div>
        <div><strong>{{ 'templates.product.secure_title' | t }}</strong><span>{{ 'templates.product.secure_text' | t }}</span></div>
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.product-page{padding:clamp(2rem,5vw,5rem) 0}.product-layout{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(340px,.88fr);gap:clamp(2rem,5vw,5.5rem)}.product-media{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.product-media-item{margin:0;overflow:hidden;background:#eee7dc}.product-media-item img{display:block;width:100%;height:auto;transition:transform .45s ease}.product-media-item:first-child{grid-column:1/-1}.product-media-item:hover img{transform:scale(1.012)}.product-info{position:sticky;top:105px;align-self:start;padding-top:1rem}.product-info h1{font-size:clamp(2.2rem,4.5vw,4.5rem);line-height:.98;letter-spacing:-.045em;margin:.25rem 0 1rem;max-width:12ch}.product-price{display:flex;align-items:center;gap:.65rem;font-size:1.2rem;font-weight:700;margin:0 0 .55rem}.product-price s{color:var(--muted);font-weight:400}.sale-note{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em}.availability{font-size:.8rem;margin:.5rem 0 1.5rem;color:var(--muted)}.availability span{font-size:.6rem}.product-form{display:grid;gap:1rem}.field{display:grid;gap:.45rem}.field label,.quantity-field label{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em}.field select,.quantity-field input{width:100%;padding:.9rem;border:1px solid var(--line);background:var(--paper);font:inherit}.purchase-row{display:grid;grid-template-columns:100px 1fr;gap:.75rem;align-items:end}.quantity-field{display:grid;gap:.45rem}.add-to-cart{width:100%;min-height:54px;font-size:1rem}.product-details{border-block:1px solid var(--line);padding:1.15rem 0;margin-top:1.75rem}.product-details summary{cursor:pointer;font-weight:600;display:flex;justify-content:space-between}.product-details summary::after{content:"+";font-weight:400}.product-description{margin-top:1rem;color:var(--muted);line-height:1.7}.product-trust{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);margin-top:1.5rem}.product-trust>div{padding:1rem .8rem 0 0;border-right:1px solid var(--line);display:grid;gap:.3rem;font-size:.78rem}.product-trust>div:not(:first-child){padding-left:.8rem}.product-trust>div:last-child{border-right:0}.product-trust span{color:var(--muted);line-height:1.5}.product-trust a{font-size:.72rem;text-decoration:underline;text-underline-offset:3px;margin-top:.15rem}
@media(max-width:749px){.product-page{padding-top:1rem}.product-layout{display:block}.product-media{grid-template-columns:1fr 1fr;gap:.45rem;margin-inline:-16px}.product-media-item:first-child{grid-column:1/-1}.product-info{position:static;padding-top:1.75rem}.product-info h1{font-size:clamp(2.35rem,11vw,4rem)}.product-trust{grid-template-columns:1fr}.product-trust>div,.product-trust>div:not(:first-child){border-right:0;border-bottom:1px solid var(--line);padding:1rem 0}.product-trust>div:last-child{border-bottom:0}.purchase-row{grid-template-columns:90px 1fr}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.main_product.name"}{% endschema %}