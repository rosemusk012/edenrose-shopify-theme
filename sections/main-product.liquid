{% assign has_available_variant = product.available %}
{% assign first_available_variant = product.first_available_variant %}
{% render 'breadcrumbs' %}<section class="product-page" data-product-section="{{ section.id }}" itemscope itemtype="https://schema.org/Product">
  <div class="page-width product-layout">
    <div class="product-media" data-product-gallery tabindex="0" aria-label="Product images">
      <div class="gallery-hint" aria-hidden="true">Swipe / tap to explore</div><button type="button" class="gallery-expand" data-gallery-expand aria-label="View product images full screen">View images</button>{% for image in product.images %}<figure class="product-media-item" itemprop="image">{% if forloop.first %}{{ image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '600,850,1000,1200', sizes: '(min-width: 750px) 55vw, 100vw', alt: image.alt | default: product.title }}{% else %}{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,850,1000,1200', sizes: '(min-width: 750px) 55vw, 100vw', alt: image.alt | default: product.title }}{% endif %}</figure>{% endfor %}
    </div>
    <div class="product-info">
      <p class="eyebrow">{{ product.type | default: shop.name | escape }}</p><h1>{{ product.title | escape }}</h1>
      <div class="product-kicker"><span>EDENROSE EDIT</span>{% if product.tags contains 'new' or product.tags contains 'New' %}<span>New</span>{% endif %}</div><div class="product-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer"><span data-product-price aria-live="polite" aria-atomic="true">{{ first_available_variant.price | money }}</span><meta itemprop="price" content="{{ first_available_variant.price | divided_by: 100.0 }}" data-product-price-meta><meta itemprop="priceCurrency" content="{{ shop.currency }}"><meta itemprop="availability" content="{% if first_available_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"><link itemprop="url" href="{{ shop.url }}{{ product.url }}"><s data-product-compare{% unless first_available_variant.compare_at_price > first_available_variant.price %} hidden{% endunless %}>{{ first_available_variant.compare_at_price | money }}</s><span class="sale-note" data-product-sale{% unless first_available_variant.compare_at_price > first_available_variant.price %} hidden{% endunless %}>{{ 'templates.product.on_sale' | t }}</span></div>
      {% if has_available_variant %}<p class="availability" data-product-availability aria-live="polite" aria-atomic="true"><span aria-hidden="true">●</span> {{ 'templates.product.available' | t }}{% if first_available_variant.inventory_management and first_available_variant.inventory_quantity > 0 and first_available_variant.inventory_quantity <= 5 %} · {{ first_available_variant.inventory_quantity }} {{ 'templates.product.left' | t }}{% endif %}</p>{% endif %}
      <div class="product-purchase-intro">Select your options below to check availability and add your choice to cart.</div>{% form 'product', product, class: 'product-form', id: 'ProductForm-' | append: section.id %}
        {% unless product.has_only_default_variant %}<div class="field variant-picker"><span class="variant-picker-label">Choose your options</span><select id="Variant-{{ section.id }}" name="id" aria-label="{{ 'templates.product.variant' | t }}" class="variant-fallback-select">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant.id == first_available_variant.id %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'templates.product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>{% for option in product.options_with_values %}<fieldset class="variant-option-group" data-option-index="{{ forloop.index0 }}"><legend>{{ option.name }}</legend><div class="variant-option-values">{% for value in option.values %}<button type="button" class="variant-option-value" data-option-value="{{ value | escape }}">{{ value | escape }}</button>{% endfor %}</div></fieldset>{% endfor %}</div>{% else %}<input type="hidden" name="id" value="{{ first_available_variant.id }}">{% endunless %}
        {% if has_available_variant %}<div class="purchase-row"><div class="quantity-field"><label for="Quantity-{{ section.id }}">{{ 'templates.product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric" aria-label="{{ 'templates.product.quantity' | t }}"></div><button class="button add-to-cart" type="submit" data-add-to-cart>{{ 'templates.product.add_to_cart' | t }}</button></div>{% else %}<button class="button" type="button" disabled>{{ 'templates.product.sold_out' | t }}</button>{% endif %}
        {% if has_available_variant %}<div class="accelerated-checkout">{{ form | payment_button }}</div>{% endif %}
      {% endform %}
      {% if has_available_variant %}<div class="mobile-buy-bar" data-mobile-buy aria-label="{{ 'templates.product.add_to_cart' | t }}"><span><small>{{ product.title | escape }}</small><strong data-mobile-buy-price>{{ first_available_variant.price | money }}</strong></span><button class="button" type="button" data-mobile-buy>{{ 'templates.product.add_to_cart' | t }}</button></div>{% endif %}
      <div class="product-trust-strip product-trust-strip--purchase" aria-label="{{ 'templates.product.trust_label' | t }}"><span>{{ 'templates.product.trust_secure' | t }}</span><span>{{ 'templates.product.trust_returns' | t }}</span><span>{{ 'templates.product.trust_shipping' | t }}</span></div>
      <div class="product-actions-note" aria-live="polite"><span aria-hidden="true">✓</span><span>Secure checkout · Easy returns</span></div>
      <div class="product-buy-confidence" aria-label="Purchase reassurance">
        <div class="buy-confidence-item"><span aria-hidden="true">↻</span><div><strong>Easy returns</strong><small>Review our return policy before purchase.</small></div></div>
        <div class="buy-confidence-item"><span aria-hidden="true">⌁</span><div><strong>Secure checkout</strong><small>Your payment is processed securely.</small></div></div>
      </div>{% if product.description != blank %}<div class="product-details"><details open><summary>Product details</summary><div class="product-description rte">{{ product.description }}</div></details></div>{% endif %}
      <!-- Start of Judge.me code -->
      {% assign has_legacy = false %}
      {% if product.metafields.judgeme.widget.size > 20 %}
        {% assign has_legacy = true %}
      {% endif %}
      <div style='clear:both'></div>
      <div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget'
        data-product-title='{{ product.title | escape }}'
        data-id='{{ product.id }}'
        data-product-id='{{ product.id }}'
        data-widget='review'
        data-auto-install='false'
        data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}'
        data-entry-point='review_widget.js'
        data-entry-key='review-widget/main.js'>
        {% if has_legacy %}
          <div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>
        {% endif %}
      </div>
      {% if product.metafields.judgeme.review_widget_data %}
        <script>
          jdgm.data ||= {};
          jdgm.data.reviewWidget ||= {};
          jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }};
        </script>
      {% endif %}
      <!-- End of Judge.me code -->
      <div class="product-confidence">
        <details><summary>Shipping & delivery</summary><p>Shipping options and delivery estimates are shown at checkout based on your destination.</p></details>
        <details><summary>Returns</summary><p>Return eligibility and instructions vary by order. Please check the store return policy before purchasing.</p></details>
      </div>
      {% unless product.has_only_default_variant %}<details class="product-size-fit"><summary>Size & measurements</summary><p>Check the available size or option above before adding to cart. Where measurements are provided for this product, use them to compare with a similar garment you already own.</p></details>{% endunless %}
      {% unless product.has_only_default_variant %}<script type="application/json" id="ProductVariants-{{ section.id }}">{{ product.variants | json }}</script><script>(function(){function init(){var root=document.querySelector('.product-page[data-product-section="{{ section.id }}"]');if(!root)return;var s=root.querySelector('#Variant-{{ section.id }}'),d=root.querySelector('#ProductVariants-{{ section.id }}'),p=root.querySelector('[data-product-price]'),pm=root.querySelector('[data-product-price-meta]'),cp=root.querySelector('[data-product-compare]'),sale=root.querySelector('[data-product-sale]'),a=root.querySelector('[data-product-availability]'),availability=root.querySelector('[itemprop="availability"]'),sticky=root.querySelector('[data-mobile-buy]'),main=root.querySelector('[data-add-to-cart]'),mobilePrice=root.querySelector('[data-mobile-buy-price]');if(s&&d&&!root.dataset.variantInitialized){root.dataset.variantInitialized='true';var variants=JSON.parse(d.textContent),byId={};variants.forEach(function(v){byId[String(v.id)]=v});var groups=root.querySelectorAll('.variant-option-group'),selected={};var current=byId[String(s.value)]||variants[0];if(current&&current.options){current.options.forEach(function(v,i){selected[i]=v});}function syncButtons(){groups.forEach(function(g){var idx=Number(g.dataset.optionIndex),buttons=g.querySelectorAll('[data-option-value]');buttons.forEach(function(b){var value=b.dataset.optionValue;b.classList.toggle('is-selected',selected[idx]===value);var possible=variants.some(function(v){if(!v.available)return false;if(!v.options||v.options[idx]!==value)return false;for(var j=0;j<v.options.length;j++){if(j!==idx&&selected[j]&&v.options[j]!==selected[j])return false;}return true;});b.disabled=!possible;});});}function chooseOption(idx,value){selected[idx]=value;var match=variants.find(function(v){return v.available&&v.options&&v.options.every(function(val,i){return selected[i]===val});});if(match){s.value=String(match.id);s.dispatchEvent(new Event('change',{bubbles:true}));}syncButtons();}groups.forEach(function(g){var idx=Number(g.dataset.optionIndex);g.addEventListener('click',function(e){var b=e.target.closest('[data-option-value]');if(b&&!b.disabled)chooseOption(idx,b.dataset.optionValue);});});syncButtons();var money=new Intl.NumberFormat(document.documentElement.lang||'en-AU',{style:'currency',currency:(window.EdenRoseConfig&&window.EdenRoseConfig.currency)||'AUD'});s.addEventListener('change',function(){var v=byId[s.value];if(!v)return;p.textContent=money.format(v.price/100);if(pm)pm.content=(v.price/100).toFixed(2);if(availability)availability.content=!s.options[s.selectedIndex].disabled?'https://schema.org/InStock':'https://schema.org/OutOfStock';var onsale=v.compare_at_price&&v.compare_at_price>v.price;if(cp){cp.hidden=!onsale;if(onsale)cp.textContent=money.format(v.compare_at_price)}if(sale)sale.hidden=!onsale;if(!s.options[s.selectedIndex].disabled){a.innerHTML='<span aria-hidden="true">●</span> {{ 'templates.product.available' | t }}';if(v.inventory_management&&v.inventory_quantity>0&&v.inventory_quantity<=5)a.innerHTML+=' '+v.inventory_quantity+' '+{{ 'templates.product.left' | t | json }};if(main)main.disabled=false}else{if(a)a.innerHTML='{{ 'templates.product.sold_out' | t }}';if(main)main.disabled=true}syncMobile()})}function syncMobile(){if(!s)return;var opt=s.options[s.selectedIndex];if(mobilePrice){var parts=opt.textContent.split(' — ');mobilePrice.textContent=parts[1]?parts[1].split(' — ')[0]:opt.textContent}if(sticky&&main)sticky.disabled=main.disabled}if(sticky&&main&&!root.dataset.mobileBuyInitialized){root.dataset.mobileBuyInitialized='true';sticky.addEventListener('click',function(){if(!main.disabled)main.click()})}syncMobile()}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init()})();</script>
<script>
(function(){
  var root=document.querySelector('[data-product-gallery]');
  if(!root||root.dataset.galleryBound)return;
  root.dataset.galleryBound='true';
  var expand=root.querySelector('[data-gallery-expand]');
  if(!expand)return;
  var overlay=document.createElement('div');
  overlay.className='edenrose-gallery-lightbox';
  overlay.hidden=true;
  overlay.innerHTML='<div class="gallery-lightbox-backdrop"></div><div class="gallery-lightbox-panel" role="dialog" aria-modal="true" aria-label="Product image viewer"><button type="button" class="gallery-lightbox-close" aria-label="Close image viewer">×</button><div class="gallery-lightbox-track"></div></div>';
  document.body.appendChild(overlay);
  var track=overlay.querySelector('.gallery-lightbox-track'), close=overlay.querySelector('.gallery-lightbox-close'), previousFocus=null;
  function open(){previousFocus=document.activeElement;track.innerHTML='';root.querySelectorAll('.product-media-item img').forEach(function(img){var copy=img.cloneNode();copy.removeAttribute('loading');track.appendChild(copy)});overlay.hidden=false;document.body.classList.add('gallery-lightbox-open');close.focus();}
  function shut(){overlay.hidden=true;document.body.classList.remove('gallery-lightbox-open');if(previousFocus)previousFocus.focus();}
  expand.addEventListener('click',open);close.addEventListener('click',shut);overlay.querySelector('.gallery-lightbox-backdrop').addEventListener('click',shut);
  document.addEventListener('keydown',function(e){if(!overlay.hidden&&e.key==='Escape')shut();});
})();
</script>
{% stylesheet %}
.product-page{padding:clamp(2.5rem,6vw,6.5rem) 0;position:relative}.product-page:before{content:"THE EDENROSE EDIT";display:block;max-width:1280px;margin:0 auto 1.25rem;padding:0 20px;font-size:.62rem;letter-spacing:.2em;color:var(--muted)}.product-kicker{display:flex;gap:.55rem;align-items:center;margin-bottom:1rem}.product-kicker span{font-size:.64rem;text-transform:uppercase;letter-spacing:.13em;border:1px solid var(--line);padding:.4rem .6rem;border-radius:999px}.product-kicker span:first-child{background:var(--wine);border-color:var(--wine);color:#fff}.product-purchase-intro{font-size:.85rem;color:var(--muted);max-width:38ch;margin-bottom:.5rem}.mobile-buy-bar{display:none}.product-layout{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(340px,.82fr);gap:clamp(2.5rem,6vw,7rem);align-items:start}.product-media{display:grid;position:relative;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;outline:none}.product-media-item{margin:0;overflow:hidden;background:var(--soft);border-radius:10px;line-height:0;box-shadow:0 12px 30px rgba(33,26,27,.05)}.gallery-hint{display:none}.product-media-item{cursor:zoom-in}.product-media-item img{display:block;width:100%;height:auto;transition:transform .45s ease}.product-media-item:first-child{grid-column:1/-1}.product-media-item:hover img{transform:scale(1.012)}.product-info{position:sticky;top:105px;align-self:start;padding:1.5rem 0 2rem;max-width:560px;min-width:0}.product-info h1{font-size:clamp(2.4rem,4.8vw,4.8rem);line-height:.94;letter-spacing:-.05em;margin:.25rem 0 1.15rem;max-width:14ch;overflow-wrap:anywhere}.product-price{display:flex;align-items:center;flex-wrap:wrap;gap:.65rem;font-size:1.2rem;font-weight:700;margin:0 0 .55rem}.product-price s{color:var(--muted);font-weight:400}.sale-note{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em}.availability{font-size:.8rem;margin:.5rem 0 1.5rem;color:var(--muted)}.availability span{font-size:.6rem}.product-form{display:grid;gap:1rem}.field{display:grid;gap:.45rem}.field label,.quantity-field label{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em}.field select,.quantity-field input{width:100%;padding:1rem;border:1px solid var(--line);border-radius:8px;background:var(--paper);font:inherit}.purchase-row{display:grid;grid-template-columns:minmax(88px,100px) minmax(0,1fr);gap:.75rem;align-items:end}.quantity-field{display:grid;gap:.45rem}.add-to-cart{width:100%;min-width:0;min-height:60px;font-size:1rem;position:relative;font-weight:600;letter-spacing:.01em;border-radius:999px;box-shadow:0 10px 24px rgba(84,42,53,.12)}.add-to-cart:hover{transform:translateY(-1px)}.add-to-cart:active{transform:translateY(0)}.add-to-cart:focus-visible{outline:var(--focus);outline-offset:3px}.add-to-cart:disabled{opacity:.5;cursor:not-allowed;transform:none}.product-details{border-block:1px solid var(--line);padding:1.25rem 0;margin-top:2rem}.product-details summary{cursor:pointer;font-weight:600;display:flex;justify-content:space-between}.product-details summary::after{content:"+ ";font-weight:400}.product-details[open] summary::after{content:"− "}.product-description{margin-top:1rem;overflow-wrap:anywhere;word-break:normal;color:var(--muted);line-height:1.7}.product-description img{height:auto;max-width:100%}.product-description a{text-decoration:underline;text-underline-offset:3px}.product-confidence{display:grid;gap:0;border-top:1px solid var(--line);margin-top:1.5rem}.product-confidence details{border-bottom:1px solid var(--line);padding:1rem 0}.product-confidence summary{cursor:pointer;font-weight:600;display:flex;justify-content:space-between}.product-confidence summary::after{content:'+'}.product-confidence details[open] summary::after{content:'−'}.product-confidence p{color:var(--muted);line-height:1.6;font-size:.85rem;margin:.7rem 0 .35rem}.product-confidence a{font-size:.75rem;text-decoration:underline}.product-trust{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);margin-top:1.5rem}.product-trust>div{padding:1rem .8rem 0 0;border-right:1px solid var(--line);display:grid;gap:.3rem;font-size:.78rem}.product-trust>div:not(:first-child){padding-left:.8rem}.product-trust>div:last-child{border-right:0}.product-trust span{color:var(--muted);line-height:1.5}.product-trust a{font-size:.72rem;text-decoration:underline;text-underline-offset:3px;margin-top:.15rem}.product-actions-note{display:flex;gap:.5rem;align-items:center;margin-top:1rem;padding:.75rem .9rem;background:var(--soft);border-radius:10px;font-size:.75rem;color:var(--muted)}.product-actions-note span:first-child{color:var(--wine);font-weight:700}.gallery-expand{display:block;position:absolute;right:.6rem;bottom:.6rem;z-index:4;border:1px solid var(--line);background:rgba(251,247,243,.94);border-radius:999px;padding:.55rem .75rem;font:inherit;font-size:.62rem;text-transform:uppercase;letter-spacing:.08em;cursor:pointer}.gallery-expand:focus-visible{outline:var(--focus);outline-offset:3px}.gallery-hint{display:block;position:absolute;right:.6rem;top:.6rem;z-index:3;padding:.4rem .6rem;background:rgba(251,247,243,.9);border-radius:999px;font-size:.6rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}@media(max-width:749px){.gallery-expand{bottom:.5rem;right:.5rem}.product-page{padding-top:1rem;overflow-x:clip}.product-layout{display:block}.product-media{grid-template-columns:1fr 1fr;gap:.45rem;margin-inline:-16px;min-width:0}.product-media-item:first-child{grid-column:1/-1}.product-info{position:static;padding-top:1.75rem}.product-info h1{font-size:clamp(2.2rem,10.5vw,4rem);max-width:12ch}.purchase-row{grid-template-columns:minmax(82px,90px) minmax(0,1fr)}.product-trust{grid-template-columns:1fr}.product-trust>div,.product-trust>div:not(:first-child){border-right:0;border-bottom:1px solid var(--line);padding:1rem 0}.product-trust>div:last-child{border-bottom:0}.purchase-row{grid-template-columns:90px 1fr}.add-to-cart{min-height:58px}.mobile-buy-bar{position:fixed;left:0;right:0;bottom:0;z-index:40;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem 16px calc(.7rem + env(safe-area-inset-bottom));background:rgba(251,247,243,.98);border-top:1px solid var(--line);box-shadow:0 -8px 24px rgba(33,26,27,.08)}.mobile-buy-bar span{display:grid;gap:.05rem;min-width:0}.mobile-buy-bar small{text-transform:uppercase;letter-spacing:.1em;font-size:.58rem;color:var(--muted)}.mobile-buy-bar strong{font-size:.88rem}.mobile-buy-bar .button{min-height:48px;padding-inline:20px;white-space:nowrap;border-radius:999px}.product-info{padding-bottom:6rem}}

.product-buy-confidence{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin-top:.8rem}.buy-confidence-item{display:flex;gap:.65rem;align-items:flex-start;padding:.75rem;border:1px solid var(--line);border-radius:10px;background:var(--soft)}.buy-confidence-item>span{font-size:1rem;line-height:1.2}.buy-confidence-item strong{display:block;font-size:.76rem;letter-spacing:.03em}.buy-confidence-item small{display:block;color:var(--muted);font-size:.68rem;line-height:1.35;margin-top:.2rem}@media(max-width:749px){.product-buy-confidence{gap:.5rem}.buy-confidence-item{padding:.65rem}.buy-confidence-item small{font-size:.64rem}}

.variant-fallback-select{position:absolute!important;width:1px!important;height:1px!important;opacity:0!important;pointer-events:none!important}.variant-picker{gap:.8rem}.variant-picker-label{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em}.variant-option-group{border:0;padding:0;margin:0}.variant-option-group legend{font-size:.78rem;font-weight:600;margin-bottom:.45rem}.variant-option-values{display:flex;flex-wrap:wrap;gap:.45rem}.variant-option-value{min-height:44px;padding:.65rem .9rem;border:1px solid var(--line);border-radius:999px;background:var(--paper);font:inherit;font-size:.84rem;cursor:pointer}.variant-option-value:hover{border-color:var(--ink)}.variant-option-value.is-selected{background:var(--ink);border-color:var(--ink);color:var(--paper)}.variant-option-value:disabled{opacity:.35;text-decoration:line-through;cursor:not-allowed}.variant-option-value:focus-visible{outline:var(--focus);outline-offset:2px}
{% endstylesheet %}
