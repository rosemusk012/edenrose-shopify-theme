<section class="product-page"><div class="page-width product-layout"><div class="product-media">{% for image in product.images %}{{ image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}{% endfor %}</div><div class="product-info"><p class="eyebrow">{{ product.type | escape }}</p><h1>{{ product.title | escape }}</h1><div class="card-price">{{ product.price | money }}</div>{% if product.description != blank %}<div class="product-description">{{ product.description }}</div>{% endif %}{% form 'product', product, class: 'product-form' %}{% unless product.has_only_default_variant %}<label for="Variant-{{ section.id }}">{{ 'templates.product.variant' | t }}</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'templates.product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="Quantity-{{ section.id }}">{{ 'templates.product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1"><button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ 'templates.product.add_to_cart' | t }}{% else %}{{ 'templates.product.sold_out' | t }}{% endif %}</button>{% endform %}<div class="trust-row"><div class="trust"><strong>{{ 'templates.product.shipping_title' | t }}</strong>{{ 'templates.product.shipping_text' | t }}</div><div class="trust"><strong>{{ 'templates.product.returns_title' | t }}</strong>{{ 'templates.product.returns_text' | t }}</div><div class="trust"><strong>{{ 'templates.product.secure_title' | t }}</strong>{{ 'templates.product.secure_text' | t }}</div></div></div></div></section>
{% schema %}{"name":"t:sections.main_product.name"}{% endschema %}