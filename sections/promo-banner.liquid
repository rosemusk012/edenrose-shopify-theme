<section class="promo-banner" aria-label="Current EdenRose promotion">
  <div class="page-width promo-banner__inner">
    <span class="promo-banner__message">10% off your EdenRose order</span>
    <span class="promo-banner__code">Use code <strong>EDENROSE10</strong></span>
    <a class="promo-banner__link" href="/collections/all">Shop now <span aria-hidden="true">↗</span></a>
  </div>
</section>

{% stylesheet %}
.promo-banner{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--ink);color:#fff}
.promo-banner__inner{min-height:3.4rem;display:flex;align-items:center;justify-content:center;gap:1.25rem;flex-wrap:wrap;text-align:center;padding-top:.65rem;padding-bottom:.65rem}
.promo-banner__message{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
.promo-banner__code{font-size:.82rem}
.promo-banner__code strong{letter-spacing:.12em}
.promo-banner__link{color:inherit;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:.15rem;font-size:.78rem;letter-spacing:.06em;text-transform:uppercase}
.promo-banner__link span{display:inline-block;margin-left:.25rem}
@media(max-width:749px){.promo-banner__inner{gap:.35rem .8rem}.promo-banner__message{width:100%}.promo-banner__code,.promo-banner__link{font-size:.72rem}}
{% endstylesheet %}

{% schema %}
{"name":"Promotion banner","presets":[{"name":"Promotion banner"}]}
{% endschema %}