<section class="promo-banner" aria-label="{{ 'sections.promo_banner.aria_label' | t }}">
  <div class="page-width promo-banner__inner">
    <span class="promo-banner__message">{{ 'sections.promo_banner.message' | t }}</span>
    <span class="promo-banner__code">{{ 'sections.promo_banner.use_code' | t }} <strong>EDENROSE10</strong></span>
    <a class="promo-banner__link" href="{{ routes.all_products_collection_url }}">{{ 'sections.promo_banner.shop_now' | t }} <span aria-hidden="true">↗</span></a>
  </div>
</section>

{% stylesheet %}
.promo-banner{position:relative;z-index:0;border-bottom:1px solid var(--line);background:var(--soft);color:var(--ink)}
.promo-banner__inner{min-height:2.7rem;display:flex;align-items:center;justify-content:center;gap:.7rem 1rem;flex-wrap:wrap;text-align:center;padding:.45rem 16px}
.promo-banner__message{font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}
.promo-banner__code{font-size:.72rem;color:var(--muted)}
.promo-banner__code strong{color:var(--ink);letter-spacing:.12em}
.promo-banner__link{color:var(--ink);text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:.1rem;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}
.promo-banner__link span{display:inline-block;margin-left:.2rem}
@media(max-width:749px){.promo-banner__inner{gap:.25rem .65rem;padding:.4rem 12px}.promo-banner__message{width:auto}.promo-banner__code,.promo-banner__link{font-size:.66rem}}
{% endstylesheet %}

{% schema %}
{"name":"Promotion banner","presets":[{"name":"Promotion banner"}]}
{% endschema %}