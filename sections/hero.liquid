<section class="hero" aria-labelledby="HeroHeading"><div class="page-width hero-grid"><div class="hero-copy">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h1 id="HeroHeading">{{ section.settings.heading | escape }}</h1>{% if section.settings.text != blank %}<p class="hero-text">{{ section.settings.text | escape }}</p>{% endif %}<div class="hero-actions">{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}</a>{% endif %}{% if section.settings.secondary_label != blank %}<a class="button button--quiet" href="{{ section.settings.secondary_link | escape }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}</div><div class="hero-proof"><span>{{ 'sections.hero.proof_clothing' | t }}</span><span>{{ 'sections.hero.proof_jewellery' | t }}</span><span>{{ 'sections.hero.proof_new_arrivals' | t }}</span></div></div><div class="hero-art hero-art--minimal" aria-hidden="true"><div class="hero-art-panel"><span class="hero-art-kicker">EDENROSE</span><span class="hero-art-title">The new edit</span><span class="hero-art-mark">✦</span></div></div></div></section>{% stylesheet %}.hero{padding:clamp(2.5rem,6vw,6rem) 0}.hero-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr);gap:clamp(1.5rem,4vw,4rem);align-items:center}.hero-copy{max-width:44rem;min-width:0}.hero h1{font-size:clamp(2.8rem,5.2vw,5.4rem);line-height:1.02;letter-spacing:-.055em;margin:.4rem 0 1.4rem;max-width:14ch;overflow-wrap:normal;word-break:normal}.hero-text{font-size:clamp(1rem,1.5vw,1.2rem);line-height:1.65;color:var(--muted);max-width:36rem}.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.75rem}.button--quiet{background:transparent;color:var(--ink);border:1px solid var(--line)}.hero-proof{display:flex;flex-wrap:wrap;gap:0;margin-top:2rem;border-top:1px solid var(--line);padding-top:.8rem}.hero-proof span{font-size:.7rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);padding-right:1rem;margin-right:1rem;border-right:1px solid var(--line)}.hero-proof span:last-child{border-right:0}.hero-art{min-height:clamp(300px,40vw,560px);border-radius:2px;background:linear-gradient(145deg,#eee9df,#d9d1c4);display:flex;align-items:center;justify-content:center;position:relative;padding:clamp(1rem,3vw,2rem)}.hero-art-panel{width:min(88%,34rem);min-height:clamp(240px,34vw,430px);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;border:1px solid rgba(30,28,25,.12);background:linear-gradient(145deg,#ead2d6,#fbf7f3);padding:clamp(2rem,5vw,4rem);box-sizing:border-box}.hero-art-kicker{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(84,42,53,.7);margin-bottom:.9rem}.hero-art-title{font-size:clamp(2rem,4vw,3.8rem);line-height:1;letter-spacing:-.045em;color:#542a35}.hero-art-mark{margin-top:1.5rem;font-size:1.8rem;color:rgba(84,42,53,.4)}@media(max-width:749px){.hero{padding:2rem 0 3rem}.hero-grid{grid-template-columns:1fr;gap:2rem}.hero h1{font-size:clamp(2.55rem,11vw,3.65rem);line-height:1.02;max-width:12ch}.hero-art{min-height:58vw;max-height:460px}.hero-art-panel{width:90%;min-height:78%;padding:2rem}.hero-actions .button{flex:1 1 auto;text-align:center}.hero-proof{margin-top:1.5rem}.hero-proof span{padding-right:.7rem;margin-right:.7rem;font-size:.62rem}}{% endstylesheet %}{% schema %}{"name":"t:sections.hero.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.hero.settings.eyebrow","default":"New season"},{"type":"text","id":"heading","label":"t:sections.hero.settings.heading","default":"Find what feels like you."},{"type":"textarea","id":"text","label":"t:sections.hero.settings.text","default":"A considered collection of clothing and jewellery, easy to browse and easy to buy."},{"type":"text","id":"button_label","label":"t:sections.hero.settings.button_label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"t:sections.hero.settings.button_link","default":"/collections/all"},{"type":"text","id":"secondary_label","label":"t:sections.hero.settings.secondary_label","default":"New arrivals"},{"type":"url","id":"secondary_link","label":"t:sections.hero.settings.secondary_link","default":"/collections/new-arrivals"},{"type":"image_picker","id":"image","label":"t:sections.hero.settings.image"}],"presets":[{"name":"t:sections.hero.name"}]}{% endschema %}