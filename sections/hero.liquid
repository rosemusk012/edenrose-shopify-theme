<section class="hero" aria-labelledby="HeroHeading"><div class="page-width hero-grid"><div class="hero-copy">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h1 id="HeroHeading">{{ section.settings.heading | escape }}</h1>{% if section.settings.text != blank %}<p class="hero-text">{{ section.settings.text | escape }}</p>{% endif %}<div class="hero-actions">{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}</a>{% endif %}{% if section.settings.secondary_label != blank %}<a class="button button--quiet" href="{{ section.settings.secondary_link | escape }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}</div><div class="hero-proof"><span>{{ 'sections.hero.proof_clothing' | t }}</span><span>{{ 'sections.hero.proof_jewellery' | t }}</span><span>{{ 'sections.hero.proof_new_arrivals' | t }}</span></div></div><div class="hero-art" aria-hidden="true">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '600,900,1200', sizes: '(min-width: 750px) 50vw, 100vw', class: 'hero-image' }}{% else %}<div class="hero-art-inner" aria-hidden="true"><span></span><i></i></div>{% endif %}</div></div></section>{% stylesheet %}.hero{padding:clamp(2.5rem,6vw,6rem) 0}.hero-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr);gap:clamp(1.5rem,4vw,4rem);align-items:center}.hero-copy{max-width:44rem;min-width:0}.hero h1{font-size:clamp(2.8rem,5.2vw,5.4rem);line-height:1.02;letter-spacing:-.055em;margin:.4rem 0 1.4rem;max-width:14ch;overflow-wrap:normal;word-break:normal}.hero-text{font-size:clamp(1rem,1.5vw,1.2rem);line-height:1.65;color:var(--muted);max-width:36rem}.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.75rem}.button--quiet{background:transparent;color:var(--ink);border:1px solid var(--line)}.hero-proof{display:flex;flex-wrap:wrap;gap:0;margin-top:2rem;border-top:1px solid var(--line);padding-top:.8rem}.hero-proof span{font-size:.7rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);padding-right:1rem;margin-right:1rem;border-right:1px solid var(--line)}.hero-proof span:last-child{border-right:0}.hero-art{min-height:clamp(300px,40vw,560px);overflow:hidden;border-radius:2px;background:linear-gradient(145deg,#eee9df,#d9d1c4);display:flex;align-items:center;justify-content:center;position:relative;padding:clamp(1rem,3vw,2rem)}.hero-image{width:100%;height:100%;object-fit:cover} .hero-art-inner{position:relative;width:min(78%,30rem);height:min(78%,30rem);aspect-ratio:1;border:1px solid rgba(30,28,25,.14);overflow:hidden;background:linear-gradient(145deg,rgba(234,210,214,.96),rgba(251,247,243,.45));transform:rotate(2deg)}.hero-art-inner:before{content:'';position:absolute;width:55%;height:55%;border-radius:50%;background:rgba(155,89,107,.16);top:12%;right:8%}.hero-art-inner:after{content:'✦';position:absolute;left:12%;bottom:12%;font-size:2rem;color:rgba(84,42,53,.35)}@media(max-width:749px){.hero{padding:2rem 0 3rem}.hero-grid{grid-template-columns:1fr;gap:2rem}.hero h1{font-size:clamp(2.55rem,11vw,3.65rem);line-height:1.02;max-width:12ch}.hero-art{min-height:72vw;max-height:520px}.hero-actions .button{flex:1 1 auto;text-align:center}.hero-proof{margin-top:1.5rem}.hero-proof span{padding-right:.7rem;margin-right:.7rem;font-size:.62rem}}{% endstylesheet %}{% schema %}{"name":"t:sections.hero.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.hero.settings.eyebrow","default":"New season"},{"type":"text","id":"heading","label":"t:sections.hero.settings.heading","default":"Find what feels like you."},{"type":"textarea","id":"text","label":"t:sections.hero.settings.text","default":"A considered collection of clothing and jewellery, easy to browse and easy to buy."},{"type":"text","id":"button_label","label":"t:sections.hero.settings.button_label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"t:sections.hero.settings.button_link","default":"/collections/all"},{"type":"text","id":"secondary_label","label":"t:sections.hero.settings.secondary_label","default":"New arrivals"},{"type":"url","id":"secondary_link","label":"t:sections.hero.settings.secondary_link","default":"/collections/new-arrivals"},{"type":"image_picker","id":"image","label":"t:sections.hero.settings.image"}],"presets":[{"name":"t:sections.hero.name"}]}{% endschema %}