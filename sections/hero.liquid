<section class="hero">
  <div class="page-width hero-grid">
    <div class="hero-copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
      {% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
      <div class="hero-proof"><span>New pieces weekly</span><span>Easy browsing</span><span>Secure checkout</span></div>
    </div>
    <div class="hero-art">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '700,1000,1400', sizes: '(min-width: 900px) 42vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}
      {% else %}
        <div class="hero-placeholder"><span>Add your hero image in the theme editor</span></div>
      {% endif %}
      <span class="hero-art-mark" aria-hidden="true">EDENROSE</span>
    </div>
  </div>
</section>
{% stylesheet %}
.hero{padding:clamp(2.5rem,5vw,5rem) 0;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(360px,1.05fr);gap:clamp(2rem,5vw,5rem);align-items:center}.hero-copy{position:relative}.hero h1{font:normal clamp(3.4rem,7vw,7rem)/.9 var(--display);letter-spacing:-.055em;margin:0 0 1.4rem;max-width:8ch}.hero p{font-size:1rem;max-width:38rem;color:var(--muted);line-height:1.7}.hero-art{aspect-ratio:4/5;position:relative;overflow:hidden;background:var(--soft);border-radius:2px}.hero-art img{width:100%;height:100%;object-fit:cover;display:block}.hero-placeholder{height:100%;display:grid;place-items:center;padding:2rem;text-align:center;color:var(--muted);border:1px dashed var(--line)}.hero-art-mark{position:absolute;right:1.25rem;bottom:1.1rem;font:italic clamp(1.8rem,4vw,3.5rem) var(--display);color:#fff;text-shadow:0 2px 16px rgba(0,0,0,.2);letter-spacing:.02em}.hero-proof{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.35rem}.hero-proof span{font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;border:1px solid var(--line);border-radius:999px;padding:.48rem .68rem;color:var(--muted)}@media(max-width:749px){.hero-grid{grid-template-columns:1fr;gap:1.75rem}.hero{padding-top:2rem}.hero h1{font-size:clamp(3rem,14vw,5rem)}.hero-art{order:-1;aspect-ratio:4/5}.hero-copy{padding-top:.25rem}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.hero.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.hero.settings.eyebrow","default":"The new EdenRose edit"},{"type":"text","id":"heading","label":"t:sections.hero.settings.heading","default":"Find something that feels like you."},{"type":"textarea","id":"text","label":"t:sections.hero.settings.text","default":"New fashion, jewellery and pieces worth discovering — curated to make browsing easy."},{"type":"text","id":"button_label","label":"t:sections.hero.settings.button_label","default":"Shop new arrivals"},{"type":"url","id":"button_link","label":"t:sections.hero.settings.button_link"},{"type":"image_picker","id":"image","label":"Hero image"}],"presets":[{"name":"t:sections.hero.name"}]}{% endschema %}