<section class="hero"><div class="page-width hero-grid"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h1>{{ section.settings.heading | escape }}</h1>{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div><div class="hero-art"><span>{{ shop.name | escape }}</span></div></div></section>
{% schema %}{"name":"t:sections.hero.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.hero.settings.eyebrow","default":"New season"},{"type":"text","id":"heading","label":"t:sections.hero.settings.heading","default":"Find something that feels like you."},{"type":"textarea","id":"text","label":"t:sections.hero.settings.text","default":"A considered collection of clothing and jewellery, made easy to browse and easy to buy."},{"type":"text","id":"button_label","label":"t:sections.hero.settings.button_label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"t:sections.hero.settings.button_link"}],"presets":[{"name":"t:sections.hero.name"}]}{% endschema %}