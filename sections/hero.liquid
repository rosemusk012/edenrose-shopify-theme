<section class="hero"><div class="page-width hero-grid"><div class="hero-copy">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<span class="hero-stamp" aria-hidden="true">EDEN<br>ROSE</span><h1>{{ section.settings.heading | escape }}</h1>{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}{% if section.settings.button_label != blank %}<a class="button hero-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</div><div class="hero-orbit" aria-hidden="true"><span></span><span></span></div></div></section>\n{% stylesheet %}.hero{position:relative;overflow:hidden;background:var(--paper);padding:clamp(64px,10vw,132px) 0 clamp(58px,8vw,100px)}.hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,.42fr);align-items:center;min-height:clamp(420px,54vw,680px)}.hero-copy{position:relative;z-index:2;max-width:760px}.hero-copy h1{max-width:9ch;margin:.35rem 0 1.4rem;font-family:var(--display);font-size:clamp(4rem,8.5vw,8.8rem);font-weight:400;line-height:.84;letter-spacing:-.055em}.hero-copy>p:not(.eyebrow){max-width:34rem;margin:0 0 1.8rem;color:var(--muted);font-size:clamp(1rem,1.5vw,1.15rem);line-height:1.65}.hero-button{display:inline-flex;align-items:center;gap:.65rem}.hero-button span{transition:transform .2s ease}.hero-button:hover span{transform:translate(.16rem,-.16rem)}.hero-stamp{position:absolute;right:7%;top:3%;display:grid;place-items:center;width:86px;height:86px;border:1px solid var(--line);border-radius:50%;font-size:9px;line-height:1.05;letter-spacing:.16em;text-align:center;color:var(--wine);transform:rotate(9deg)}.hero-orbit{position:absolute;right:-8%;top:50%;width:min(45vw,600px);aspect-ratio:1;transform:translateY(-50%);border:1px solid var(--line);border-radius:50%;opacity:.7}.hero-orbit:before,.hero-orbit:after{content:"";position:absolute;inset:12%;border:1px solid rgba(120,80,80,.14);border-radius:50%}.hero-orbit span{position:absolute;width:12px;height:12px;border-radius:50%;background:var(--wine);left:18%;top:18%}.hero-orbit span+span{left:auto;top:auto;right:15%;bottom:20%;width:7px;height:7px;background:var(--accent)}.hero:after{content:"";position:absolute;width:min(38vw,500px);aspect-ratio:1;border-radius:50%;background:var(--rose);opacity:.28;right:-17%;bottom:-48%}@media(max-width:749px){.hero{padding:54px 0 52px}.hero-grid{display:block;min-height:0}.hero-copy{padding:0 4px}.hero-copy h1{font-size:clamp(3.7rem,16vw,6rem);max-width:8ch}.hero-copy>p:not(.eyebrow){max-width:31rem;font-size:.98rem}.hero-stamp{right:4%;top:-2%;width:70px;height:70px;font-size:8px}.hero-orbit{position:relative;right:auto;top:auto;width:82vw;max-width:430px;margin:36px -7vw -24vw auto;transform:none;opacity:.5}.hero:after{right:-35%;bottom:-25%;width:70vw}}@media(prefers-reduced-motion:reduce){.hero-button span{transition:none}.hero-button:hover span{transform:none}}{% endstylesheet %}
{% schema %}{"name":"t:sections.hero.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.hero.settings.eyebrow","default":"New season"},{"type":"text","id":"heading","label":"t:sections.hero.settings.heading","default":"Find something that feels like you."},{"type":"textarea","id":"text","label":"t:sections.hero.settings.text","default":"A considered collection of clothing and jewellery, made easy to browse and easy to buy."},{"type":"text","id":"button_label","label":"t:sections.hero.settings.button_label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"t:sections.hero.settings.button_link"}],"presets":[{"name":"t:sections.hero.name"}]}{% endschema %}