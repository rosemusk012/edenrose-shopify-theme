<header class="site-header">
  <div class="page-width header-row">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 600 | image_tag: loading: 'eager', widths: '180,300,450,600', sizes: '(min-width: 901px) 220px, 160px', class: 'brand-logo', alt: shop.name }}{% else %}<span>{{ shop.name | escape }}</span>{% endif %}</a>
    <nav class="nav nav-desktop" aria-label="{{ 'accessibility.main_navigation' | t }}">
      {% for link in linklists[section.settings.menu].links %}
        {% if link.links != blank %}
          <details class="nav-dropdown">
            <summary aria-expanded="false"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}<span class="nav-dropdown__chevron" aria-hidden="true">⌄</span></summary>
            <div class="nav-dropdown__menu">
              {% for child_link in link.links %}
                <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
              {% endfor %}
            </div>
          </details>
        {% else %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="header-actions">
      <a class="mobile-search-link" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}"><span aria-hidden="true">⌕</span><span class="visually-hidden">{{ 'general.search' | t }}</span></a>
      <form class="header-search" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="HeaderSearch">{{ 'general.search' | t }}</label><input id="HeaderSearch" type="search" name="q" placeholder="{{ 'templates.search.placeholder' | t }}" autocomplete="off"><button type="submit" aria-label="{{ 'general.search' | t }}">⌕</button></form>
      <a class="header-action bag-action" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}{% if cart.item_count > 0 %}, {{ cart.item_count }}{% endif %}"><span>{{ 'general.cart' | t }}</span><span class="bag-count" aria-hidden="true">{{ cart.item_count }}</span></a>
      <details class="mobile-menu">
        <summary aria-label="{{ 'accessibility.menu' | t }}" aria-controls="MobileNavigation-{{ section.id }}"><span class="menu-icon" aria-hidden="true"><i></i><i></i></span><span class="visually-hidden">{{ 'accessibility.menu' | t }}</span></summary>
        <nav id="MobileNavigation-{{ section.id }}" class="mobile-nav" aria-label="{{ 'accessibility.main_navigation' | t }}">
          <div class="mobile-nav-links">
            {% for link in linklists[section.settings.menu].links %}
              {% if link.links != blank %}
                <details class="mobile-nav-group">
                  <summary aria-expanded="false">{{ link.title | escape }}<span aria-hidden="true">⌄</span></summary>
                  <div class="mobile-nav-sub-links">
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                    {% endfor %}
                  </div>
                </details>
              {% else %}
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}<span aria-hidden="true">→</span></a>
              {% endif %}
            {% endfor %}
          </div>
          <div class="mobile-nav-utility">
            <a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
            <a href="{{ routes.cart_url }}">{{ 'general.cart' | t }} <span>{{ cart.item_count }}</span></a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
(function(){
  var menu=document.querySelector('.mobile-menu');
  var dropdowns=[].slice.call(document.querySelectorAll('.nav-dropdown'));
  if(!menu&&!dropdowns.length)return;
  var summary=menu&&menu.querySelector('summary'),nav=menu&&document.getElementById('MobileNavigation-{{ section.id }}');
  function close(){
    if(!menu.open)return;
    menu.removeAttribute('open');
    document.body.classList.remove('mobile-menu-open');
    if(summary){summary.setAttribute('aria-expanded','false');summary.focus();}
  }
  dropdowns.forEach(function(dropdown){
    dropdown.addEventListener('toggle',function(){
      var dropdownSummary=dropdown.querySelector('summary');
      if(dropdownSummary)dropdownSummary.setAttribute('aria-expanded',String(dropdown.open));
      if(dropdown.open)dropdowns.forEach(function(other){if(other!==dropdown){other.removeAttribute('open');var otherSummary=other.querySelector('summary');if(otherSummary)otherSummary.setAttribute('aria-expanded','false');}});
    });
  });
  menu&&menu.addEventListener('toggle',function(){
    document.body.classList.toggle('mobile-menu-open',menu.open);
    if(summary)summary.setAttribute('aria-expanded',String(menu.open));
    if(nav)nav.inert=!menu.open;
  });
  document.addEventListener('keydown',function(event){
    if(event.key==='Escape'){
      if(menu&&menu.open)close();
      dropdowns.forEach(function(dropdown){if(dropdown.open){dropdown.removeAttribute('open');var dropdownSummary=dropdown.querySelector('summary');if(dropdownSummary)dropdownSummary.setAttribute('aria-expanded','false');}});
    }
  });
  document.addEventListener('click',function(event){
    if(menu&&menu.open&&!menu.contains(event.target))close();
    dropdowns.forEach(function(dropdown){if(dropdown.open&&!dropdown.contains(event.target))dropdown.removeAttribute('open');});
  });
})();
</script>
{% stylesheet %}
.site-header{z-index:30}.brand{display:inline-flex;align-items:center;min-width:0}.brand-logo{display:block;width:auto;max-width:220px;max-height:52px;object-fit:contain}.site-header .header-row{position:relative}.nav{display:flex;align-items:center;gap:1.4rem}.nav-dropdown{position:relative}.nav-dropdown summary{list-style:none;display:inline-flex;align-items:center;gap:.3rem;min-height:44px;cursor:pointer}.nav-dropdown summary::-webkit-details-marker{display:none}.nav-dropdown summary:hover,.nav-dropdown summary:focus-visible{text-decoration:underline;text-underline-offset:4px}.nav-dropdown[open] .nav-dropdown__chevron{transform:rotate(180deg)}.nav-dropdown__chevron{font-size:.8rem;transition:transform .2s ease}.nav-dropdown__menu{position:absolute;top:calc(100% + .25rem);left:50%;min-width:210px;transform:translateX(-50%);display:grid;gap:2px;padding:.55rem;background:var(--paper);border:1px solid var(--line);box-shadow:0 16px 35px rgba(23,20,17,.12)}.nav-dropdown__menu a{display:block;padding:.7rem .8rem;white-space:nowrap}.nav-dropdown__menu a:hover,.nav-dropdown__menu a:focus-visible{background:var(--soft);text-decoration:none}.nav-dropdown__menu a[aria-current="page"]{font-weight:700}.header-search{display:flex;align-items:center;gap:4px;border-bottom:1px solid var(--line);min-height:44px}.header-search input{width:150px;border:0;background:transparent;padding:.55rem 0;font:inherit;outline:0}.header-search button{border:0;background:transparent;cursor:pointer;min-width:40px;min-height:40px;font-size:1.15rem}.header-search:focus-within{border-color:var(--ink)}.header-action{display:inline-flex;align-items:center;gap:7px;min-height:44px}.header-action:hover{text-decoration:underline;text-underline-offset:4px}.bag-action{font-weight:600}.bag-count{display:inline-flex;align-items:center;justify-content:center;min-width:1.45rem;height:1.45rem;padding:0 .3rem;border:1px solid var(--ink);border-radius:999px;font-size:.72rem;font-weight:500}.mobile-menu{display:none}.mobile-menu-open{overflow:hidden}.mobile-search-link{display:none;align-items:center;justify-content:center;min-width:44px;min-height:44px;font-size:1.15rem}.mobile-search-link:focus-visible{outline:var(--focus);outline-offset:2px}.mobile-menu summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px}.mobile-menu summary::-webkit-details-marker{display:none}.menu-icon{width:20px;display:grid;gap:5px}.menu-icon i{display:block;height:1px;background:currentColor;transition:transform .2s ease}.mobile-menu[open] .menu-icon i:first-child{transform:translateY(3px) rotate(45deg)}.mobile-menu[open] .menu-icon i:last-child{transform:translateY(-3px) rotate(-45deg)}.mobile-nav{position:absolute;right:0;top:calc(100% + 1px);width:min(340px,calc(100vw - 2rem));padding:12px;background:var(--paper);border:1px solid var(--line);box-shadow:0 16px 35px rgba(23,20,17,.12)}.mobile-nav-links{display:grid;gap:2px}.mobile-nav-links a,.mobile-nav-group summary{font-size:.98rem}.mobile-nav a,.mobile-nav-group summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:13px 10px;border-radius:2px}.mobile-nav a:hover,.mobile-nav a:focus-visible,.mobile-nav-group summary:hover,.mobile-nav-group summary:focus-visible{background:var(--soft);text-decoration:none}.mobile-nav-links a[aria-current="page"],.mobile-nav-sub-links a[aria-current="page"]{font-weight:700}.mobile-nav-group{border-radius:2px}.mobile-nav-group summary{list-style:none;cursor:pointer}.mobile-nav-group summary::-webkit-details-marker{display:none}.mobile-nav-group[open] summary{background:var(--soft)}.mobile-nav-group summary span{transition:transform .2s ease}.mobile-nav-group[open] summary span{transform:rotate(180deg)}.mobile-nav-sub-links{display:grid;padding:0 0 .35rem .65rem}.mobile-nav-sub-links a{font-size:.92rem;padding:10px}.mobile-nav-utility{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);margin-top:8px;padding-top:8px}.mobile-nav-utility a{font-size:.9rem}.mobile-nav-utility span{font-size:.75rem}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:900px){.nav-desktop{display:none}.mobile-menu{display:block}.header-row{grid-template-columns:1fr auto}.header-actions{gap:4px}.mobile-search-link{display:inline-flex}.header-search{display:none}}@media(max-width:560px){.header-search input{width:110px}.brand{font-size:24px}.brand-logo{max-width:160px;max-height:44px}.mobile-nav{right:-4px}.header-actions .bag-action > span:first-child{display:none}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.header.name","settings":[{"type":"link_list","id":"menu","label":"t:sections.header.settings.menu","default":"main-menu"},{"type":"image_picker","id":"logo","label":"t:sections.header.settings.logo"}]}{% endschema %}