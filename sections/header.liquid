<header class="site-header">
  <div class="page-width header-row">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{{ shop.name | escape }}</a>
    <nav class="nav nav-desktop" aria-label="{{ 'accessibility.main_navigation' | t }}">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {% endfor %}
    </nav>
    <div class="header-actions">
      <form class="header-search" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="HeaderSearch">{{ 'general.search' | t }}</label><input id="HeaderSearch" type="search" name="q" placeholder="{{ 'templates.search.placeholder' | t }}" autocomplete="off"><button type="submit" aria-label="{{ 'general.search' | t }}">⌕</button></form>
      <a class="header-action bag-action" href="{{ routes.cart_url }}"><span>{{ 'general.cart' | t }}</span><span class="bag-count">{{ cart.item_count }}</span></a>
      <details class="mobile-menu">
        <summary aria-label="{{ 'accessibility.menu' | t }}"><span class="menu-icon" aria-hidden="true"><i></i><i></i></span><span class="visually-hidden">{{ 'accessibility.menu' | t }}</span></summary>
        <nav class="mobile-nav" aria-label="{{ 'accessibility.main_navigation' | t }}">
          <div class="mobile-nav-links">
            {% for link in linklists[section.settings.menu].links %}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}<span aria-hidden="true">→</span></a>
            {% endfor %}
          </div>
          <div class="mobile-nav-utility">
            <a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
            <a href="{{ routes.cart_url }}">{{ 'general.cart' | t }} <span>{{ cart.item_count }}</span></a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
{% stylesheet %}
.site-header{z-index:30}.site-header .header-row{position:relative}.header-search{display:flex;align-items:center;gap:4px;border-bottom:1px solid var(--line);min-height:44px}.header-search input{width:150px;border:0;background:transparent;padding:.55rem 0;font:inherit;outline:0}.header-search button{border:0;background:transparent;cursor:pointer;min-width:40px;min-height:40px;font-size:1.15rem}.header-search:focus-within{border-color:var(--ink)}.header-action{display:inline-flex;align-items:center;gap:7px;min-height:44px}.header-action:hover{text-decoration:underline;text-underline-offset:4px}.bag-action{font-weight:600}.bag-count{display:inline-flex;align-items:center;justify-content:center;min-width:1.45rem;height:1.45rem;padding:0 .3rem;border:1px solid var(--ink);border-radius:999px;font-size:.72rem;font-weight:500}.mobile-menu{display:none}.mobile-menu summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px}.mobile-menu summary::-webkit-details-marker{display:none}.menu-icon{width:20px;display:grid;gap:5px}.menu-icon i{display:block;height:1px;background:currentColor;transition:transform .2s ease}.mobile-menu[open] .menu-icon i:first-child{transform:translateY(3px) rotate(45deg)}.mobile-menu[open] .menu-icon i:last-child{transform:translateY(-3px) rotate(-45deg)}.mobile-nav{position:absolute;right:0;top:calc(100% + 1px);width:min(340px,calc(100vw - 2rem));padding:12px;background:var(--paper);border:1px solid var(--line);box-shadow:0 16px 35px rgba(23,20,17,.12)}.mobile-nav-links{display:grid;gap:2px}.mobile-nav a{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:13px 10px;border-radius:2px}.mobile-nav a:hover,.mobile-nav a:focus-visible{background:#eee7dc;text-decoration:none}.mobile-nav-links a[aria-current="page"]{font-weight:700}.mobile-nav-utility{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);margin-top:8px;padding-top:8px}.mobile-nav-utility a{font-size:.9rem}.mobile-nav-utility span{font-size:.75rem}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:900px){.nav-desktop{display:none}.mobile-menu{display:block}.header-row{grid-template-columns:1fr auto}.header-actions{gap:4px}.header-search{display:none}}@media(max-width:560px){.header-search input{width:110px}.brand{font-size:24px}.mobile-nav{right:-4px}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.header.name","settings":[{"type":"link_list","id":"menu","label":"t:sections.header.settings.menu","default":"main-menu"}]}{% endschema %}