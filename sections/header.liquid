.nav-dropdown__chevron{font-size:.8rem;transition:transform .2s ease}
.nav-dropdown__menu{display:none;position:fixed;z-index:2147483647;top:var(--edenrose-dropdown-top,82px);left:var(--edenrose-dropdown-left,0px);min-width:230px;gap:2px;padding:.65rem;background:var(--paper);border:1px solid var(--line);box-shadow:0 16px 35px rgba(23,20,17,.12);margin-top:0}
.nav-dropdown__menu:after{content:'';position:absolute;left:0;right:0;top:-.75rem;height:.75rem}
.nav-dropdown[open] .nav-dropdown__menu{display:grid}
.nav-dropdown__sub-label{display:block;padding:.55rem .8rem .25rem;font-size:.55rem;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);border-top:1px solid var(--line);margin-top:.25rem}.nav-dropdown__label{display:block;padding:.35rem .8rem .55rem;font-size:.6rem;letter-spacing:.16em;color:var(--muted);border-bottom:1px solid var(--line);margin-bottom:.15rem}
