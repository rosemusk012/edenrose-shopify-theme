<header class="site-header">
  <div class="page-width header-row">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'eager', widths: '180,240,300', sizes: '(min-width: 901px) 180px, 150px', class: 'brand-logo', alt: shop.name }}{% else %}<span>{{ shop.name | escape }}</span>{% endif %}</a>

    {% assign edenrose_categories = 'new_arrivals|new-arrivals,clothing|apparel,jewellery|jewelry,shoes|shoes,accessories|accessories,the_edit|new-arrivals' | split: ',' %}

    <nav class="nav nav-desktop" aria-label="{{ 'accessibility.main_navigation' | t }}">
      <span class="nav-label" aria-hidden="true">Shop</span>
      {% for item in edenrose_categories %}
        {% assign item_parts = item | split: '|' %}
        {% assign item_title = item_parts[0] %}
        {% assign item_handle = item_parts[1] %}
        {% if item_title == 'clothing' %}
          <details class="nav-dropdown">
            <summary aria-expanded="false">Clothing<span class="nav-dropdown__chevron" aria-hidden="true">⌄</span></summary>
            <div class="nav-dropdown__menu">
              <span class="nav-dropdown__label">Shop Clothing</span>
              <a href="{{ collections['apparel'].url }}">All Clothing</a>
              <a href="{{ collections['dresses-1'].url }}">Dresses</a>
              <a href="{{ collections['tops-blouses'].url }}">Tops & Blouses</a>
              <a href="{{ collections['bottoms-sets'].url }}">Bottoms & Sets</a>
              <a href="{{ collections['jumpsuits-rompers'].url }}">Jumpsuits & Rompers</a>
              <a href="{{ collections['sweaters-hoodies'].url }}">Sweaters & Hoodies</a>
              <a href="{{ collections['plus-size'].url }}">Plus Size</a>
              <span class="nav-dropdown__sub-label">Clothing filters</span>
              <a href="{{ collections['maxi-dresses'].url }}">Maxi Dresses</a>
              <a href="{{ collections['midi-dresses'].url }}">Midi Dresses</a>
              <a href="{{ collections['mini-dresses'].url }}">Mini Dresses</a>
              <a href="{{ collections['shirts'].url }}">Shirts</a>
              <a href="{{ collections['cami-tank-tops'].url }}">Cami & Tank Tops</a>
              <a href="{{ collections['active-tops'].url }}">Active Tops</a>
              <a href="{{ collections['jeans'].url }}">Jeans</a>
              <a href="{{ collections['pants'].url }}">Pants</a>
              <a href="{{ collections['shorts-1'].url }}">Shorts</a>
              <a href="{{ collections['skirts-1'].url }}">Skirts</a>
              <a href="{{ collections['leggings'].url }}">Leggings</a>
              <a href="{{ collections['jumpsuits'].url }}">Jumpsuits</a>
              <a href="{{ collections['rompers-1'].url }}">Rompers</a>
            </div>
          </details>
        {% elsif item_title == 'jewellery' %}
          <details class="nav-dropdown">
            <summary aria-expanded="false">Jewellery<span class="nav-dropdown__chevron" aria-hidden="true">⌄</span></summary>
            <div class="nav-dropdown__menu">
              <span class="nav-dropdown__label">Shop Jewellery</span>
              <a href="{{ collections['jewelry'].url }}">All Jewellery</a>
              <a href="{{ collections['rings'].url }}">Rings</a>
              <a href="{{ collections['earrings'].url }}">Earrings</a>
              <a href="{{ collections['necklaces'].url }}">Necklaces</a>
              <a href="{{ collections['pendants'].url }}">Pendants</a>
            </div>
          </details>
        {% elsif item_title == 'accessories' %}
          <details class="nav-dropdown">
            <summary aria-expanded="false">Accessories<span class="nav-dropdown__chevron" aria-hidden="true">⌄</span></summary>
            <div class="nav-dropdown__menu">
              <span class="nav-dropdown__label">More to Discover</span>
              <a href="{{ collections['socks'].url }}">Socks</a>
              <a href="{{ collections['gift-ideas'].url }}">Gift Ideas</a>
              <a href="{{ collections['15-off-selected-styles'].url }}">15% Off Selected Styles</a>
            </div>
          </details>
        {% elsif item_title == 'the_edit' %}
          <details class="nav-dropdown">
            <summary aria-expanded="false">The Edit<span class="nav-dropdown__chevron" aria-hidden="true">⌄</span></summary>
            <div class="nav-dropdown__menu">
              <span class="nav-dropdown__label">EdenRose Edit</span>
              <a href="{{ collections['new-arrivals'].url }}">Trending Now</a>
              <a href="{{ collections['dresses-1'].url }}">Going Out</a>
              <a href="{{ collections['statement-pieces'].url }}">Statement Pieces</a>
              <a href="{{ collections['under-50'].url }}">Under $50</a>
              <a href="{{ collections['15-off-selected-styles'].url }}">15% Off Selected Styles</a>
              <a href="{{ collections['gift-ideas'].url }}">Gift Ideas</a>
            </div>
          </details>
        {% else %}
          <a href="{{ collections[item_handle].url }}">{% case item_title %}{% when 'new_arrivals' %}New Arrivals{% when 'shoes' %}Shoes{% when 'the_edit' %}The Edit{% endcase %}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="header-actions">
      <a class="mobile-search-link" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}"><span aria-hidden="true">⌕</span><span class="visually-hidden">{{ 'general.search' | t }}</span></a>
      <form class="header-search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="HeaderSearch">{{ 'general.search' | t }}</label>
        <input id="HeaderSearch" type="search" name="q" placeholder="{{ 'templates.search.placeholder' | t }}" autocomplete="off">
        <button type="submit" aria-label="{{ 'general.search' | t }}">⌕</button>
      </form>

      <a class="header-action account-action" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">
        <span class="account-icon" aria-hidden="true">♙</span><span>{{ 'customer.account.title' | t }}</span>
      </a>

      <a class="header-action bag-action" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}{% if cart.item_count > 0 %}, {{ cart.item_count }}{% endif %}">
        <span>{{ 'general.cart' | t }}</span><span class="bag-count" aria-hidden="true">{{ cart.item_count }}</span>
      </a>

      {% if localization.available_languages.size > 1 %}
        <localization-form class="header-language">
          {% form 'localization' %}
            <label class="visually-hidden" for="HeaderLanguage">{{ 'general.language' | t }}</label>
            <select id="HeaderLanguage" name="language_code" aria-label="{{ 'general.language' | t }}">
              {% for language in localization.available_languages %}
                <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                  {{ language.endonym_name | capitalize }}
                </option>
              {% endfor %}
            </select>
          {% endform %}
        </localization-form>
      {% endif %}

      <details class="mobile-menu">
        <summary aria-label="{{ 'accessibility.menu' | t }}" aria-controls="MobileNavigation-{{ section.id }}" aria-expanded="false">
          <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
          <span class="visually-hidden">{{ 'accessibility.menu' | t }}</span>
        </summary>
        <nav id="MobileNavigation-{{ section.id }}" class="mobile-nav" aria-label="{{ 'accessibility.main_navigation' | t }}">
          <div class="mobile-nav-links">
            {% for item in edenrose_categories %}
              {% assign item_parts = item | split: '|' %}
              {% assign item_title = item_parts[0] %}
              {% assign item_handle = item_parts[1] %}
              {% if item_title == 'clothing' %}
                <details class="mobile-nav-group">
                  <summary aria-expanded="false">Clothing<span aria-hidden="true">⌄</span></summary>
                  <div class="mobile-nav-sub-links">
                    <a href="{{ collections['apparel'].url }}">All Clothing</a>
                    <a href="{{ collections['dresses-1'].url }}">Dresses</a>
                    <a href="{{ collections['tops-blouses'].url }}">Tops & Blouses</a>
                    <a href="{{ collections['bottoms-sets'].url }}">Bottoms & Sets</a>
                    <a href="{{ collections['jumpsuits-rompers'].url }}">Jumpsuits & Rompers</a>
                    <a href="{{ collections['jumpsuits'].url }}">Jumpsuits</a>
                    <a href="{{ collections['rompers-1'].url }}">Rompers</a>
                    <a href="{{ collections['sweaters-hoodies'].url }}">Sweaters & Hoodies</a>
                    <a href="{{ collections['plus-size'].url }}">Plus Size</a>
                    <a href="{{ collections['maxi-dresses'].url }}">Maxi Dresses</a>
                    <a href="{{ collections['midi-dresses'].url }}">Midi Dresses</a>
                    <a href="{{ collections['mini-dresses'].url }}">Mini Dresses</a>
                    <a href="{{ collections['shirts'].url }}">Shirts</a>
                    <a href="{{ collections['cami-tank-tops'].url }}">Cami & Tank Tops</a>
                    <a href="{{ collections['active-tops'].url }}">Active Tops</a>
                    <a href="{{ collections['jeans'].url }}">Jeans</a>
                    <a href="{{ collections['pants'].url }}">Pants</a>
                    <a href="{{ collections['shorts-1'].url }}">Shorts</a>
                    <a href="{{ collections['skirts-1'].url }}">Skirts</a>
                    <a href="{{ collections['leggings'].url }}">Leggings</a>
                  </div>
                </details>
              {% elsif item_title == 'jewellery' %}
                <details class="mobile-nav-group">
                  <summary aria-expanded="false">Jewellery<span aria-hidden="true">⌄</span></summary>
                  <div class="mobile-nav-sub-links">
                    <a href="{{ collections['jewelry'].url }}">All Jewellery</a>
                    <a href="{{ collections['rings'].url }}">Rings</a>
                    <a href="{{ collections['earrings'].url }}">Earrings</a>
                    <a href="{{ collections['necklaces'].url }}">Necklaces</a>
                    <a href="{{ collections['pendants'].url }}">Pendants</a>
                  </div>
                </details>
              {% elsif item_title == 'accessories' %}
                <details class="mobile-nav-group">
                  <summary aria-expanded="false">Accessories<span aria-hidden="true">⌄</span></summary>
                  <div class="mobile-nav-sub-links">
                    <a href="{{ collections['socks'].url }}">Socks</a>
                    <a href="{{ collections['gift-ideas'].url }}">Gift Ideas</a>
                    <a href="{{ collections['15-off-selected-styles'].url }}">15% Off Selected Styles</a>
                  </div>
                </details>
              {% elsif item_title == 'the_edit' %}
                <details class="mobile-nav-group">
                  <summary aria-expanded="false">The Edit<span aria-hidden="true">⌄</span></summary>
                  <div class="mobile-nav-sub-links">
                    <a href="{{ collections['new-arrivals'].url }}">Trending Now</a>
                    <a href="{{ collections['dresses-1'].url }}">Going Out</a>
                    <a href="{{ collections['statement-pieces'].url }}">Statement Pieces</a>
                    <a href="{{ collections['under-50'].url }}">Under $50</a>
                    <a href="{{ collections['15-off-selected-styles'].url }}">15% Off Selected Styles</a>
                    <a href="{{ collections['gift-ideas'].url }}">Gift Ideas</a>
                  </div>
                </details>
              {% else %}
                <a href="{{ collections[item_handle].url }}">{% case item_title %}{% when 'new_arrivals' %}New Arrivals{% when 'shoes' %}Shoes{% when 'the_edit' %}The Edit{% endcase %}<span aria-hidden="true">→</span></a>
              {% endif %}
            {% endfor %}
          </div>
          <div class="mobile-nav-utility">
            <a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>
            <a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
            <a href="{{ routes.cart_url }}">{{ 'general.cart' | t }} <span>{{ cart.item_count }}</span></a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
(function(){
  function init(){
    document.querySelectorAll('.site-header').forEach(function(header){
      if(header.dataset.navigationInitialized) return;
      header.dataset.navigationInitialized='true';

      var menu=header.querySelector('.mobile-menu');
      var dropdowns=[].slice.call(header.querySelectorAll('.nav-dropdown'));
      var summary=menu&&menu.querySelector(':scope > summary');
      var nav=menu&&header.querySelector('#MobileNavigation-{{ section.id }}');
      var mobileGroups=menu?[].slice.call(menu.querySelectorAll('.mobile-nav-group')):[];

      function syncPosition(){
        var r=header.getBoundingClientRect();
        header.style.setProperty('--edenrose-mobile-nav-top',Math.max(0,Math.round(r.bottom))+'px');
      }

      function positionDropdown(dropdown){
        if(!dropdown || !dropdown.open) return;
        var trigger=dropdown.querySelector(':scope > summary');
        var panel=dropdown.querySelector(':scope > .nav-dropdown__menu');
        if(!trigger || !panel) return;
        var r=trigger.getBoundingClientRect();
        panel.style.setProperty('--edenrose-dropdown-top',Math.round(r.bottom)+'px');
        panel.style.setProperty('--edenrose-dropdown-left',Math.round(r.left)+'px');
      }

      function positionOpenDropdowns(){ dropdowns.forEach(positionDropdown); }

      function setExpanded(details){
        var s=details&&details.querySelector(':scope > summary');
        if(s) s.setAttribute('aria-expanded',String(details.open));
      }

      function closeDropdowns(except){
        dropdowns.forEach(function(dropdown){
          if(dropdown!==except && dropdown.open){
            dropdown.removeAttribute('open');
            setExpanded(dropdown);
          }
        });
      }

      function closeMobileMenu(){
        if(!menu||!menu.open) return;
        menu.removeAttribute('open');
        document.body.classList.remove('mobile-menu-open');
        if(nav) nav.inert=true;
        if(summary) summary.setAttribute('aria-expanded','false');
        mobileGroups.forEach(function(group){
          if(group.open){
            group.removeAttribute('open');
            setExpanded(group);
          }
        });
      }

      dropdowns.forEach(function(dropdown){
        var trigger=dropdown.querySelector(':scope > summary');
        if(trigger){
          trigger.addEventListener('click',function(event){
            event.preventDefault();
            event.stopPropagation();
            closeDropdowns(dropdown);
            dropdown.open=!dropdown.open;
            setExpanded(dropdown);
            if(dropdown.open) positionDropdown(dropdown);
          });
        }
        dropdown.addEventListener('toggle',function(){
          setExpanded(dropdown);
          if(dropdown.open){ closeDropdowns(dropdown); positionDropdown(dropdown); }
        });
      });

      if(menu){
        menu.addEventListener('toggle',function(){
          syncPosition();
          document.body.classList.toggle('mobile-menu-open',menu.open);
          if(summary) summary.setAttribute('aria-expanded',String(menu.open));
          if(nav) nav.inert=!menu.open;
        });

        if(nav) nav.inert=true;
      }

      header.addEventListener('keydown',function(event){
        if(event.key!=='Escape') return;
        if(menu&&menu.open) closeMobileMenu();
        closeDropdowns();
      });

      document.addEventListener('click',function(event){
        if(!header.contains(event.target)){
          closeMobileMenu();
          closeDropdowns();
        }
      });

      window.addEventListener('scroll',function(){
        var hasOpenDropdown=dropdowns.some(function(dropdown){ return dropdown.open; });
        if(hasOpenDropdown) positionOpenDropdowns();
      },{passive:true});
      window.addEventListener('resize',function(){
        syncPosition();
        positionOpenDropdowns();
        if(window.innerWidth>900){
          if(menu&&menu.open) closeMobileMenu();
        } else {
          closeDropdowns();
        }
      },{passive:true});

      window.addEventListener('orientationchange',function(){ syncPosition(); positionOpenDropdowns(); },{passive:true});
      syncPosition();
    });

    document.querySelectorAll('localization-form select[name="language_code"]').forEach(function(select){
      if(select.dataset.bound) return;
      select.dataset.bound='true';
      select.addEventListener('change',function(){ select.form.submit(); });
    });
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init);
  else init();
})();
</script>

{% stylesheet %}
.shopify-section:has(.site-header){position:relative;z-index:10000;overflow:visible}
#header-group{position:relative;z-index:10000;overflow:visible}
.site-header{position:sticky;top:0;z-index:10000;overflow:visible;isolation:isolate}
.shopify-section:has(.site-header) .site-header{z-index:10001}
.site-header .header-row{overflow:visible;position:relative;z-index:10001}
.header-row{min-height:82px}
.brand{display:inline-flex;align-items:center;min-width:0}
