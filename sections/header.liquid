<header class="site-header"><div class="page-width header-row"><a class="brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a><nav class="nav" aria-label="{{ 'accessibility.main_navigation' | t }}">{% for link in linklists[section.settings.menu].links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</nav><div class="header-actions"><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a><a href="{{ routes.cart_url }}">{{ 'general.cart' | t }} ({{ cart.item_count }})</a></div></div></header>
{% schema %}{"name":"t:sections.header.name","settings":[{"type":"link_list","id":"menu","label":"t:sections.header.settings.menu","default":"main-menu"}]}{% endschema %}