<section class="shop-look section">
  <div class="page-width">
    <div class="shop-look__head section-head">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
      </div>
      {% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">Shop the edit <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    <div class="shop-look__grid">
      <div class="shop-look__image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700,1000,1400', sizes: '(min-width: 900px) 55vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}
        {% else %}
          <div class="shop-look__placeholder"><span>Add your editorial image in the theme editor</span></div>
        {% endif %}
        <div class="shop-look__stamp" aria-hidden="true">EDEN<br>ROSE</div>
      </div>
      <div class="shop-look__products">
        {% for block in section.blocks %}
          {% assign look_product = block.settings.product %}
          {% if look_product != blank %}
            <article class="shop-look__product" {{ block.shopify_attributes }}>
              <a href="{{ look_product.url }}" class="shop-look__product-media">
                {% if look_product.featured_image %}
                  {{ look_product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', sizes: '(min-width: 900px) 22vw, 45vw', alt: look_product.featured_image.alt | default: look_product.title }}
                {% endif %}
              </a>
              <div class="shop-look__product-info">
                <div><h3><a href="{{ look_product.url }}">{{ look_product.title | escape }}</a></h3><p>{{ look_product.price | money }}</p></div>
                <a class="shop-look__arrow" href="{{ look_product.url }}" aria-label="View {{ look_product.title | escape }}">↗</a>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.shop-look{background:var(--ink);color:#fff}.shop-look .eyebrow,.shop-look .section-head p{color:rgba(255,255,255,.62)}.shop-look .text-link{border-color:rgba(255,255,255,.5)}.shop-look__grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);gap:clamp(1.5rem,4vw,4rem);align-items:stretch}.shop-look__image{min-height:680px;position:relative;overflow:hidden;background:#34292b}.shop-look__image img{width:100%;height:100%;object-fit:cover;display:block}.shop-look__placeholder{height:100%;min-height:680px;display:grid;place-items:center;padding:2rem;text-align:center;color:rgba(255,255,255,.55);border:1px dashed rgba(255,255,255,.25)}.shop-look__stamp{position:absolute;right:1.5rem;bottom:1.5rem;font:italic 2rem/1 var(--display);text-align:right;opacity:.9}.shop-look__products{display:grid;align-content:start;gap:1rem}.shop-look__product{display:grid;grid-template-columns:110px 1fr;gap:1rem;padding-bottom:1rem;border-bottom:1px solid rgba(255,255,255,.18)}.shop-look__product-media{aspect-ratio:4/5;overflow:hidden;background:#4a3b3e}.shop-look__product-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease}.shop-look__product-media:hover img{transform:scale(1.03)}.shop-look__product-info{display:flex;justify-content:space-between;gap:1rem;align-items:center}.shop-look__product-info h3{font-size:.92rem;line-height:1.35;margin:0 0 .35rem;font-weight:500}.shop-look__product-info h3 a{color:#fff}.shop-look__product-info p{margin:0;color:rgba(255,255,255,.65);font-size:.85rem}.shop-look__arrow{width:40px;height:40px;border:1px solid rgba(255,255,255,.35);border-radius:50%;display:grid;place-items:center;flex:none}.shop-look__arrow:hover{background:#fff;color:var(--ink)}@media(max-width:749px){.shop-look__grid{grid-template-columns:1fr}.shop-look__image,.shop-look__placeholder{min-height:500px}.shop-look__products{grid-template-columns:1fr 1fr}.shop-look__product{display:block}.shop-look__product-info{padding-top:.6rem;align-items:flex-start}.shop-look__arrow{display:none}.shop-look__product-info h3{font-size:.78rem}.shop-look__product-info p{font-size:.75rem}}
{% endstylesheet %}
{% schema %}{"name":"Shop the look","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop the look"},{"type":"text","id":"heading","label":"Heading","default":"Styled together."},{"type":"textarea","id":"text","label":"Text","default":"Build the look from pieces you can wear your own way."},{"type":"image_picker","id":"image","label":"Editorial image"},{"type":"url","id":"link","label":"Section link"}],"blocks":[{"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"}]}],"presets":[{"name":"Shop the look","blocks":[{"type":"product"},{"type":"product"},{"type":"product"}]}]}{% endschema %}