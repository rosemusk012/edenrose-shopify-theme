<section class="cart">{% render 'breadcrumbs' %}<div class="page-width"><div class="cart-header"><div><p class="eyebrow">{{ 'templates.cart.eyebrow' | t }}</p><h1>{{ 'templates.cart.title' | t }}</h1></div>{% if cart.item_count > 0 %}<div class="cart-header-side"><span class="cart-count">{{ 'templates.cart.item_count' | t: count: cart.item_count }}</span><span class="cart-edit-note">{{ 'templates.cart.discount_note' | t }}</span></div>{% endif %}</div>{% if cart.item_count == 0 %}<div class="cart-empty"><p>{{ 'templates.cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'templates.cart.continue' | t }}</a></div>{% else %}{% form 'cart', cart %}<div class="cart-layout"><div class="cart-items">{% for item in cart.items %}<article class="cart-row" aria-label="{{ item.product.title | escape }}"><a class="cart-image" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,180,240', sizes: '(min-width: 750px) 110px, 82px', alt: item.image.alt | default: item.product.title }}{% endif %}</a><div class="cart-product"><a class="cart-title" href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<p class="cart-variant">{{ item.variant.title | escape }}</p>{% endunless %}<p class="cart-price">{{ item.final_price | money }}</p><div class="cart-controls"><label for="CartQty-{{ item.key }}">{{ 'templates.cart.quantity' | t }}</label><input id="CartQty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" inputmode="numeric" aria-label="{{ 'templates.cart.quantity_for' | t: product: item.product.title | escape }}"><a class="remove-link" href="{{ routes.cart_change_url }}?id={{ item.key | url_encode }}&quantity=0">{{ 'templates.cart.remove' | t }}</a></div></div><div class="cart-line-total"><span class="visually-hidden">{{ 'templates.cart.line_total' | t }}</span>{{ item.final_line_price | money }}</div></article>{% endfor %}</div><aside class="cart-summary" aria-label="{{ 'templates.cart.summary' | t }}"><div class="cart-promo" aria-label="{{ 'templates.cart.trust_label' | t }}"><strong>{{ 'templates.cart.trust_heading' | t }}</strong><span>{{ 'templates.cart.trust_text' | t }}</span></div><p class="eyebrow">{{ 'templates.cart.summary' | t }}</p><div class="summary-line"><span>{{ 'templates.cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><p class="summary-note">{{ 'templates.cart.shipping_note' | t }}</p><button class="button cart-checkout-button" type="submit" name="checkout">{{ 'templates.cart.checkout' | t }}</button><p class="cart-policy-note">{{ 'templates.cart.policy_note' | t }}</p><div class="cart-policy-links" aria-label="{{ 'templates.cart.policy_links_label' | t }}">{% if shop.refund_policy.url != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'templates.cart.returns_policy' | t }}</a>{% endif %}{% if shop.shipping_policy.url != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'templates.cart.shipping_policy' | t }}</a>{% endif %}</div><button class="button button--secondary" type="submit" name="update">{{ 'templates.cart.update' | t }}</button><a class="continue-link" href="{{ routes.all_products_collection_url }}">{{ 'templates.cart.continue_shopping' | t }}</a><a class="cart-category-link" href="{{ routes.collections_url }}">{{ 'templates.cart.browse_categories' | t }} →</a></aside></div>{% endform %}{% endif %}</div></section>
{% stylesheet %}.cart{padding-block:clamp(3rem,6vw,5.5rem) 4.5rem;background:linear-gradient(180deg,var(--paper) 0%,var(--blush) 100%);min-height:70vh}.cart-header{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:2.5rem}.cart-header-side{display:grid;justify-items:end;gap:.4rem}.cart-edit-note{font-size:.66rem;text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-weight:600}.cart-header h1{margin:.25rem 0 0;font-family:var(--display);font-size:clamp(3rem,7vw,5.5rem);line-height:.9;font-weight:400;letter-spacing:-.055em}.cart-count{color:var(--muted);font-size:.9rem}.cart-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:3rem;align-items:start}.cart-items{border-top:1px solid var(--line)}.cart-row{display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:1.25rem;padding:1.25rem 0;border-bottom:1px solid var(--line)}.cart-image{display:block;aspect-ratio:4/5;background:var(--soft);overflow:hidden;border-radius:10px;border:1px solid var(--line)}.cart-image img{width:100%;height:100%;object-fit:cover;display:block}.cart-product{display:grid;align-content:start;gap:.35rem}.cart-product a{color:inherit;text-decoration:none}.cart-title{line-height:1.25}.cart-variant,.cart-price{margin:0;color:var(--muted);font-size:.9rem}.cart-controls{display:flex;align-items:center;gap:.65rem;margin-top:.5rem}.cart-controls label{font-size:.8rem}.cart-controls input:focus-visible{outline:var(--focus);outline-offset:3px}.cart-controls input{width:68px;min-height:44px;padding:.55rem;border:1px solid var(--line);background:var(--paper);font:inherit;border-radius:999px;text-align:center}.cart-controls input:hover{border-color:var(--ink)}.remove-link{font-size:.8rem;text-decoration:underline!important}.cart-line-total{font-weight:700;white-space:nowrap}.cart-progress{display:grid;gap:.25rem;margin-bottom:1rem}.cart-progress strong{font-size:.82rem}.cart-progress span{font-size:.75rem;color:var(--muted);line-height:1.45}.cart-summary{position:sticky;top:6rem;padding:1.6rem;min-width:0;background:var(--soft);border:1px solid var(--line);border-radius:14px;box-shadow:0 12px 30px rgba(33,26,27,.04)}.cart-promo{display:grid;gap:.2rem;padding:.9rem 1rem;margin-bottom:1.2rem;background:var(--wine);color:#fff;border-radius:10px}.cart-promo strong{font-size:.78rem;letter-spacing:.12em}.cart-promo span{font-size:.72rem;opacity:.9}.cart-checkout-button{min-height:58px;border-radius:999px;font-size:1rem;font-weight:700;box-shadow:0 10px 24px rgba(84,42,53,.12)}.cart-checkout-button:focus-visible{outline:var(--focus);outline-offset:3px}.cart-summary .button:focus-visible{outline:var(--focus);outline-offset:3px}.continue-link:focus-visible,.remove-link:focus-visible,.cart-image:focus-visible,.cart-title:focus-visible{outline:var(--focus);outline-offset:3px}.cart-summary .eyebrow{margin:0 0 1rem}.summary-line{display:flex;justify-content:space-between;gap:1rem;padding-block:1rem;border-block:1px solid var(--line)}.summary-note{font-size:.8rem;color:var(--muted);line-height:1.5}.cart-summary .button{width:100%;margin-top:.65rem;border-radius:999px;min-height:48px}.cart-policy-note{margin:.8rem 0 .45rem;text-align:center;font-size:.74rem;color:var(--muted);line-height:1.45}.cart-policy-links{display:flex;justify-content:center;flex-wrap:wrap;gap:.9rem;margin-bottom:.25rem}.cart-policy-links a{font-size:.75rem;color:inherit;text-decoration:underline;text-underline-offset:3px}.cart-policy-links a:focus-visible{outline:var(--focus);outline-offset:3px}.continue-link{display:block;text-align:center;margin-top:1rem;color:inherit}.cart-category-link{display:block;text-align:center;margin-top:.65rem;font-size:.78rem;text-decoration:underline;text-underline-offset:3px}.cart-category-link:focus-visible,.continue-link:focus-visible{outline:var(--focus);outline-offset:3px}.cart-empty{padding:clamp(5rem,12vw,8rem) 0;text-align:center}.cart-empty:before{content:'✦ EDENROSE';display:block;font-size:.68rem;letter-spacing:.16em;margin-bottom:1rem;color:var(--accent)}.cart-empty p{color:var(--muted)}.cart-empty .button{display:inline-flex;margin-top:1rem;border-radius:999px}@media(max-width:749px){.cart{padding-block:1.75rem 3rem;overflow-x:clip}.cart-layout{display:block}.cart-row{grid-template-columns:82px minmax(0,1fr);gap:.9rem}.cart-line-total{grid-column:2;text-align:right}.cart-summary{position:static;margin-top:1.5rem}.cart-controls{flex-wrap:wrap}.cart-header{align-items:start}.cart-summary .cart-checkout-button{position:sticky;bottom:.75rem;z-index:3;box-shadow:0 10px 28px rgba(33,26,27,.16)}.cart-policy-links{gap:.7rem 1rem}.cart-summary{padding-bottom:1.25rem}}
{% endstylesheet %}{% schema %}{"name":"t:sections.main_cart.name"}{% endschema %}