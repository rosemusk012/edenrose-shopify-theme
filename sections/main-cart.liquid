<section class="cart"><div class="page-width"><h1>{{ 'templates.cart.title' | t }}</h1>{% if cart.item_count == 0 %}<p>{{ 'templates.cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'templates.cart.continue' | t }}</a>{% else %}{% form 'cart', cart %}{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}</a><div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a><p>{{ item.final_price | money }}</p></div><div><label for="CartQty-{{ item.key }}">{{ 'templates.cart.quantity' | t }}</label><input id="CartQty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div></div>{% endfor %}<div class="cart-summary"><p><strong>{{ 'templates.cart.subtotal' | t }}</strong> {{ cart.total_price | money }}</p><button class="button button--secondary" type="submit" name="update">{{ 'templates.cart.update' | t }}</button><button class="button" type="submit" name="checkout">{{ 'templates.cart.checkout' | t }}</button></div>{% endform %}{% endif %}</div></section>
{% schema %}{"name":"t:sections.main_cart.name"}{% endschema %}