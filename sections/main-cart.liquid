<section class="cart"><div class="page-width"><div class="cart-header"><div><p class="eyebrow">{{ 'templates.cart.eyebrow' | t }}</p><h1>{{ 'templates.cart.title' | t }}</h1></div>{% if cart.item_count > 0 %}<span class="cart-count">{{ 'templates.cart.item_count' | t: count: cart.item_count }}</span>{% endif %}</div>{% if cart.item_count == 0 %}<div class="cart-empty"><p>{{ 'templates.cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'templates.cart.continue' | t }}</a></div>{% else %}{% form 'cart', cart %}<div class="cart-layout"><div class="cart-items">{% for item in cart.items %}<article class="cart-row" aria-label="{{ item.product.title | escape }}"><a class="cart-image" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">{% if item.image %}{{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}{% endif %}</a><div class="cart-product"><a class="cart-title" href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<p class="cart-variant">{{ item.variant.title | escape }}</p>{% endunless %}<p class="cart-price">{{ item.final_price | money }}</p><div class="cart-controls"><label for="CartQty-{{ item.key }}">{{ 'templates.cart.quantity' | t }}</label><input id="CartQty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="{{ 'templates.cart.quantity' | t }}"><a class="remove-link" href="{{ routes.cart_change_url }}?id={{ item.key | url_encode }}&quantity=0">{{ 'templates.cart.remove' | t }}</a></div></div><div class="cart-line-total"><span class="sr-only">{{ 'templates.cart.line_total' | t }}</span>{{ item.final_line_price | money }}</div></article>{% endfor %}</div><aside class="cart-summary"><p class="eyebrow">{{ 'templates.cart.summary' | t }}</p><div class="summary-line"><span>{{ 'templates.cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><p class="summary-note">{{ 'templates.cart.shipping_note' | t }}</p><button class="button" type="submit" name="checkout">{{ 'templates.cart.checkout' | t }}</button><button class="button button--secondary" type="submit" name="update">{{ 'templates.cart.update' | t }}</button><a class="continue-link" href="{{ routes.all_products_collection_url }}">{{ 'templates.cart.continue_shopping' | t }}</a></aside></div>{% endform %}{% endif %}</div></section>
{% stylesheet %}.cart{padding-block:2.5rem 4rem}.cart-header{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:2rem}.cart-header h1{margin:.25rem 0 0}.cart-count{color:var(--muted);font-size:.9rem}.cart-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:3rem;align-items:start}.cart-items{border-top:1px solid var(--line)}.cart-row{display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:1.25rem;padding:1.25rem 0;border-bottom:1px solid var(--line)}.cart-image{display:block;aspect-ratio:4/5;background:var(--soft);overflow:hidden}.cart-image img{width:100%;height:100%;object-fit:cover;display:block}.cart-product{display:grid;align-content:start;gap:.35rem}.cart-product a{color:inherit;text-decoration:none}.cart-title{line-height:1.25}.cart-variant,.cart-price{margin:0;color:var(--muted);font-size:.9rem}.cart-controls{display:flex;align-items:center;gap:.65rem;margin-top:.5rem}.cart-controls label{font-size:.8rem}.cart-controls input:focus-visible{outline:var(--focus);outline-offset:3px}.cart-controls input{width:68px;min-height:44px;padding:.55rem;border:1px solid var(--line);background:var(--paper);font:inherit}.cart-controls input:hover{border-color:var(--ink)}.remove-link{font-size:.8rem;text-decoration:underline!important}.cart-line-total{font-weight:700}.cart-summary{position:sticky;top:6rem;padding:1.5rem;background:var(--soft);border:1px solid var(--line)}.cart-summary .button:first-of-type{min-height:52px}.cart-summary .button:focus-visible{outline:var(--focus);outline-offset:3px}.continue-link:focus-visible,.remove-link:focus-visible,.cart-image:focus-visible,.cart-title:focus-visible{outline:var(--focus);outline-offset:3px}.cart-summary .eyebrow{margin:0 0 1rem}.summary-line{display:flex;justify-content:space-between;gap:1rem;padding-block:1rem;border-block:1px solid var(--line)}.summary-note{font-size:.8rem;color:var(--muted);line-height:1.5}.cart-summary .button{width:100%;margin-top:.65rem}.continue-link{display:block;text-align:center;margin-top:1rem;color:inherit}.cart-empty{padding:clamp(4rem,10vw,7rem) 0;text-align:center}.cart-empty p{color:var(--muted)}.cart-empty .button{display:inline-flex;margin-top:1rem}@media(max-width:749px){.cart{padding-block:1.75rem 3rem}.cart-layout{display:block}.cart-row{grid-template-columns:82px minmax(0,1fr);gap:.9rem}.cart-line-total{grid-column:2}.cart-summary{position:static;margin-top:1.5rem}.cart-controls{flex-wrap:wrap}.cart-header{align-items:start}}
{% endstylesheet %}{% schema %}{"name":"t:sections.main_cart.name"}{% endschema %}