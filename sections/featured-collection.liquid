<section class="section featured-section"{% if section.settings.collection != blank and section.settings.collection.products_count == 0 %} hidden{% endif %}><div class="page-width"><div class="featured-kicker" aria-hidden="true"><span>EDENROSE</span><span>CURATED SELECTION</span></div><div class="section-head"><div><p class="eyebrow">{{ 'sections.featured_collection.eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p class="featured-subheading">{{ section.settings.subheading | escape }}</p>{% endif %}</div>{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }} <span aria-hidden="true">↗</span></a>{% endif %}</div>{% if section.settings.collection != blank %}<div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'card-product', product: product %}{% unless product.has_only_default_variant %}{% assign variant_cards = 0 %}{% assign seen_variant_images = '|' | append: product.featured_image.id | append: '|' %}{% for option in product.options_with_values %}{% assign option_name = option.name | downcase %}{% if option_name contains 'color' or option_name contains 'colour' %}{% for option_value in option.values %}{% assign variant = option_value.variant %}{% if variant and variant.featured_image and variant.available %}{% assign variant_image_key = '|' | append: variant.featured_image.id | append: '|' %}{% unless seen_variant_images contains variant_image_key %}{% if variant_cards < 2 %}{% render 'card-product', product: product, variant: variant, variant_label: option_value.name %}{% assign variant_cards = variant_cards | plus: 1 %}{% assign seen_variant_images = seen_variant_images | append: variant.featured_image.id | append: '|' %}{% endif %}{% endunless %}{% endif %}{% endfor %}{% endif %}{% endfor %}{% endunless %}{% endfor %}</div>{% else %}<p>{{ 'sections.featured_collection.choose_collection' | t }}</p>{% endif %}</div></section>
{% stylesheet %}
.featured-section[hidden]{display:none}.featured-kicker{display:flex;justify-content:space-between;gap:1rem;padding-bottom:1rem;border-bottom:1px solid var(--line);font-size:.6rem;letter-spacing:.16em;color:var(--muted)}.featured-kicker span:last-child{color:var(--accent)}.featured-section{padding-top:clamp(4rem,7vw,7rem);padding-bottom:clamp(4rem,7vw,7rem)}.featured-section .section-head{align-items:end;margin-bottom:2rem}.featured-section h2{font-size:clamp(2.3rem,5vw,4.5rem);line-height:.95;letter-spacing:-.045em;margin:.3rem 0 0}.featured-subheading{color:var(--muted);max-width:30rem;line-height:1.6;margin:.9rem 0 0}.text-link{white-space:nowrap;text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:.25rem}.text-link span{margin-left:.3rem;transition:transform .2s ease;display:inline-block}.text-link:hover span{transform:translate(.15rem,-.15rem)}
{% endstylesheet %}
{% schema %}{"name":"t:sections.featured_collection.name","settings":[{"type":"collection","id":"collection","label":"t:sections.featured_collection.settings.collection"},{"type":"text","id":"heading","label":"t:sections.featured_collection.settings.heading","default":"New arrivals"},{"type":"textarea","id":"subheading","label":"t:sections.featured_collection.settings.subheading","default":"A fresh edit of pieces to discover now."},{"type":"range","id":"products_to_show","label":"t:sections.featured_collection.settings.products_to_show","min":4,"max":12,"step":4,"default":8}],"presets":[{"name":"t:sections.featured_collection.name"}]}{% endschema %}