<section class="section"><div class="page-width"><div class="section-head"><div><p class="eyebrow">{{ 'sections.featured_collection.eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>{% endif %}</div>{% if section.settings.collection != blank %}<div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'card-product', product: product %}{% endfor %}</div>{% else %}<p>{{ 'sections.featured_collection.choose_collection' | t }}</p>{% endif %}</div></section>
{% schema %}{"name":"t:sections.featured_collection.name","settings":[{"type":"collection","id":"collection","label":"t:sections.featured_collection.settings.collection"},{"type":"text","id":"heading","label":"t:sections.featured_collection.settings.heading","default":"New arrivals"},{"type":"range","id":"products_to_show","label":"t:sections.featured_collection.settings.products_to_show","min":4,"max":12,"step":4,"default":8}],"presets":[{"name":"t:sections.featured_collection.name"}]}{% endschema %}