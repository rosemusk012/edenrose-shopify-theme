{% assign featured_collection = section.settings.collection %}
<section class="section featured-section"{% if featured_collection != blank and featured_collection.products_count == 0 %} hidden{% endif %}>
  <div class="page-width">
    <div class="featured-kicker"><span>EDENROSE</span><span>CURATED SELECTION</span></div>
    <div class="section-head">
      <div><p class="eyebrow">{{ 'sections.featured_collection.eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p class="featured-subheading">{{ section.settings.subheading | escape }}</p>{% endif %}</div>
      {% if featured_collection != blank %}<a class="text-link" href="{{ featured_collection.url }}">{{ 'general.view_all' | t }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    {% if featured_collection != blank %}
      <div class="product-carousel" data-carousel>
        <div class="product-carousel__track" data-carousel-track>
          {% for product in featured_collection.products limit: section.settings.products_to_show %}<div class="product-carousel__item">{% render 'card-product', product: product %}</div>{% endfor %}
        </div>
        <div class="carousel-controls" aria-label="Carousel controls"><button type="button" data-carousel-prev aria-label="Previous products">←</button><button type="button" data-carousel-next aria-label="Next products">→</button></div>
      </div>
    {% else %}<p>{{ 'sections.featured_collection.choose_collection' | t }}</p>{% endif %}
  </div>
</section>
{% stylesheet %}
.featured-section[hidden]{display:none}.featured-kicker{display:flex;justify-content:space-between;gap:1rem;padding-bottom:1rem;border-bottom:1px solid var(--line);font-size:.6rem;letter-spacing:.16em;color:var(--muted)}.featured-kicker span:last-child{color:var(--accent)}.featured-section{padding-top:clamp(3.5rem,6vw,6rem);padding-bottom:clamp(3.5rem,6vw,6rem)}.featured-section .section-head{align-items:end;margin-bottom:1.5rem}.featured-section h2{font-size:clamp(2.3rem,5vw,4.5rem);line-height:.95;letter-spacing:-.045em;margin:.3rem 0 0}.featured-subheading{color:var(--muted);max-width:30rem;line-height:1.6;margin:.9rem 0 0}.text-link{white-space:nowrap;text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:.25rem}.text-link span{margin-left:.3rem;transition:transform .2s ease;display:inline-block}.text-link:hover span{transform:translate(.15rem,-.15rem)}.product-carousel{position:relative}.product-carousel__track{display:flex;gap:clamp(.75rem,1.5vw,1.25rem);overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:0 .1rem .5rem}.product-carousel__track::-webkit-scrollbar{display:none}.product-carousel__item{flex:0 0 calc((100% - 3.75rem)/4);min-width:220px;scroll-snap-align:start}.carousel-controls{display:flex;justify-content:flex-end;gap:.5rem;margin-top:1rem}.carousel-controls button{width:44px;height:44px;border:1px solid var(--line);background:transparent;border-radius:50%;cursor:pointer;font-size:1rem}.carousel-controls button:hover{background:var(--ink);color:#fff;border-color:var(--ink)}@media(max-width:900px){.product-carousel__item{flex-basis:31vw;min-width:190px}}@media(max-width:749px){.product-carousel__item{flex-basis:72vw;min-width:0}.carousel-controls{display:none}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.featured_collection.name","settings":[{"type":"collection","id":"collection","label":"t:sections.featured_collection.settings.collection"},{"type":"text","id":"heading","label":"t:sections.featured_collection.settings.heading","default":"New arrivals"},{"type":"textarea","id":"subheading","label":"t:sections.featured_collection.settings.subheading","default":"A fresh edit of pieces to discover now."},{"type":"range","id":"products_to_show","label":"t:sections.featured_collection.settings.products_to_show","min":4,"max":12,"step":4,"default":8}],"presets":[{"name":"t:sections.featured_collection.name"}]}{% endschema %}