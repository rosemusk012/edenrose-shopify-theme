<section class="section featured-section"{% if section.settings.collection != blank and section.settings.collection.products_count == 0 %} hidden{% endif %}><div class="page-width"><div class="featured-kicker" aria-hidden="true"><span>EDENROSE</span><span>CURATED SELECTION</span></div><div class="section-head"><div><p class="eyebrow">{{ 'sections.featured_collection.eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p class="featured-subheading">{{ section.settings.subheading | escape }}</p>{% endif %}</div>{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }} <span aria-hidden="true">↗</span></a>{% endif %}</div>{% if section.settings.collection != blank %}<div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'card-product', product: product %}{% endfor %}</div>{% else %}<p>{{ 'sections.featured_collection.choose_collection' | t }}</p>{% endif %}</div></section>
{% stylesheet %}
.featured-section[hidden]{display:none}.featured-kicker{display:flex;justify-content:space-between;gap:1rem;padding-bottom:1rem;border-bottom:1px solid var(--line);font-size:.6rem;letter-spacing:.16em;color:var(--muted)}.featured-kicker span:last-child{color:var(--accent)}.featured-section{padding-top:clamp(4rem,7vw,7rem);padding-bottom:clamp(4rem,7vw,7rem)}.featured-section .section-head{align-items:end;margin-bottom:2rem;min-width:0}.featured-section .section-head>div{min-width:0}.featured-section h2{font-size:clamp(2.3rem,5vw,4.5rem);line-height:.95;letter-spacing:-.045em;margin:.3rem 0 0;max-width:10ch;overflow-wrap:anywhere}.featured-subheading{color:var(--muted);max-width:30rem;line-height:1.6;margin:.9rem 0 0}.text-link{white-space:nowrap;flex:0 0 auto;text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:.25rem}.text-link span{margin-left:.3rem;transition:transform .2s ease;display:inline-block}.text-link:hover span{transform:translate(.15rem,-.15rem)}
@media(max-width:560px){.featured-section{padding-top:3.5rem;padding-bottom:3.5rem}.featured-kicker{font-size:.54rem;gap:.5rem}.featured-section .section-head{align-items:flex-start;gap:1rem;margin-bottom:1.5rem}.featured-section h2{font-size:clamp(2.25rem,11vw,3.4rem);max-width:9ch}.featured-subheading{font-size:.92rem}.text-link{font-size:.8rem;padding-bottom:.2rem}.featured-section .product-grid{gap:.55rem}}\n{% endstylesheet %}
{% schema %}{"name":"t:sections.featured_collection.name","settings":[{"type":"collection","id":"collection","label":"t:sections.featured_collection.settings.collection"},{"type":"text","id":"heading","label":"t:sections.featured_collection.settings.heading","default":"New arrivals"},{"type":"textarea","id":"subheading","label":"t:sections.featured_collection.settings.subheading","default":"A fresh edit of pieces to discover now."},{"type":"range","id":"products_to_show","label":"t:sections.featured_collection.settings.products_to_show","min":4,"max":12,"step":4,"default":8}],"presets":[{"name":"t:sections.featured_collection.name"}]}{% endschema %}