<section class="collection-hero"><div class="page-width"><p class="eyebrow">{{ 'templates.collection.eyebrow' | t }}</p><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</div></section><section class="section"><div class="page-width"><div class="toolbar"><span>{{ collection.products_count }} {{ 'templates.collection.products' | t }}</span><form><label for="SortBy">{{ 'templates.collection.sort_by' | t }}</label> <select id="SortBy" name="sort_by" onchange="this.form.submit()"><option value="manual">{{ 'templates.collection.featured' | t }}</option><option value="price-ascending">{{ 'templates.collection.price_low' | t }}</option><option value="price-descending">{{ 'templates.collection.price_high' | t }}</option><option value="created-descending">{{ 'templates.collection.newest' | t }}</option></select></form></div>{% paginate collection.products by 24 %}<div class="product-grid">{% for product in collection.products %}{% render 'card-product', product: product %}{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div></section>
{% schema %}{"name":"t:sections.main_collection.name"}{% endschema %}