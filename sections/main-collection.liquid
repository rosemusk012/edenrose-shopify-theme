<section class="collection-page">
  <div class="collection-hero page-width">
    <p class="eyebrow">{{ 'templates.collection.eyebrow' | t }}</p>
    <div class="collection-title-row"><div><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="collection-description">{{ collection.description }}</div>{% endif %}</div><span class="collection-mark" aria-hidden="true">E</span></div>
  </div>
  <div class="section page-width">
    {% paginate collection.products by 24 %}
      <div class="collection-toolbar">
        <div class="collection-count"><strong>{{ collection.products_count }}</strong> {{ 'templates.collection.products' | t }}</div>{% if collection.filters.size > 0 %}<a class="filter-clear-top" href="{{ collection.url }}">Clear filters</a>{% endif %}
        <div class="collection-actions">
          <button type="button" class="filter-toggle" aria-expanded="false" aria-controls="CollectionFilters">Filter <span aria-hidden="true">+</span></button>
          <form class="sort-form">
            <label for="SortBy">{{ 'templates.collection.sort_by' | t }}</label>
            <select id="SortBy" name="sort_by" onchange="this.form.submit()">
              <option value="manual">{{ 'templates.collection.featured' | t }}</option><option value="price-ascending">{{ 'templates.collection.price_low' | t }}</option><option value="price-descending">{{ 'templates.collection.price_high' | t }}</option><option value="created-descending">{{ 'templates.collection.newest' | t }}</option>
            </select>
          </form>
        </div>
      </div>
      <div class="collection-layout">
        <aside id="CollectionFilters" class="collection-filters" aria-label="Product filters">
          <div class="filter-heading"><strong>Refine</strong><button type="button" class="filter-close" aria-label="Close filters">×</button></div>
          {% for filter in collection.filters %}
            <details class="filter-group" {% if filter.active_values.size > 0 %}open{% endif %}>
              <summary>{{ filter.label }} <span aria-hidden="true">+</span></summary>
              <div class="filter-options">
                {% if filter.type == 'price_range' %}
                  <label>Min <input type="number" name="{{ filter.min_value.param_name }}" placeholder="0" min="0" form="CollectionFilterForm"></label>
                  <label>Max <input type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ cart.currency.iso_code }}" min="0" form="CollectionFilterForm"></label>
                {% else %}
                  {% for value in filter.values %}<label class="filter-value"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} form="CollectionFilterForm"><span>{{ value.label }}</span><small>{{ value.count }}</small></label>{% endfor %}
                {% endif %}
              </div>
            </details>
          {% endfor %}
          <button type="submit" class="button filter-apply" form="CollectionFilterForm">Apply filters</button><a class="filter-clear" href="{{ collection.url }}">Clear all filters</a>
        </aside>
        <form id="CollectionFilterForm" class="filter-form" method="get">
          <div class="product-grid">
            {% for product in collection.products %}{% render 'card-product', product: product %}{% else %}<p>No products found. Try removing a filter.</p>{% endfor %}
          </div>
        </form>
      </div>
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {% endpaginate %}
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded',function(){var p=document.querySelector('.collection-page');if(!p)return;var t=p.querySelector('.filter-toggle'),panel=p.querySelector('.collection-filters'),c=p.querySelector('.filter-close');if(t&&panel){t.addEventListener('click',function(){panel.classList.add('is-open');t.setAttribute('aria-expanded','true');document.body.classList.add('filters-open')})}if(c)c.addEventListener('click',function(){panel.classList.remove('is-open');t.setAttribute('aria-expanded','false');document.body.classList.remove('filters-open')})});
</script>
{% stylesheet %}
.collection-page{background:var(--paper)}.collection-hero{padding:clamp(3.5rem,7vw,6.5rem) 24px 3rem;border-bottom:1px solid var(--line)}.collection-title-row{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem}.collection-hero h1{font-size:clamp(3rem,7vw,6.5rem);line-height:.9;letter-spacing:-.055em;margin:0;max-width:10ch}.collection-description{max-width:650px;margin:1.25rem 0 0;color:var(--muted);line-height:1.65}.collection-mark{font:normal clamp(5rem,12vw,11rem)/.7 Georgia,serif;color:var(--line);user-select:none}.collection-toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-block:1px solid var(--line);padding:1rem 0;margin-bottom:1.5rem}.collection-actions{display:flex;align-items:center;gap:1rem}.sort-form{display:flex;align-items:center;gap:.5rem}.sort-form select{padding:.65rem 2rem .65rem .75rem;border:1px solid var(--line);background:var(--paper)}.filter-toggle{display:none}.collection-layout{display:grid;grid-template-columns:220px 1fr;gap:2rem}.collection-filters{position:sticky;top:90px;align-self:start}.filter-heading{display:flex;justify-content:space-between;padding-bottom:1rem;border-bottom:1px solid var(--line)}.filter-close{display:none;border:0;background:none;font-size:1.5rem}.filter-group{border-bottom:1px solid var(--line);padding:.9rem 0}.filter-group summary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between}.filter-group summary::-webkit-details-marker{display:none}.filter-group summary span{color:var(--muted);font-weight:400}.filter-options{padding-top:.8rem;display:grid;gap:.55rem}.filter-value{display:grid;grid-template-columns:auto 1fr auto;gap:.5rem;align-items:center;font-size:.9rem}.filter-value small{color:var(--muted)}.filter-options input[type=number]{width:100%;padding:.55rem;border:1px solid var(--line);background:var(--paper)}.filter-apply{margin-top:1rem;width:100%}.filter-clear{display:block;text-align:center;margin-top:.65rem;font-size:.82rem;text-decoration:underline;text-underline-offset:3px}.filter-clear-top{font-size:.82rem;text-decoration:underline;text-underline-offset:3px;margin-left:.75rem}.filter-form{min-width:0}.pagination{padding-bottom:2rem}
@media(max-width:749px){.collection-hero{padding:3.5rem 16px 2.5rem}.collection-title-row{align-items:flex-start}.collection-mark{font-size:5rem}.collection-toolbar{align-items:stretch;flex-direction:column}.collection-actions{justify-content:space-between}.filter-toggle{display:inline-flex;align-items:center;justify-content:space-between;gap:1rem;padding:.65rem 1rem;border:1px solid var(--ink);background:var(--ink);color:var(--paper);font:inherit}.sort-form{justify-content:flex-end}.sort-form select{max-width:180px}.collection-layout{display:block}.collection-filters{position:fixed;z-index:50;inset:0 auto 0 0;width:min(88vw,360px);padding:1.25rem;background:var(--paper);box-shadow:0 0 40px #0002;transform:translateX(-105%);transition:transform .2s ease;overflow:auto}.collection-filters.is-open{transform:translateX(0)}.filter-close{display:block}.filters-open:after{content:"";position:fixed;z-index:40;inset:0;background:#0008}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.main_collection.name"}{% endschema %}