</script>

{% stylesheet %}
.collection-page{background:var(--paper);overflow:visible}
.collection-hero{padding:clamp(4rem,8vw,7rem) 24px 3.5rem;border-bottom:1px solid var(--line);background:linear-gradient(180deg,var(--paper) 0%,#f7efeb 100%)}
.collection-title-row{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;min-height:clamp(220px,28vw,360px)}
.collection-eyebrow-line{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem}
.collection-eyebrow-line span{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;padding:.35rem .5rem;border:1px solid var(--line)}
.collection-eyebrow-line span:first-child{background:var(--wine);color:#fff;border-color:var(--wine)}
.collection-hero h1{font-size:clamp(3.2rem,8vw,7rem);line-height:.88;letter-spacing:-.06em;margin:0;max-width:9ch}
.collection-description{max-width:650px;margin:1.25rem 0 0;color:var(--muted);line-height:1.65}
.collection-mark{font:normal clamp(6rem,15vw,13rem)/.7 Georgia,serif;color:var(--line);user-select:none;transform:translateY(.08em)}
.collection-discovery{padding-top:1rem}.collection-discovery-track{display:flex;gap:.55rem;overflow-x:auto;scrollbar-width:none;padding:.2rem 0 .8rem}.collection-discovery-track::-webkit-scrollbar{display:none}.collection-discovery-chip{flex:0 0 auto;padding:.55rem .85rem;border:1px solid var(--line);border-radius:999px;background:var(--soft);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap}.collection-discovery-chip:hover{background:var(--ink);color:var(--paper);text-decoration:none}.collection-discovery-chip:focus-visible{outline:var(--focus);outline-offset:3px}.collection-toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-block:1px solid var(--line);padding:1rem 0;margin-bottom:1.5rem}
.collection-toolbar:before{content:'{{ 'templates.collection.curated_for_you' | t }}';font-size:.62rem;letter-spacing:.12em;color:var(--muted);text-transform:uppercase}
.collection-view-label{font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.collection-view-controls{display:flex;align-items:center;gap:3px;border:1px solid var(--line);border-radius:999px;padding:3px}
.collection-view-btn{border:0;background:transparent;color:var(--muted);min-width:34px;min-height:34px;border-radius:999px;cursor:pointer;font-size:.65rem;letter-spacing:.08em}
.collection-view-btn.is-active{background:var(--ink);color:var(--paper)}
.collection-results .product-grid[data-columns="2"]{grid-template-columns:repeat(2,minmax(0,1fr))}
.collection-results .product-grid[data-columns="3"]{grid-template-columns:repeat(3,minmax(0,1fr))}
.applied-filters{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin:-.45rem 0 1.2rem}
.applied-filters-label{font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-right:.15rem}
.filter-chip{display:inline-flex;align-items:center;gap:.35rem;padding:.45rem .7rem;border:1px solid var(--line);border-radius:999px;background:var(--soft);font-size:.75rem}
.filter-chip:hover{background:var(--ink);color:var(--paper);text-decoration:none}
.filter-chip--clear{background:transparent;text-decoration:underline;text-underline-offset:3px}
.collection-actions{display:flex;align-items:center;gap:.7rem;margin-left:auto}
.collection-toolbar > .collection-view-controls{order:1}
.sort-form{display:flex;align-items:center;gap:.5rem}
.sort-form select{padding:.65rem 2rem .65rem .75rem;border:1px solid var(--line);background:var(--paper);border-radius:999px;min-height:44px}
.filter-toggle{display:inline-flex;min-height:44px;padding-inline:1rem}
.collection-layout{display:block}
.filter-panel{display:none}
.filter-panel.is-open{display:block;max-width:340px;margin:0 0 1.5rem;padding:1.1rem 1.2rem;border:1px solid var(--line);background:var(--paper)}
.filter-heading{display:flex;justify-content:space-between;padding-bottom:1rem;border-bottom:1px solid var(--line)}
.filter-close{display:block;border:0;background:none;font-size:1.5rem;line-height:1;cursor:pointer;min-width:40px;min-height:40px}
.filter-group{border-bottom:1px solid var(--line);padding:.9rem 0}
.filter-group summary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between}
.filter-group summary::-webkit-details-marker{display:none}
.filter-options{padding-top:.8rem;display:grid;gap:.55rem}
.filter-value{display:grid;grid-template-columns:auto 1fr auto;gap:.5rem;align-items:center;font-size:.9rem}
.filter-value input{accent-color:var(--ink)}
.filter-value small{color:var(--muted)}
.price-fields{display:grid;gap:.6rem}
.price-fields label{display:grid;gap:.25rem;font-size:.75rem;color:var(--muted)}
.price-fields input{width:100%;padding:.55rem;border:1px solid var(--line);background:var(--paper)}
.filter-apply{width:100%;margin-top:1rem;min-height:44px}
.filter-clear{display:block;text-align:center;margin-top:.65rem;font-size:.82rem;text-decoration:underline;text-underline-offset:3px}
.collection-results{min-width:0}
.collection-results .product-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:1.15rem}
.collection-empty{grid-column:1/-1;text-align:center;padding:clamp(3rem,7vw,5rem) 1rem;border:1px solid var(--line);background:#f7efeb}
.collection-empty p{color:var(--muted);margin:0 0 1rem}
.collection-empty .button{display:inline-flex}
.collection-load-sentinel{display:flex;align-items:center;justify-content:center;gap:.7rem;min-height:72px;color:var(--muted);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase}
.collection-load-spinner{width:16px;height:16px;border:1px solid var(--line);border-top-color:var(--ink);border-radius:50%;animation:edenrose-spin .8s linear infinite}
.collection-load-sentinel:not(.is-loading){opacity:.7}
@keyframes edenrose-spin{to{transform:rotate(360deg)}}
.pagination{padding:1rem 0 3rem;display:flex;justify-content:center;flex-wrap:wrap;gap:6px}
.pagination a,.pagination span{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:.4rem .7rem;border:1px solid var(--line);border-radius:999px}
.pagination .current{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.pagination a:hover{background:var(--soft);text-decoration:none}
@media(min-width:750px){.collection-toolbar > .collection-view-controls{display:flex}}
@media(max-width:749px){
  .collection-toolbar:before{display:none}
  .collection-toolbar{position:sticky;top:68px;z-index:20;background:var(--paper);box-shadow:0 1px 0 var(--line);padding-block:.75rem;margin-bottom:1rem;align-items:center}
  .collection-toolbar,.collection-actions{min-width:0}
  .collection-count{white-space:nowrap}
  .collection-actions{flex:1;justify-content:flex-end}
  .filter-toggle{flex:0 0 auto;min-width:92px}
  .sort-form{min-width:0;justify-content:flex-end}
  .sort-form select{width:100%;min-width:0;max-width:180px}
  .collection-hero{padding:3.5rem 16px 2.5rem}
  .collection-title-row{align-items:flex-start;min-height:190px}
  .collection-mark{font-size:5rem;transform:translateY(.1em)}
  .collection-layout{display:block}
  .collection-filters-open{overflow:hidden}
  .filter-panel.is-open{position:fixed;inset:0 0 0 auto;width:min(88vw,380px);max-width:none;height:100dvh;z-index:100;padding:1.25rem;overflow:auto;margin:0;border:0;box-shadow:-12px 0 30px rgba(23,20,17,.12)}
  .collection-filter-overlay{display:none}.collection-filter-overlay.is-open{display:block;position:fixed;inset:0;z-index:90;background:rgba(23,20,17,.18)}
  .collection-results .product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}
  .collection-count{font-size:.9rem}
}
@media(max-width:480px){
  .collection-actions{gap:.5rem}
  .sort-form label{display:none}
  .sort-form select{max-width:150px}
  .collection-hero h1{font-size:clamp(3rem,15vw,5rem)}
  .collection-description{font-size:.92rem}
}
 .collection-continue-shopping{padding:4rem 0 5rem}.collection-continue-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1rem}.collection-continue-heading h2{margin:0;font-size:clamp(1.7rem,3vw,2.7rem);letter-spacing:-.03em}.collection-discovery-rail{display:flex;gap:1rem;overflow-x:auto;scroll-snap-type:x proximity;padding:.25rem .1rem 1rem;scrollbar-width:none}.collection-discovery-rail::-webkit-scrollbar{display:none}.collection-discovery-card{flex:0 0 clamp(180px,18vw,250px);scroll-snap-align:start;color:inherit;text-decoration:none}.collection-discovery-card img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:10px;margin-bottom:.65rem;transition:transform .25s ease}.collection-discovery-card:hover img{transform:scale(1.02)}.collection-discovery-card span{font-size:.85rem;font-weight:600}@media(max-width:749px){.collection-continue-shopping{padding:2.8rem 0 3.5rem}.collection-continue-heading{display:block}.collection-continue-heading h2{font-size:1.7rem}.collection-discovery-card{flex-basis:42vw}}{% endstylesheet %}
{% schema %}{"name":"t:sections.main_collection.name"}{% endschema %}