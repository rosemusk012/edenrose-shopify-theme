{% render 'breadcrumbs' %}
<section class="collection-page">
  <div class="collection-hero page-width">
    <p class="eyebrow">{{ 'templates.collection.eyebrow' | t }}</p>
    <div class="collection-title-row">
      <div>
        <div class="collection-eyebrow-line"><span>THE EDENROSE EDIT</span>{% if collection.products_count > 0 %}<span>{{ collection.products_count }} {{ 'templates.collection.pieces' | t }}</span>{% endif %}</div>
        <h1>{{ collection.title | escape }}</h1>
        {% if collection.description != blank %}<div class="collection-description">{{ collection.description }}</div>{% endif %}
      </div>
      <span class="collection-mark" aria-hidden="true">E</span>
    </div>
  </div>

  <div class="section page-width">
    {% paginate collection.products by 24 %}
      <form id="CollectionFilterForm" class="collection-form" method="get" action="{{ collection.url }}">
        <div class="collection-toolbar">
          <span class="collection-curated">{{ 'templates.collection.curated_for_you' | t }}</span>
          <div class="collection-count"><strong>{{ collection.products_count }}</strong> <span>{{ 'templates.collection.products' | t }}</span></div>
          <div class="collection-actions">
            <button type="button" class="filter-toggle button button--secondary" aria-expanded="false" aria-controls="CollectionFilters">{{ 'templates.collection.filter' | t }}</button>
            <div class="sort-form">
              <label for="SortBy">{{ 'templates.collection.sort_by' | t }}</label>
              <select id="SortBy" name="sort_by" onchange="this.form.submit()">
                <option value="manual" {% if collection.sort_by == 'manual' or collection.sort_by == blank %}selected{% endif %}>{{ 'templates.collection.featured' | t }}</option>
                <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>{{ 'templates.collection.price_low' | t }}</option>
                <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>{{ 'templates.collection.price_high' | t }}</option>
                <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>{{ 'templates.collection.newest' | t }}</option>
              </select>
            </div>
          </div>
        </div>

        <div class="collection-layout">
          <aside id="CollectionFilters" class="filter-panel" aria-label="{{ 'templates.collection.filter' | t }}" aria-hidden="true">
              <div class="filter-heading"><strong>{{ 'templates.collection.filter' | t }}</strong><button type="button" class="filter-close" aria-label="{{ 'templates.collection.close_filters' | t }}">×</button></div>
              {% render 'collection-filter-links' %}
              {% for filter in collection.filters %}
                <details class="filter-group" {% if filter.active_values.size > 0 %}open{% endif %}>
                  <summary><span>{{ filter.label }}</span><span aria-hidden="true">+</span></summary>
                  <div class="filter-options">
                    {% case filter.type %}
                      {% when 'list' %}
                        {% for value in filter.values %}
                          <label class="filter-value">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                            <span>{{ value.label | escape }}</span><small>{{ value.count }}</small>
                          </label>
                        {% endfor %}
                      {% when 'price_range' %}
                        <div class="price-fields">
                          <label>{{ 'templates.collection.min' | t }} <input type="number" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="{{ 0 | money_without_currency }}" min="0" step="any" inputmode="decimal"></label>
                          <label>{{ 'templates.collection.max' | t }} <input type="number" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" min="0" step="any" inputmode="decimal"></label>
                        </div>
                    {% endcase %}
                  </div>
                </details>
              {% endfor %}
              {% if collection.filters.size > 0 %}
                <button type="submit" class="button filter-apply">{{ 'templates.collection.apply_filters' | t }}</button>
                <a class="filter-clear" href="{{ collection.url }}">{{ 'templates.collection.clear_filters' | t }}</a>
              {% endif %}
            </aside>

          <div class="collection-results">
            <h2 class="visually-hidden">{{ 'templates.collection.products_heading' | t }}</h2>
            <div class="product-grid">
              {% for product in collection.products %}
                {% render 'card-product', product: product %}
              {% else %}
                <div class="collection-empty">
                  <p>{{ 'templates.collection.no_products' | t }}</p>
                  <a class="button button--secondary" href="{{ collection.url }}">{{ 'templates.collection.clear_filters' | t }}</a>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </form>

      <div class="pagination">{{ paginate | default_pagination }}</div>
    {% endpaginate %}
  </div>
</section>

<script>
(function(){
  var toggle=document.querySelector('.filter-toggle');
  var panel=document.getElementById('CollectionFilters');
  if(!toggle||!panel)return;
  var close=panel.querySelector('.filter-close');
  toggle.setAttribute('aria-controls','CollectionFilters');
  var overlay=document.createElement('div');
  overlay.className='collection-filter-overlay';
  overlay.setAttribute('aria-hidden','true');
  document.body.appendChild(overlay);
  panel.setAttribute('aria-hidden','true');
  function setOpen(open){
    panel.classList.toggle('is-open',open);
    overlay.classList.toggle('is-open',open);
    toggle.setAttribute('aria-expanded',open?'true':'false');
    document.body.classList.toggle('collection-filters-open',open);
    panel.setAttribute('aria-hidden',open?'false':'true');
    overlay.setAttribute('aria-hidden',open?'false':'true');
  }
  var previousFocus=null;
  function openWithFocus(){previousFocus=document.activeElement;setOpen(true);if(close)close.focus();}
  function closeWithFocus(){setOpen(false);if(previousFocus&&previousFocus.focus)previousFocus.focus();}
  toggle.addEventListener('click',function(){if(panel.classList.contains('is-open'))closeWithFocus();else openWithFocus();});
  if(close)close.addEventListener('click',closeWithFocus);
  overlay.addEventListener('click',closeWithFocus);
  function onKeydown(e){if(e.key==='Escape'&&panel.classList.contains('is-open'))closeWithFocus();}
  document.addEventListener('keydown',onKeydown);
})();
</script>

{% stylesheet %}
.collection-page{background:var(--paper);overflow:visible}
.collection-hero{padding:clamp(2.75rem,6vw,5rem) 24px clamp(2rem,4vw,3rem);border-bottom:1px solid var(--line);background:linear-gradient(180deg,var(--paper) 0%,var(--blush) 100%)}
.collection-title-row{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;min-height:clamp(220px,28vw,360px)}
.collection-eyebrow-line{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem}
.collection-eyebrow-line span{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;padding:.35rem .5rem;border:1px solid var(--line)}
.collection-eyebrow-line span:first-child{background:var(--wine);color:#fff;border-color:var(--wine)}
.collection-hero h1{font-family:var(--display);font-weight:400;font-size:clamp(3.2rem,8vw,7rem);line-height:.9;letter-spacing:-.04em;margin:0;max-width:9ch}
.collection-description{max-width:650px;margin:1.25rem 0 0;color:var(--muted);line-height:1.65}
.collection-mark{font:normal clamp(6rem,15vw,13rem)/.7 var(--display);color:var(--line);user-select:none;transform:translateY(.08em)}
.collection-toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-block:1px solid var(--line);padding:1rem 0;margin-bottom:1.5rem}
.collection-curated{font-size:.62rem;letter-spacing:.12em;color:var(--muted);text-transform:uppercase}
.collection-actions{display:flex;align-items:center;gap:.7rem;margin-left:auto}
.sort-form{display:flex;align-items:center;gap:.5rem}
.sort-form select{padding:.65rem 2rem .65rem .75rem;border:1px solid var(--line);background:var(--paper);border-radius:999px;min-height:44px}
.filter-toggle{display:inline-flex;min-height:44px;padding-inline:1rem}
.collection-layout{display:block}
.filter-panel{display:none}
.filter-panel.is-open{display:block;max-width:340px;margin:0 0 1.5rem;padding:1.1rem 1.2rem;border:1px solid var(--line);background:var(--paper)}
.filter-heading{display:flex;justify-content:space-between;padding-bottom:1rem;border-bottom:1px solid var(--line)}
.filter-close{display:block;border:0;background:none;font-size:1.5rem;line-height:1;cursor:pointer;min-width:40px;min-height:40px}
.filter-group{border-bottom:1px solid var(--line);padding:.9rem 0}
.filter-group summary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between}
.filter-group summary::-webkit-details-marker{display:none}
.filter-options{padding-top:.8rem;display:grid;gap:.55rem}
.filter-value{display:grid;grid-template-columns:auto 1fr auto;gap:.5rem;align-items:center;font-size:.9rem}
.filter-value input{accent-color:var(--ink)}
.filter-value small{color:var(--muted)}
.price-fields{display:grid;gap:.6rem}
.price-fields label{display:grid;gap:.25rem;font-size:.75rem;color:var(--muted)}
.price-fields input{width:100%;padding:.55rem;border:1px solid var(--line);background:var(--paper)}
.filter-apply{width:100%;margin-top:1rem;min-height:44px}
.filter-clear{display:block;text-align:center;margin-top:.65rem;font-size:.82rem;text-decoration:underline;text-underline-offset:3px}
.collection-results{min-width:0}
.collection-results .product-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:1.15rem}
.collection-empty{grid-column:1/-1;text-align:center;padding:clamp(3rem,7vw,5rem) 1rem;border:1px solid var(--line);background:var(--blush)}
.collection-empty p{color:var(--muted);margin:0 0 1rem}
.collection-empty .button{display:inline-flex}




@media(max-width:749px){
  .collection-curated{display:none}
  .collection-toolbar{position:sticky;top:68px;z-index:20;background:var(--paper);box-shadow:0 1px 0 var(--line);padding-block:.75rem;margin-bottom:1rem;align-items:center}
  .collection-toolbar,.collection-actions{min-width:0}
  .collection-count{white-space:nowrap}
  .collection-actions{flex:1;justify-content:flex-end}
  .filter-toggle{flex:0 0 auto;min-width:92px}
  .sort-form{min-width:0;justify-content:flex-end}
  .sort-form select{width:100%;min-width:0;max-width:180px}
  .collection-hero{padding:2rem 16px 1.75rem}
  .collection-title-row{align-items:flex-start;min-height:190px}
  .collection-mark{font-size:5rem;transform:translateY(.1em)}
  .collection-layout{display:block}
  .collection-filters-open{overflow:hidden}
  .filter-panel.is-open{position:fixed;inset:0 0 0 auto;width:min(88vw,380px);max-width:none;height:100dvh;z-index:100002;padding:1.25rem;overflow:auto;margin:0;border:0;box-shadow:-12px 0 30px rgba(23,20,17,.12)}
  .collection-filter-overlay{display:none}.collection-filter-overlay.is-open{display:block;position:fixed;inset:0;z-index:100001;background:rgba(23,20,17,.18)}
  .collection-results .product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}
  .collection-count{font-size:.9rem}
}
@media(max-width:480px){
  .collection-actions{gap:.5rem}
  .sort-form label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
  .sort-form select{max-width:150px}
  .collection-hero h1{font-size:clamp(2.6rem,12vw,4rem)}
  .collection-description{font-size:.92rem}
}
{% endstylesheet %}
{% schema %}{"name":"t:sections.main_collection.name"}{% endschema %}