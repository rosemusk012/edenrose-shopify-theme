{% render 'breadcrumbs' %}
<section class="collection-page">
  <div class="collection-hero page-width">
    <p class="eyebrow">{{ 'templates.collection.eyebrow' | t }}</p>
    <div class="collection-title-row">
      <div>
        <div class="collection-eyebrow-line"><span>THE EDENROSE EDIT</span>{% if collection.products_count > 0 %}<span>{{ collection.products_count }} {{ 'templates.collection.pieces' | t }}</span>{% endif %}</div>
        <h1>{{ collection.title | escape }}</h1>
        {% if collection.description != blank %}<div class="collection-description">{{ collection.description }}</div>{% endif %}
      </div>
      <span class="collection-mark" aria-hidden="true">E</span>
    </div>
  </div>

  {% assign related_collection_handles = 'new-arrivals-1,jewelry,dresses,womens-tops,bottoms-sets,shoes,men,swimwear' | split: ',' %}
  {% unless collection.handle == 'new-arrivals-1' %}
    <nav class="collection-discovery page-width" aria-label="Shop more categories">
      <div class="collection-discovery-track">
        {% for handle in related_collection_handles %}
          {% assign related = collections[handle] %}
          {% if related != blank and related.handle != collection.handle %}
            <a class="collection-discovery-chip" href="{{ related.url }}">{{ related.title | escape }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </nav>
  {% endunless %}
  <div class="section page-width">
    {% paginate collection.products by 24 %}
      <form id="CollectionFilterForm" class="collection-form" method="get" action="{{ collection.url }}">
        <div class="collection-toolbar" data-collection-toolbar>
          <div class="collection-view-controls" aria-label="Product view">
            <span class="collection-view-label">View</span>
            <button type="button" class="collection-view-btn is-active" data-grid-view="2" aria-pressed="true" aria-label="Two columns">2</button>
            <button type="button" class="collection-view-btn" data-grid-view="3" aria-pressed="false" aria-label="Three columns">3</button>
          </div>
          <div class="collection-count"><strong data-product-count>{{ collection.products_count }}</strong> <span>{{ 'templates.collection.products' | t }}</span></div>
          <div class="collection-actions">
            <button type="button" class="filter-toggle button button--secondary" aria-expanded="false" aria-controls="CollectionFilters">{{ 'templates.collection.filter' | t }}</button>
            <div class="sort-form">
              <label for="SortBy">{{ 'templates.collection.sort_by' | t }}</label>
              <select id="SortBy" name="sort_by" onchange="this.form.submit()">
                <option value="manual" {% if collection.sort_by == 'manual' or collection.sort_by == blank %}selected{% endif %}>{{ 'templates.collection.featured' | t }}</option>
                <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>{{ 'templates.collection.price_low' | t }}</option>
                <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>{{ 'templates.collection.price_high' | t }}</option>
                <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>{{ 'templates.collection.newest' | t }}</option>
              </select>
            </div>
          </div>
        </div>

        {% assign active_filter_count = 0 %}
        {% for filter in collection.filters %}{% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}{% endfor %}
        {% if active_filter_count > 0 %}
          <div class="applied-filters" aria-label="Applied filters">
            <span class="applied-filters-label">{{ active_filter_count }} selected</span>
            {% for filter in collection.filters %}{% for value in filter.active_values %}
              <a class="filter-chip" href="{{ value.url_to_remove }}">{{ value.label | escape }} <span aria-hidden="true">×</span></a>
            {% endfor %}{% endfor %}
            <a class="filter-chip filter-chip--clear" href="{{ collection.url }}">Clear all</a>
          </div>
        {% endif %}
        <div class="collection-layout">
          <aside id="CollectionFilters" class="filter-panel" aria-label="{{ 'templates.collection.filter' | t }}" aria-hidden="true">
              <div class="filter-heading"><strong>{{ 'templates.collection.filter' | t }}</strong><button type="button" class="filter-close" aria-label="{{ 'templates.collection.close_filters' | t }}">×</button></div>
              {% render 'collection-filter-links' %}
              {% for filter in collection.filters %}
                <details class="filter-group" {% if filter.active_values.size > 0 %}open{% endif %}>
                  <summary><span>{{ filter.label }}</span><span aria-hidden="true">+</span></summary>
                  <div class="filter-options">
                    {% case filter.type %}
                      {% when 'list' %}
                        {% for value in filter.values %}
                          <label class="filter-value">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                            <span>{{ value.label | escape }}</span><small>{{ value.count }}</small>
                          </label>
                        {% endfor %}
                      {% when 'price_range' %}
                        <div class="price-fields">
                          <label>{{ 'templates.collection.min' | t }} <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | default: '' }}" min="0" inputmode="decimal"></label>
                          <label>{{ 'templates.collection.max' | t }} <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | default: '' }}" min="0" inputmode="decimal"></label>
                        </div>
                    {% endcase %}
                  </div>
                </details>
              {% endfor %}
              {% if collection.filters.size > 0 %}
                <button type="submit" class="button filter-apply">{{ 'templates.collection.apply_filters' | t }}</button>
                <a class="filter-clear" href="{{ collection.url }}">{{ 'templates.collection.clear_filters' | t }}</a>
              {% endif %}
            </aside>

          <div class="collection-results" data-collection-results>
            <div class="product-grid" data-product-grid data-columns="3">
              {% for product in collection.products %}
                {% render 'card-product', product: product %}
              {% else %}
                <div class="collection-empty">
                  <p>{{ 'templates.collection.no_products' | t }}</p>
                  <a class="button button--secondary" href="{{ collection.url }}">{{ 'templates.collection.clear_filters' | t }}</a>
                </div>
              {% endfor %}
            </div>
            <div class="collection-continue-shopping">
              <div class="collection-continue-heading">
                <p class="eyebrow">KEEP EXPLORING</p>
                <h2>More EdenRose to discover</h2>
              </div>
              <div class="collection-discovery-rail" aria-label="Explore more EdenRose collections">
                {% assign discovery_handles = 'new-arrivals-1,jewelry,dresses,womens-tops,bottoms-sets,shoes,men,swimwear' | split: ',' %}
                {% for handle in discovery_handles %}
                  {% assign discovery_collection = collections[handle] %}
                  {% if discovery_collection and discovery_collection.handle != collection.handle %}
                    <a class="collection-discovery-card" href="{{ discovery_collection.url }}">
                      {% if discovery_collection.featured_image %}
                        {{ discovery_collection.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,400,500', sizes: '(min-width: 750px) 18vw, 42vw', alt: discovery_collection.title | escape }}
                      {% endif %}
                      <span>{{ discovery_collection.title | escape }}</span>
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </form>

      <div class="pagination" data-pagination>
        {{ paginate | default_pagination }}
      </div>
      {% if paginate.next %}
        <div class="collection-load-sentinel" data-collection-load data-next-url="{{ paginate.next.url }}">
          <span class="collection-load-spinner" aria-hidden="true"></span>
          <span>Loading more EdenRose pieces…</span>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<script>
(function(){
  var loadSentinel=document.querySelector('[data-collection-load]');
  if(loadSentinel&&!loadSentinel.dataset.bound){
    loadSentinel.dataset.bound='true';
    var busy=false, grid=document.querySelector('.collection-results .product-grid');
    function loadMore(){
      if(busy||!loadSentinel.dataset.nextUrl||!grid)return;
      busy=true; loadSentinel.classList.add('is-loading');
      fetch(loadSentinel.dataset.nextUrl,{headers:{'X-Requested-With':'XMLHttpRequest'}})
        .then(function(r){if(!r.ok)throw new Error('load');return r.text()})
        .then(function(html){
          var doc=new DOMParser().parseFromString(html,'text/html');
          var nextGrid=doc.querySelector('.collection-results .product-grid');
          var next=doc.querySelector('[data-collection-load]');
          if(nextGrid){
            Array.prototype.slice.call(nextGrid.children).forEach(function(node){grid.appendChild(document.importNode(node,true));});
          }
          if(next&&next.dataset.nextUrl){
            loadSentinel.dataset.nextUrl=next.dataset.nextUrl;
            busy=false; loadSentinel.classList.remove('is-loading');
          }else{loadSentinel.remove();}
        })
        .catch(function(){busy=false;loadSentinel.classList.remove('is-loading');});
    }
    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(entries){if(entries.some(function(e){return e.isIntersecting}))loadMore()},{rootMargin:'900px 0px'});
      io.observe(loadSentinel);
    }else{window.addEventListener('scroll',function(){if(window.innerHeight+window.scrollY>document.body.offsetHeight-1200)loadMore()},{passive:true});}
  }
  var grid=document.querySelector('.collection-results .product-grid');
  var viewButtons=[].slice.call(document.querySelectorAll('[data-grid-view]'));
  viewButtons.forEach(function(button){
    button.addEventListener('click',function(){
      if(!grid)return;
      var cols=button.getAttribute('data-grid-view');
      grid.setAttribute('data-columns',cols);
      viewButtons.forEach(function(btn){
        var active=btn===button;
        btn.classList.toggle('is-active',active);
        btn.setAttribute('aria-pressed',active?'true':'false');
      });
    });
  });
  var toggle=document.querySelector('.filter-toggle');
  var panel=document.getElementById('CollectionFilters');
  if(!toggle||!panel)return;
  var close=panel.querySelector('.filter-close');
  toggle.setAttribute('aria-controls','CollectionFilters');
  var overlay=document.createElement('div');
  overlay.className='collection-filter-overlay';
  overlay.setAttribute('aria-hidden','true');
  document.body.appendChild(overlay);
  panel.setAttribute('aria-hidden','true');
  function setOpen(open){
    panel.classList.toggle('is-open',open);
    overlay.classList.toggle('is-open',open);
    toggle.setAttribute('aria-expanded',open?'true':'false');
    document.body.classList.toggle('collection-filters-open',open);
    panel.setAttribute('aria-hidden',open?'false':'true');
    overlay.setAttribute('aria-hidden',open?'false':'true');
  }
  var previousFocus=null;
  function openWithFocus(){previousFocus=document.activeElement;setOpen(true);if(close)close.focus();}
  function closeWithFocus(){setOpen(false);if(previousFocus&&previousFocus.focus)previousFocus.focus();}
  toggle.addEventListener('click',function(){if(panel.classList.contains('is-open'))closeWithFocus();else openWithFocus();});
  if(close)close.addEventListener('click',closeWithFocus);
  overlay.addEventListener('click',closeWithFocus);
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&panel.classList.contains('is-open'))closeWithFocus();});
})();
