{% render 'breadcrumbs' %}<section class="collection-page"><div class="collection-hero page-width"><p class="eyebrow">{{ 'templates.collection.eyebrow' | t }}</p><div class="collection-title-row"><div><div class="collection-eyebrow-line"><span>THE EDENROSE EDIT</span>{% if collection.products_count > 0 %}<span>{{ collection.products_count }} pieces</span>{% endif %}</div><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="collection-description">{{ collection.description }}</div>{% endif %}</div><span class="collection-mark" aria-hidden="true">E</span></div></div><div class="section page-width">{% paginate collection.products by 24 %}<div class="collection-toolbar"><div class="collection-count"><strong>{{ collection.products_count }}</strong> <span>{{ 'templates.collection.products' | t }}</span></div><div class="collection-actions"><div class="sort-form"><label for="SortBy">{{ 'templates.collection.sort_by' | t }}</label><select id="SortBy" name="sort_by" form="CollectionFilterForm" onchange="this.form.submit()"><option value="manual" {% if collection.sort_by == 'manual' or collection.sort_by == blank %}selected{% endif %}>{{ 'templates.collection.featured' | t }}</option><option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>{{ 'templates.collection.price_low' | t }}</option><option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>{{ 'templates.collection.price_high' | t }}</option><option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>{{ 'templates.collection.newest' | t }}</option></select></div></div></div><div class="collection-layout"><form id="CollectionFilterForm" class="filter-form" method="get" action="{{ collection.url }}"><div class="product-grid">{% for product in collection.products %}{% render 'card-product', product: product %}{% else %}<div class="collection-empty"><p>{{ 'templates.collection.no_products' | t }}</p>{% if collection.filters.size > 0 %}<a class="button button--secondary" href="{{ collection.url }}">{{ 'templates.collection.clear_filters' | t }}</a>{% endif %}</div>{% endfor %}</div></form></div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div></section>
{% stylesheet %}.collection-page{background:var(--paper);overflow:visible}.collection-hero{padding:clamp(4rem,8vw,7rem) 24px 3.5rem;border-bottom:1px solid var(--line);background:linear-gradient(180deg,var(--paper) 0%,#f7efeb 100%)}.collection-title-row{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;min-height:clamp(220px,28vw,360px)}.collection-eyebrow-line{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem}.collection-eyebrow-line span{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;padding:.35rem .5rem;border:1px solid var(--line)}.collection-eyebrow-line span:first-child{background:var(--wine);color:#fff;border-color:var(--wine)}.collection-hero h1{font-size:clamp(3.2rem,8vw,7rem);line-height:.88;letter-spacing:-.06em;margin:0;max-width:9ch}.collection-description{max-width:650px;margin:1.25rem 0 0;color:var(--muted);line-height:1.65}.collection-mark{font:normal clamp(6rem,15vw,13rem)/.7 Georgia,serif;color:var(--line);user-select:none;transform:translateY(.08em)}.collection-toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-block:1px solid var(--line);padding:1rem 0;margin-bottom:1.75rem}.collection-toolbar:before{content:'CURATED FOR YOU';font-size:.62rem;letter-spacing:.12em;color:var(--muted);text-transform:uppercase}.collection-actions{display:flex;align-items:center;gap:1rem;margin-left:auto}.sort-form{display:flex;align-items:center;gap:.5rem}.sort-form select{padding:.65rem 2rem .65rem .75rem;border:1px solid var(--line);background:var(--paper);border-radius:999px;min-height:44px}.filter-heading{display:flex;justify-content:space-between;padding-bottom:1rem;border-bottom:1px solid var(--line)}.filter-close{display:none;border:0;background:none;font-size:1.5rem}.filter-group{border-bottom:1px solid var(--line);padding:.9rem 0}.filter-group summary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between}.filter-group summary::-webkit-details-marker{display:none}.filter-options{padding-top:.8rem;display:grid;gap:.55rem}.filter-value{display:grid;grid-template-columns:auto 1fr auto;gap:.5rem;align-items:center;font-size:.9rem}.filter-value small{color:var(--muted)}.filter-options input[type=number]{width:100%;padding:.55rem;border:1px solid var(--line);background:var(--paper)}.filter-clear{display:block;text-align:center;margin-top:.65rem;font-size:.82rem;text-decoration:underline;text-underline-offset:3px}.collection-empty{grid-column:1/-1;text-align:center;padding:clamp(3rem,7vw,5rem) 1rem;border:1px solid var(--line);background:#f7efeb}.collection-empty p{color:var(--muted);margin:0 0 1rem}.collection-empty .button{display:inline-flex}.filter-clear-top{font-size:.82rem;text-decoration:underline;text-underline-offset:3px;margin-left:.75rem}.filter-form{min-width:0}.pagination{padding:3rem 0 4rem;display:flex;justify-content:center;flex-wrap:wrap;gap:6px}.pagination a,.pagination span{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:.4rem .7rem;border:1px solid var(--line);border-radius:999px}.pagination .current{background:var(--ink);color:var(--paper);border-color:var(--ink)}.pagination a:hover{background:var(--soft);text-decoration:none}@media(max-width:749px){.collection-toolbar:before{display:none}.collection-toolbar{position:sticky;top:76px;z-index:20;background:var(--paper);box-shadow:0 1px 0 var(--line);padding-block:.75rem;margin-bottom:1rem}.collection-hero{padding:3.5rem 16px 2.5rem;background:linear-gradient(180deg,var(--paper) 0%,#f7efeb 100%)}.collection-title-row{align-items:flex-start;min-height:190px}.collection-mark{font-size:5rem;transform:translateY(.1em)}.collection-toolbar{align-items:stretch;flex-direction:column;gap:.7rem}.collection-actions{justify-content:space-between}.sort-form{justify-content:flex-end}.sort-form select{max-width:180px}.collection-layout{display:block} .collection-page.filters-open .product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.15rem}.collection-count{font-size:.9rem}}@media(max-width:480px){.collection-actions{gap:.5rem}.sort-form label{display:none}.sort-form select{max-width:150px}.collection-hero h1{font-size:clamp(3rem,15vw,5rem)}.collection-description{font-size:.92rem}}
{% endstylesheet %}{% schema %}{"name":"t:sections.main_collection.name"}{% endschema %}