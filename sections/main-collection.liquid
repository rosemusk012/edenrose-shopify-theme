{% render 'breadcrumbs' %}<section class="collection-page"><div class="collection-hero page-width"><p class="eyebrow">{{ 'templates.collection.eyebrow' | t }}</p><div class="collection-title-row"><div><div class="collection-eyebrow-line"><span>THE EDENROSE EDIT</span>{% if collection.products_count > 0 %}<span>{{ collection.products_count }} pieces</span>{% endif %}</div><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="collection-description">{{ collection.description }}</div>{% endif %}</div><span class="collection-mark" aria-hidden="true">E</span></div></div><div class="section page-width">{% paginate collection.products by 24 %}<div class="collection-toolbar"><div class="collection-count"><strong>{{ collection.products_count }}</strong> <span>{{ 'templates.collection.products' | t }}</span></div>{% assign active_filter_count = 0 %}{% for filter in collection.filters %}{% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}{% endfor %}{% if active_filter_count > 0 %}<a class="filter-clear-top" href="{{ collection.url }}">{{ 'templates.collection.clear_filters' | t }}</a>{% endif %}<div class="collection-actions"><button type="button" class="filter-toggle" aria-expanded="false" aria-controls="CollectionFilters">{{ 'templates.collection.filter' | t }}{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %} <span aria-hidden="true">+</span></button><div class="sort-form"><label for="SortBy">{{ 'templates.collection.sort_by' | t }}</label><select id="SortBy" name="sort_by" form="CollectionFilterForm" onchange="this.form.submit()"><option value="manual" {% if collection.sort_by == 'manual' or collection.sort_by == blank %}selected{% endif %}>{{ 'templates.collection.featured' | t }}</option><option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>{{ 'templates.collection.price_low' | t }}</option><option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>{{ 'templates.collection.price_high' | t }}</option><option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>{{ 'templates.collection.newest' | t }}</option></select></div></div></div><div class="collection-layout"><aside id="CollectionFilters" class="collection-filters" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="CollectionFiltersHeading"><div class="filter-heading"><strong id="CollectionFiltersHeading">{{ 'templates.collection.refine' | t }}</strong><button type="button" class="filter-close" aria-label="{{ 'templates.collection.close_filters' | t }}">×</button></div>{% for filter in collection.filters %}<details class="filter-group" {% if filter.active_values.size > 0 %}open{% endif %}><summary>{{ filter.label }} <span aria-hidden="true">+</span></summary><div class="filter-options">{% if filter.type == 'price_range' %}<label>{{ 'templates.collection.min' | t }} <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | escape }}" placeholder="0" min="0" form="CollectionFilterForm"></label><label>{{ 'templates.collection.max' | t }} <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | escape }}" placeholder="{{ shop.currency }}" min="0" form="CollectionFilterForm"></label>{% else %}{% for value in filter.values %}<label class="filter-value"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} form="CollectionFilterForm"><span>{{ value.label | escape }}</span><small>{{ value.count }}</small></label>{% endfor %}{% endif %}</div></details>{% endfor %}<button type="submit" class="button filter-apply" form="CollectionFilterForm">{{ 'templates.collection.apply_filters' | t }}</button><a class="filter-clear" href="{{ collection.url }}">{{ 'templates.collection.clear_filters' | t }}</a><button type="button" class="filter-overlay" aria-label="{{ 'templates.collection.close_filters' | t }}"></button></aside><form id="CollectionFilterForm" class="filter-form" method="get"><div class="product-grid">{% for product in collection.products %}{% render 'card-product', product: product %}{% else %}<div class="collection-empty"><p>{{ 'templates.collection.no_products' | t }}</p>{% if collection.filters.size > 0 %}<a class="button button--secondary" href="{{ collection.url }}">{{ 'templates.collection.clear_filters' | t }}</a>{% endif %}</div>{% endfor %}</div></form></div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div></section><script>(function(){function init(){document.querySelectorAll('.collection-page').forEach(function(p){if(p.dataset.filtersInitialized)return;var t=p.querySelector('.filter-toggle'),panel=p.querySelector('.collection-filters'),c=p.querySelector('.filter-close'),o=p.querySelector('.filter-overlay');if(!t||!panel)return;p.dataset.filtersInitialized='true';function close(){panel.classList.remove('is-open');panel.inert=true;p.classList.remove('filters-open');t.setAttribute('aria-expanded','false');document.body.classList.remove('filters-open');t.focus()}function open(){panel.inert=false;panel.classList.add('is-open');p.classList.add('filters-open');t.setAttribute('aria-expanded','true');document.body.classList.add('filters-open');panel.focus()}panel.inert=true;function trap(e){if(!panel.classList.contains('is-open')||e.key!=='Tab')return;var f=panel.querySelectorAll('a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),summary');if(!f.length)return;var first=f[0],last=f[f.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}t.addEventListener('click',open);if(c)c.addEventListener('click',close);if(o)o.addEventListener('click',close);p.addEventListener('keydown',function(e){if(e.key==='Escape'&&panel.classList.contains('is-open'))close();trap(e)})})}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init()})();</script>
{% stylesheet %}.collection-page{background:var(--paper);overflow:clip}.collection-hero{padding:clamp(4rem,8vw,7rem) 24px 3.5rem;border-bottom:1px solid var(--line);background:linear-gradient(180deg,var(--paper) 0%,#f7efeb 100%)}.collection-title-row{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;min-height:clamp(220px,28vw,360px)}.collection-eyebrow-line{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem}.collection-eyebrow-line span{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;padding:.35rem .5rem;border:1px solid var(--line)}.collection-eyebrow-line span:first-child{background:var(--wine);color:#fff;border-color:var(--wine)}.collection-hero h1{font-size:clamp(3.2rem,8vw,7rem);line-height:.88;letter-spacing:-.06em;margin:0;max-width:9ch}.collection-description{max-width:650px;margin:1.25rem 0 0;color:var(--muted);line-height:1.65}.collection-mark{font:normal clamp(6rem,15vw,13rem)/.7 Georgia,serif;color:var(--line);user-select:none;transform:translateY(.08em)}.collection-toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-block:1px solid var(--line);padding:1rem 0;margin-bottom:1.75rem}.collection-toolbar:before{content:'CURATED FOR YOU';font-size:.62rem;letter-spacing:.12em;color:var(--muted);text-transform:uppercase}.collection-actions{display:flex;align-items:center;gap:1rem;margin-left:auto}.sort-form{display:flex;align-items:center;gap:.5rem}.sort-form select{padding:.65rem 2rem .65rem .75rem;border:1px solid var(--line);background:var(--paper);border-radius:999px;min-height:44px}.filter-toggle{display:none}.collection-layout{display:grid;grid-template-columns:220px 1fr;gap:2rem}.collection-filters{position:sticky;top:90px;align-self:start}.filter-overlay{display:none}.filter-heading{display:flex;justify-content:space-between;padding-bottom:1rem;border-bottom:1px solid var(--line)}.filter-close{display:none;border:0;background:none;font-size:1.5rem}.filter-group{border-bottom:1px solid var(--line);padding:.9rem 0}.filter-group summary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between}.filter-group summary::-webkit-details-marker{display:none}.filter-options{padding-top:.8rem;display:grid;gap:.55rem}.filter-value{display:grid;grid-template-columns:auto 1fr auto;gap:.5rem;align-items:center;font-size:.9rem}.filter-value small{color:var(--muted)}.filter-options input[type=number]{width:100%;padding:.55rem;border:1px solid var(--line);background:var(--paper)}.filter-apply{margin-top:1rem;width:100%}.filter-clear{display:block;text-align:center;margin-top:.65rem;font-size:.82rem;text-decoration:underline;text-underline-offset:3px}.collection-empty{grid-column:1/-1;text-align:center;padding:clamp(3rem,7vw,5rem) 1rem;border:1px solid var(--line);background:#f7efeb}.collection-empty p{color:var(--muted);margin:0 0 1rem}.collection-empty .button{display:inline-flex}.filter-clear-top{font-size:.82rem;text-decoration:underline;text-underline-offset:3px;margin-left:.75rem}.filter-form{min-width:0}.pagination{padding:3rem 0 4rem;display:flex;justify-content:center;flex-wrap:wrap;gap:6px}.pagination a,.pagination span{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:.4rem .7rem;border:1px solid var(--line);border-radius:999px}.pagination .current{background:var(--ink);color:var(--paper);border-color:var(--ink)}.pagination a:hover{background:var(--soft);text-decoration:none}@media(max-width:749px){.collection-toolbar:before{display:none}.collection-toolbar{position:sticky;top:76px;z-index:20;background:var(--paper);box-shadow:0 1px 0 var(--line);padding-block:.75rem;margin-bottom:1rem}.collection-hero{padding:3.5rem 16px 2.5rem;background:linear-gradient(180deg,var(--paper) 0%,#f7efeb 100%)}.collection-title-row{align-items:flex-start;min-height:190px}.collection-mark{font-size:5rem;transform:translateY(.1em)}.collection-toolbar{align-items:stretch;flex-direction:column;gap:.7rem}.collection-actions{justify-content:space-between}.filter-toggle{display:inline-flex;align-items:center;justify-content:space-between;gap:1rem;padding:.65rem 1rem;border:1px solid var(--ink);background:var(--ink);color:var(--paper);font:inherit}.sort-form{justify-content:flex-end}.sort-form select{max-width:180px}.collection-layout{display:block}.collection-filters{position:fixed;z-index:50;inset:0 auto 0 0;width:min(88vw,360px);padding:1.25rem;background:var(--paper);box-shadow:0 0 40px #0002;transform:translateX(-105%);transition:transform .2s ease;overflow:auto;border-right:1px solid var(--line)}.collection-filters.is-open{transform:translateX(0)}.filter-close{display:block}.filters-open{overflow:hidden}.filter-overlay{display:block;position:fixed;z-index:45;inset:0;border:0;background:#0008;cursor:pointer;opacity:0;pointer-events:none;visibility:hidden;transition:opacity .2s ease,visibility .2s ease} .collection-page.filters-open .filter-overlay{opacity:1;pointer-events:auto;visibility:visible}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.15rem}.collection-count{font-size:.9rem}}@media(max-width:480px){.collection-actions{gap:.5rem}.sort-form label{display:none}.sort-form select{max-width:150px}.filter-toggle{flex:1}.collection-hero h1{font-size:clamp(3rem,15vw,5rem)}.collection-description{font-size:.92rem}}
