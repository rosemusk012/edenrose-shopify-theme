<section class="floating-collections" aria-labelledby="floating-collections-heading">
  <div class="page-width">
    <div class="floating-collections__intro">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="floating-collections-heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    </div>
    <div class="floating-collections__grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% if collection != blank %}
          <a class="floating-card floating-card--{{ forloop.index }}" href="{{ collection.url }}" {{ block.shopify_attributes }}>
            <div class="floating-card__image">
              {% if collection.featured_image %}
                {{ collection.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '450,650,900', sizes: '(min-width: 750px) 32vw, 85vw', decoding: 'async', alt: collection.title }}
              {% elsif collection.products.first.featured_image %}
                {{ collection.products.first.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '450,650,900', sizes: '(min-width: 750px) 32vw, 85vw', decoding: 'async', alt: collection.title }}
              {% endif %}
            </div>
            <div class="floating-card__label">
              <span>{{ collection.title | escape }}</span>
              <span aria-hidden="true">↗</span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.floating-collections{padding:clamp(4rem,8vw,8rem) 0;overflow:hidden}
.floating-collections__intro{max-width:42rem;margin-bottom:clamp(2rem,5vw,4rem)}
.floating-collections__intro h2{font-size:clamp(2.5rem,6vw,5.5rem);line-height:.92;letter-spacing:-.055em;margin:.35rem 0 1rem}
.floating-collections__intro>p:last-child{color:var(--muted);line-height:1.65;max-width:32rem}
.floating-collections__grid{display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(1rem,2vw,2rem);align-items:start}
.floating-card{grid-column:span 4;display:block;text-decoration:none;color:inherit;transform:rotate(var(--tilt));transition:transform .35s ease,box-shadow .35s ease;position:relative}
.floating-card--1{--tilt:-2deg;margin-top:1rem}
.floating-card--2{--tilt:2.5deg;margin-top:4rem}
.floating-card--3{--tilt:-1deg;margin-top:-.5rem}
.floating-card--4{--tilt:2deg;margin-top:3rem}
.floating-card--5{--tilt:-2.5deg;margin-top:-1rem}
.floating-card--6{--tilt:1deg;margin-top:2.5rem}
.floating-card:hover{transform:rotate(0) translateY(-8px);z-index:2}
.floating-card__image{aspect-ratio:4/5;overflow:hidden;background:var(--line);box-shadow:0 12px 35px rgba(30,28,25,.10)}
.floating-card__image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
.floating-card:hover .floating-card__image img{transform:scale(1.035)}
.floating-card__label{display:flex;justify-content:space-between;gap:1rem;padding:.8rem .15rem 0;font-size:.78rem;letter-spacing:.06em;text-transform:uppercase}
.floating-card__label span:last-child{font-size:1rem}
@media(max-width:749px){
  .floating-collections{padding:4rem 0}
  .floating-collections__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:1.1rem;padding:1rem 6vw 2rem;margin:0 -6vw;scrollbar-width:none}
  .floating-collections__grid::-webkit-scrollbar{display:none}
  .floating-card{flex:0 0 76vw;scroll-snap-align:center;margin-top:0!important}
  .floating-card--1{--tilt:-1.5deg}.floating-card--2{--tilt:1.5deg}.floating-card--3{--tilt:-1deg}
  .floating-card__image{box-shadow:0 10px 28px rgba(30,28,25,.10)}
}
{% endstylesheet %}

{% schema %}
{"name":"Floating collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The EdenRose edit"},{"type":"text","id":"heading","label":"Heading","default":"Pick your mood."},{"type":"textarea","id":"text","label":"Text","default":"A little inspiration before you keep exploring."}],"blocks":[{"type":"collection","name":"Collection card","settings":[{"type":"collection","id":"collection","label":"Collection"}]}],"presets":[{"name":"Floating collections"}]}
{% endschema %}