<section class="benefits" aria-label="{{ 'sections.benefits.aria_label' | t }}"><div class="page-width"><div class="benefits-intro"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="benefits-grid">{% for block in section.blocks %}<div class="benefit" {{ block.shopify_attributes }}><span class="benefit__number">{{ forloop.index | prepend: '0' }}</span><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} →</a>{% endif %}</div></div>{% endfor %}</div></div></section>{% stylesheet %}.benefits{padding:clamp(3.5rem,7vw,6rem) 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.benefits-intro{margin-bottom:2.5rem;min-width:0}.benefits-intro h2{margin:.35rem 0 0;font-size:clamp(2rem,4vw,3.4rem);letter-spacing:-.04em;max-width:16ch;overflow-wrap:anywhere}.benefits-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}.benefit{display:grid;min-width:0;grid-template-columns:auto 1fr;gap:1.2rem;padding:1.5rem 1.25rem 1.5rem 0;border-right:1px solid var(--line)}.benefit:not(:first-child){padding-left:1.25rem}.benefit:last-child{border-right:0}.benefit__number{font-size:.68rem;letter-spacing:.12em;color:var(--muted)}.benefit h3{margin:0 0 .45rem;font-size:1rem}.benefit p{margin:0;overflow-wrap:anywhere;color:var(--muted);line-height:1.55;font-size:.92rem}.benefit a{display:inline-block;margin-top:.7rem;font-size:.8rem;text-decoration:underline;text-underline-offset:3px}@media(max-width:749px){.benefits{padding-block:3.25rem}.benefits-grid{grid-template-columns:1fr}.benefit,.benefit:not(:first-child){border-right:0;border-bottom:1px solid var(--line);padding:1.2rem 0}.benefit:last-child{border-bottom:0}}{% endstylesheet %}{% schema %}{"name":"t:sections.benefits_editor.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.benefits_editor.settings.eyebrow","default":"The EdenRose way"},{"type":"text","id":"heading","label":"t:sections.benefits_editor.settings.heading","default":"Simple things, thoughtfully done."}],"blocks":[{"type":"benefit","name":"t:sections.benefits_editor.blocks.benefit","settings":[{"type":"text","id":"title","label":"t:sections.benefits_editor.blocks.title","default":"Easy browsing"},{"type":"text","id":"text","label":"t:sections.benefits_editor.blocks.text","default":"Explore clothing and jewellery by collection."},{"type":"text","id":"link_label","label":"t:sections.benefits_editor.blocks.link_label","default":"Explore"},{"type":"url","id":"link","label":"t:sections.benefits_editor.blocks.link"}]}],"presets":[{"name":"t:sections.benefits_editor.name","blocks":[{"type":"benefit","settings":{"title":"Easy browsing","text":"Explore clothing and jewellery by collection."}},{"type":"benefit","settings":{"title":"Clear checkout","text":"Shipping and delivery details are shown before purchase."}},{"type":"benefit","settings":{"title":"Secure payment","text":"Checkout is handled securely by Shopify."}}]}]}{% endschema %}