{%- liquid
  assign all_handles = ''
  paginate collections by 250
    for item in collections
      if item.products_count > 0
        assign all_handles = all_handles | append: item.handle | append: ','
      endif
    endfor
  endpaginate
  assign more_handles = ''
  if section.settings.show_more
    capture more_handles
      render 'edenrose-collection-more', all_handles: all_handles
    endcapture
    assign more_handles = more_handles | strip
  endif
  assign group_women = 'templates.collection.group_women' | t
  assign group_men = 'templates.collection.group_men' | t
  assign group_jewellery = 'templates.collection.group_jewellery' | t
  assign group_shoes_swim = 'templates.collection.group_shoes_swim' | t
  assign group_edits = 'templates.collection.group_edits' | t
  assign group_more = 'templates.collection.group_more' | t
-%}
<section class="collection-index" aria-labelledby="CollectionIndex-{{ section.id }}">
  <div class="page-width">
    <div class="collection-index__intro">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="CollectionIndex-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="collection-index__aside">
        {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro | escape }}</p>{%- endif -%}
        <a class="text-link" href="{{ routes.collections_url }}">{{ 'general.view_all' | t }} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="collection-index__groups">
      {% render 'edenrose-collection-group', mode: 'chips', handles: settings.collection_group_women, title: group_women, group_id: 'CollectionIndexWomen', show_counts: section.settings.show_counts %}
      {% render 'edenrose-collection-group', mode: 'chips', handles: settings.collection_group_men, title: group_men, group_id: 'CollectionIndexMen', show_counts: section.settings.show_counts, strip_prefix: 'Men ' %}
      {% render 'edenrose-collection-group', mode: 'chips', handles: settings.collection_group_jewellery, title: group_jewellery, group_id: 'CollectionIndexJewellery', show_counts: section.settings.show_counts %}
      {% render 'edenrose-collection-group', mode: 'chips', handles: settings.collection_group_shoes_swim, title: group_shoes_swim, group_id: 'CollectionIndexShoesSwim', show_counts: section.settings.show_counts %}
      {% render 'edenrose-collection-group', mode: 'chips', handles: settings.collection_group_edits, title: group_edits, group_id: 'CollectionIndexEdits', show_counts: section.settings.show_counts %}
      {%- if more_handles != blank -%}
        {% render 'edenrose-collection-group', mode: 'chips', handles: more_handles, title: group_more, group_id: 'CollectionIndexMore', show_counts: section.settings.show_counts %}
      {%- endif -%}
    </div>
  </div>
</section>
{% stylesheet %}
.collection-index{overflow:hidden;padding:clamp(2.5rem,5vw,4.5rem) 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(180deg,var(--paper),var(--blush,var(--soft)))}
.collection-index__intro{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:clamp(1.5rem,3vw,2.25rem)}
.collection-index__intro h2{margin:.3rem 0 0;font:normal clamp(2.2rem,4.6vw,4rem)/.95 var(--display);letter-spacing:-.045em;max-width:12ch}
.collection-index__aside{display:grid;justify-items:end;gap:.6rem;max-width:24rem;text-align:right}
.collection-index__aside p{margin:0;color:var(--muted);line-height:1.6}
.collection-index__groups{display:grid;gap:0}
.collection-index__group{display:grid;grid-template-columns:minmax(8rem,11rem) minmax(0,1fr);gap:1.25rem;align-items:start;padding:.95rem 0;border-top:1px solid var(--line)}
.collection-index__group:first-child{border-top:0}
.collection-index__label{margin:.45rem 0 0;font:italic normal clamp(1.15rem,1.8vw,1.45rem)/1.1 var(--display);letter-spacing:-.01em}
.collection-index__chips{display:flex;flex-wrap:wrap;gap:.45rem;margin:0;padding:0;list-style:none}
.collection-chip{display:inline-flex;align-items:center;gap:.45rem;min-height:40px;padding:.45rem .9rem;border:1px solid var(--line);border-radius:999px;background:var(--paper);font-size:.82rem;line-height:1.2;color:var(--ink);transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
.collection-chip small{font-size:.66rem;letter-spacing:.06em;color:var(--muted)}
.collection-chip:hover,.collection-chip:focus-visible{border-color:var(--ink);transform:translateY(-1px);box-shadow:0 8px 18px rgba(33,26,27,.08)}
@media(max-width:749px){
.collection-index__intro{display:block}.collection-index__aside{justify-items:start;text-align:left;margin-top:.8rem}
.collection-index__group{grid-template-columns:1fr;gap:.55rem;padding:.85rem 0}
.collection-index__label{margin:0}
.collection-index__chips{flex-wrap:nowrap;overflow-x:auto;scroll-snap-type:x proximity;margin-inline:-16px;padding:0 16px .35rem;max-width:calc(100% + 32px);scrollbar-width:none}
.collection-index__chips::-webkit-scrollbar{display:none}
.collection-index__chips li{flex:none;scroll-snap-align:start}
}
{% endstylesheet %}
{% schema %}
{"name":"t:sections.collection_index.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.collection_index.settings.eyebrow","default":"Every collection"},{"type":"text","id":"heading","label":"t:sections.collection_index.settings.heading","default":"Find your edit."},{"type":"textarea","id":"intro","label":"t:sections.collection_index.settings.intro","default":"Women's, men's, jewellery, shoes and swim. New collections appear here as soon as they have pieces."},{"type":"checkbox","id":"show_counts","label":"t:sections.collection_index.settings.show_counts","default":true},{"type":"checkbox","id":"show_more","label":"t:sections.collection_index.settings.show_more","default":true}],"presets":[{"name":"t:sections.collection_index.name"}]}
{% endschema %}
