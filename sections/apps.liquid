<section class="apps-section"{% if section.blocks.size == 0 %} hidden{% endif %}>
  <div class="page-width">
    {% for block in section.blocks %}
      <div class="app-block" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
.apps-section{padding:clamp(2rem,5vw,4rem) 0}.apps-section[hidden]{display:none}
.app-block + .app-block{margin-top:1.5rem}
{% endstylesheet %}

{% schema %}
{"name":"Apps","blocks":[{"type":"@app"}],"presets":[{"name":"Apps"}]}
{% endschema %}