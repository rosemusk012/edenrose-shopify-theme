{% render 'breadcrumbs' %}<section class="page-content"><div class="page-width"><p class="page-kicker">EDENROSE / INFORMATION</p><h1>{{ page.title | escape }}</h1><div class="rte">{{ page.content }}</div></div></section>
{% stylesheet %}.page-content{padding:clamp(3rem,7vw,6rem) 0}.page-kicker{margin:0 0 .75rem;font-size:.62rem;text-transform:uppercase;letter-spacing:.16em;color:var(--accent)}.page-content h1{font-size:clamp(2.8rem,7vw,5.8rem);line-height:.95;letter-spacing:-.05em;margin:0 0 2rem}.page-content .rte{max-width:780px;color:var(--muted);font-size:1rem;line-height:1.75}.page-content .rte h2,.page-content .rte h3{color:var(--ink);font-family:var(--display);font-weight:400;line-height:1.1;margin-top:2.5rem}.page-content .rte a{text-decoration:underline;text-underline-offset:3px}.page-content .rte img{max-width:100%;height:auto;display:block;margin:1.5rem 0}@media(max-width:560px){.page-content{padding:2.5rem 0}.page-content h1{font-size:2.8rem}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.main_page.name"}{% endschema %}