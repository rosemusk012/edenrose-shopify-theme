<section class="not-found" aria-labelledby="NotFoundTitle"><div class="page-width"><div class="not-found-inner"><span class="not-found-mark" aria-hidden="true">404</span><span class="not-found-rose" aria-hidden="true">✦</span><p class="eyebrow">{{ 'templates.404.eyebrow' | t }}</p><h1 id="NotFoundTitle">{{ 'templates.404.title' | t }}</h1><p class="not-found-copy">{{ 'templates.404.text' | t }}</p><div class="not-found-actions"><a class="button" href="{{ routes.root_url }}">{{ 'templates.404.home' | t }}</a><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'templates.404.shop' | t }} →</a></div></div></div></section>
{% stylesheet %}
.not-found{min-height:65vh;display:grid;place-items:center;padding:4rem 0}.not-found-inner{text-align:center;max-width:760px;margin:auto}.not-found-mark{display:block;font:clamp(6rem,18vw,13rem)/.75 var(--display);letter-spacing:-.08em;color:var(--line);margin-bottom:1.5rem}.not-found-rose{display:block;color:var(--accent);font-size:1.2rem;margin:0 0 .4rem}.not-found-inner h1{font:normal clamp(2.5rem,6vw,5rem)/.98 var(--display);letter-spacing:-.04em;margin:.35rem 0 1rem}.not-found-copy{max-width:520px;margin:0 auto;color:var(--muted);line-height:1.7}.not-found-actions{display:flex;justify-content:center;align-items:center;gap:1.5rem;margin-top:2rem}.not-found .button:focus-visible,.not-found .text-link:focus-visible{outline:var(--focus);outline-offset:4px}.text-link{text-decoration:underline;text-underline-offset:5px}.not-found .button{min-height:50px}
@media(max-width:560px){.not-found{min-height:70vh;padding-block:3rem}.not-found-actions{flex-direction:column;gap:1.1rem}.not-found .button{width:min(100%,20rem)}}
{% endstylesheet %}
{% schema %}{"name":"t:sections.main_404.name"}{% endschema %}