{% doc %}Renders a product card. @param {product} product The product to display. @example {% render 'card-product', product: product %}{% enddoc %}<article class="card"><a href="{{ product.url }}" aria-label="{{ product.title | escape }}"><div class="card-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% endif %}</div><div class="card-info"><h3 class="card-title">{{ product.title | escape }}</h3><div class="card-price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div></div></a></article>