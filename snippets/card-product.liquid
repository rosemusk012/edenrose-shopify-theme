{% doc %}
Renders a product card with image, availability, pricing, and quick add.
@param {product} product The product to display.
@example
{% render 'card-product', product: product %}
{% enddoc %}
{% assign has_available_variant = product.available %}
<article class="card" data-product-card><a class="card-media-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}" data-product-card-link><div class="card-image" data-product-card-image data-card-image-interactive role="img" aria-label="{{ product.title | escape }}">{% if product.images.size > 1 %} data-has-secondary-image{% endif %}>{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 33vw, 50vw', alt: product.featured_image.alt | default: product.title }}{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 33vw, 50vw', class: 'card-image-secondary', alt: product.images[1].alt | default: product.title }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}{% unless has_available_variant %}<span class="card-badge card-badge--sold-out">{{ 'products.product.sold_out' | t }}</span>{% endunless %}{% if has_available_variant and product.compare_at_price > product.price %}<span class="card-badge card-badge--sale">Sale</span>{% elsif product.tags contains 'new' or product.tags contains 'New' or product.tags contains 'NEW' %}<span class="card-badge card-badge--new">{{ 'products.product.new' | t }}</span>{% endif %}</div></a><button type="button" class="card-wishlist" aria-label="Save {{ product.title | escape }}" aria-pressed="false" data-wishlist="{{ product.handle }}">♡</button><button type="button" class="card-view" data-quick-view="{{ product.handle }}" aria-haspopup="dialog" aria-label="Quick view {{ product.title | escape }}"><span>Quick view</span><span aria-hidden="true">↗</span></button><div class="card-info"><div class="card-browse-meta"><p class="card-category">{{ product.type | default: "EdenRose" | escape }}</p><h3 class="card-title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3></div><div class="card-price" aria-label="{% if product.compare_at_price > product.price %}Sale price {{ product.price | money }}, regular price {{ product.compare_at_price | money }}{% else %}{{ product.price | money }}{% endif %}"><span class="card-current-price">{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<s aria-label="Regular price {{ product.compare_at_price | money }}">{{ product.compare_at_price | money }}</s><span class="card-sale-percent" aria-label="On sale">{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% off</span>{% endif %}</div>{% if has_available_variant %}{% if product.has_only_default_variant %}{% form 'product', product, class: 'card-quick-add' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="quick-add" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}">{{ 'products.product.add_to_cart' | t }}</button>{% endform %}{% else %}<a class="quick-add quick-add--link" href="{{ product.url }}" aria-label="{{ 'products.product.choose_options' | t }}: {{ product.title | escape }}">{{ 'products.product.choose_options' | t }} <span aria-hidden="true">→</span></a>{% endif %}{% endif %}</div></article>
<script>
(function(){
  if(window.EdenRoseWishlistBound)return; window.EdenRoseWishlistBound=true;
  var key='edenrose-wishlist';
  function get(){try{return JSON.parse(localStorage.getItem(key)||'[]')}catch(e){return[]}}
  function set(v){try{localStorage.setItem(key,JSON.stringify(v))}catch(e){}}
  function sync(){
    var items=get();
    document.querySelectorAll('[data-wishlist]').forEach(function(b){
      var on=items.indexOf(b.dataset.wishlist)>-1;
      b.textContent=on?'♥':'♡'; b.setAttribute('aria-pressed',on?'true':'false'); b.classList.toggle('is-saved',on); b.setAttribute('aria-label',(on?'Remove from saved items: ':'Save ')+b.dataset.wishlist);
    });
  }
  document.addEventListener('click',function(e){
    var b=e.target.closest('[data-wishlist]'); if(!b)return;
    e.preventDefault();
    var items=get(), i=items.indexOf(b.dataset.wishlist);
    if(i>-1)items.splice(i,1);else items.push(b.dataset.wishlist);
    set(items); sync();
  });
  sync();
})();
</script>
{% stylesheet %}.card{min-width:0;display:flex;flex-direction:column;height:100%;position:relative}.card:hover .card-info{min-width:0;transform:translateY(-1px)}.card-media-link{display:block;border-radius:10px}.card-image[data-has-secondary-image]{cursor:pointer}.card-image{position:relative;overflow:hidden;aspect-ratio:4/5;background:var(--soft);border-radius:10px;isolation:isolate}.card-image img,.card-image svg{width:100%;height:100%;object-fit:cover;display:block}.card-image-secondary{position:absolute;inset:0;opacity:0;transition:opacity .22s ease,transform .35s ease}.card-image-secondary{transform:scale(1.02)}.card-media-link{position:relative}.card-media-link:hover img,.card-media-link:focus-visible img{transform:scale(1.025)}.card-media-link:focus-visible{outline:2px solid currentColor;outline-offset:3px}.card-media-link:hover .card-image-secondary,.card-media-link:focus-visible .card-image-secondary{opacity:1;transform:scale(1)}.card-media-link:focus-visible{outline:var(--focus);outline-offset:3px}.card-wishlist{position:absolute;right:.75rem;top:.75rem;z-index:4;width:42px;height:42px;border:1px solid var(--line);background:var(--paper);color:var(--ink);font-size:1.15rem;border-radius:50%;cursor:pointer;box-shadow:0 5px 18px rgba(23,20,17,.08);transition:transform .2s ease,background .2s ease}.card-wishlist:hover{transform:scale(1.05);background:var(--soft)}.card-wishlist.is-saved{background:var(--wine);color:#fff;border-color:var(--wine)}.card-wishlist:focus-visible{outline:var(--focus);outline-offset:3px}.card-wishlist.is-saved{animation:edenrose-save-pop .24s ease}@keyframes edenrose-save-pop{50%{transform:scale(1.14)}100%{transform:scale(1)}}.card-view{position:absolute;right:.75rem;bottom:.75rem;z-index:4;padding:.45rem .7rem;border:0;background:var(--paper);color:var(--ink);font:inherit;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;opacity:0;transform:translateY(4px);transition:opacity .2s ease,transform .2s ease;border-radius:999px;box-shadow:0 5px 18px rgba(23,20,17,.1);cursor:pointer}.card-view:hover{background:var(--ink);color:var(--paper)}.quick-add--link>span{display:inline-block;transition:transform .2s ease}.quick-add--link:hover>span{transform:translateX(2px)}.card-view>span:last-child{display:inline-block;margin-left:.25rem;transition:transform .2s ease}.card-view:hover>span:last-child{transform:translate(2px,-2px)}.card:hover .card-view,.card:focus-within .card-view{opacity:1;transform:none}.card-image img{transition:transform .25s ease,opacity .2s ease}.card-badge{position:absolute;top:.65rem;left:.65rem;padding:.38rem .62rem;background:var(--paper);color:var(--ink);font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;z-index:2;border-radius:999px}.card-badge--sale{background:var(--wine);color:#fff}.card-badge--sold-out{border:1px solid var(--line);background:var(--soft)}.card-badge--new{border:1px solid var(--ink)}.card-info{padding:.9rem 0;display:flex;flex-direction:column;flex:1;transition:transform .2s ease}.card-browse-meta{display:block}.card-category{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin:0 0 .3rem;min-height:1em}.card-title{font-size:clamp(.92rem,1vw,1rem);line-height:1.3;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;min-height:2.6em;line-height:1.3;margin:0 0 .4rem;min-height:2.6em;letter-spacing:-.01em}.card-title a{color:inherit;text-decoration:none}.card-current-price{font-weight:700}.card-price{display:flex;gap:.5rem;align-items:center;font-weight:650;min-height:1.4em;font-size:.92rem}.card-quick-add{margin-top:auto}.card-price s{font-size:.9em;color:var(--muted);font-weight:400}.card-sale-percent{font-size:.66rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:var(--wine);margin-left:.1rem}.quick-add{display:flex;align-items:center;justify-content:center;gap:.3rem;display:flex;position:relative;align-items:center;justify-content:center;width:100%;margin-top:.8rem;padding:.7rem .8rem;border:1px solid var(--ink);background:transparent;color:var(--ink);font:inherit;cursor:pointer;text-decoration:none;transition:background .15s ease,color .15s ease;border-radius:999px;min-height:44px}.quick-add:hover,.quick-add:focus-visible{background:var(--ink);color:var(--paper)}.quick-add--link{align-items:center}.quick-add:focus-visible{outline:var(--focus);outline-offset:2px}.card-media-link:focus-visible{border-radius:10px}@media(prefers-reduced-motion:reduce){.card-image-secondary{transition:none}.quick-add--link>span{transition:none}.card-wishlist.is-saved{animation:none}.card-wishlist{transition:none}}@media(prefers-reduced-motion:reduce){.card-view>span:last-child{transition:none}}@media(max-width:749px){.card-title{font-size:.9rem}.card-category{font-size:.58rem}.card-wishlist{width:38px;height:38px;right:.5rem;top:.5rem}.card-view{opacity:1;transform:none;right:.5rem;bottom:.5rem;padding:.42rem .58rem}.card-image{aspect-ratio:3/4}.quick-add{min-height:44px}.card-info{padding:.65rem 0}.card-title{font-size:.9rem}}{% endstylesheet %}