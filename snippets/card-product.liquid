{% doc %}
Renders a product card with image, availability, pricing, and quick add.
@param {product} product The product to display.
@example
{% render 'card-product', product: product %}
{% enddoc %}
<article class="card"><a class="card-media-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}"><div class="card-image" data-product-card-image>{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 700 | image_tag: loading: 'lazy', class: 'card-image-secondary', alt: product.images[1].alt | default: product.title }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}{% if product.available == false %}<span class="card-badge card-badge--sold-out">{{ 'products.product.sold_out' | t }}</span>{% elsif product.compare_at_price > product.price %}<span class="card-badge card-badge--sale">{{ 'products.product.sale' | t }}</span>{% elsif product.tags contains 'new' or product.tags contains 'New' or product.tags contains 'NEW' %}<span class="card-badge card-badge--new">{{ 'products.product.new' | t }}</span>{% endif %}</div><span class="card-view" aria-hidden="true">{{ 'products.product.view' | t }}</span></a><div class="card-info"><div class="card-meta-line"><span>{{ product.type | default: 'EdenRose' | escape }}</span></div><h3 class="card-title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><div class="card-price" aria-label="{{ product.price | money }}"><span>{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div>{% if product.available %}{% if product.has_only_default_variant %}{% form 'product', product, class: 'card-quick-add' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="quick-add" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}">{{ 'products.product.add_to_cart' | t }}</button>{% endform %}{% else %}<a class="quick-add quick-add--link" href="{{ product.url }}" aria-label="{{ 'products.product.choose_options' | t }}: {{ product.title | escape }}">{{ 'products.product.choose_options' | t }}</a>{% endif %}{% endif %}</div></article>
{% stylesheet %}.card{min-width:0;display:flex;flex-direction:column;height:100%;position:relative}.card:hover .card-info{transform:translateY(-1px)}.card-media-link{display:block;border-radius:10px}.card-media-link:focus-visible{outline:var(--focus);outline-offset:4px}.card-media-link{display:block} .card-image{position:relative;overflow:hidden;aspect-ratio:4/5;background:var(--soft);border-radius:10px;isolation:isolate}.card-image img,.card-image svg{width:100%;height:100%;object-fit:cover;display:block}.card-image-secondary{position:absolute;inset:0;opacity:0}.card-media-link{position:relative}.card-media-link:hover img,.card-media-link:focus-visible img{transform:scale(1.025)}.card-media-link:hover .card-image-secondary,.card-media-link:focus-visible .card-image-secondary{opacity:1}.card-media-link:focus-visible{outline:var(--focus);outline-offset:3px}.card-view{position:absolute;right:.75rem;bottom:.75rem;padding:.45rem .7rem;background:var(--paper);color:var(--ink);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;opacity:0;transform:translateY(4px);transition:opacity .2s ease,transform .2s ease;border-radius:999px;box-shadow:0 5px 18px rgba(23,20,17,.1)}.card-media-link:hover .card-view,.card-media-link:focus-visible .card-view{opacity:1;transform:none}.card-image img{transition:transform .25s ease,opacity .2s ease}.card-badge{position:absolute;top:.65rem;left:.65rem;padding:.38rem .62rem;background:var(--paper);color:var(--ink);font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;z-index:2;border-radius:999px}.card-badge--sale{background:var(--wine);color:#fff}.card-badge--sold-out{border:1px solid var(--line)}.card-badge--sold-out{background:var(--soft)}.card-badge--new{border:1px solid var(--ink)}.card-info{padding:.9rem 0;display:flex;flex-direction:column;flex:1;transition:transform .2s ease}.card-meta-line{display:flex;justify-content:flex-start;gap:.5rem;margin-bottom:.35rem;font-size:.59rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.card-title{font-size:1rem;line-height:1.3;margin:0 0 .4rem;min-height:2.6em;letter-spacing:-.01em}.card-title a{color:inherit;text-decoration:none}.card-price{display:flex;gap:.5rem;align-items:center;font-weight:650;min-height:1.4em;font-size:.92rem}.card-quick-add{margin-top:auto}.card-price s{font-size:.9em;color:var(--muted);font-weight:400}.quick-add{display:flex;position:relative;align-items:center;justify-content:center;width:100%;margin-top:.8rem;padding:.7rem .8rem;border:1px solid var(--ink);background:transparent;color:var(--ink);font:inherit;cursor:pointer;text-decoration:none;transition:background .15s ease,color .15s ease;border-radius:999px;min-height:44px}.quick-add:hover,.quick-add:focus-visible{background:var(--ink);color:var(--paper)}.quick-add--link{align-items:center}.quick-add:focus-visible{outline:var(--focus);outline-offset:2px}@media(max-width:749px){.card-image{aspect-ratio:3/4}.card-meta-line{font-size:.55rem}.quick-add{min-height:44px}.card-info{padding:.65rem 0}.card-title{font-size:.9rem}}
{% endstylesheet %}