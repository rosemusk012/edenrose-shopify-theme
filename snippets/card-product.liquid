{% doc %}
Renders a product card with image, availability, pricing, and quick add.
@param {product} product The product to display.
@param {variant} [variant] Optional variant to display as a separate catalogue card.
@param {string} [variant_label] Optional label for the displayed variant.
@example
{% render 'card-product', product: product %}
{% enddoc %}
<article class="card{% if variant %} card--variant{% endif %}"><a class="card-media-link" href="{% if variant %}{{ variant.url }}{% else %}{{ product.url }}{% endif %}" aria-label="{{ product.title | escape }}{% if variant_label %} — {{ variant_label | escape }}{% endif %}"><div class="card-image" data-product-card-image>{% assign card_image = product.featured_image %}{% if variant and variant.featured_image %}{% assign card_image = variant.featured_image %}{% endif %}{% if card_image %}{{ card_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: card_image.alt | default: product.title }}{% if product.images.size > 1 and variant == blank %}{{ product.images[1] | image_url: width: 700 | image_tag: loading: 'lazy', class: 'card-image-secondary', alt: product.images[1].alt | default: product.title }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}{% if variant and variant.available == false %}<span class="card-badge card-badge--sold-out">{{ 'products.product.sold_out' | t }}</span>{% elsif variant and variant.compare_at_price > variant.price %}<span class="card-badge card-badge--sale">{{ 'products.product.sale' | t }}</span>{% elsif product.available == false %}<span class="card-badge card-badge--sold-out">{{ 'products.product.sold_out' | t }}</span>{% elsif product.compare_at_price > product.price %}<span class="card-badge card-badge--sale">{{ 'products.product.sale' | t }}</span>{% elsif product.tags contains 'new' or product.tags contains 'New' or product.tags contains 'NEW' %}<span class="card-badge card-badge--new">{{ 'products.product.new' | t }}</span>{% endif %}</div><span class="card-view" aria-hidden="true">{{ 'products.product.view' | t }}</span></a><div class="card-info"><div class="card-meta-line"><span>{{ product.type | default: 'EdenRose' | escape }}</span>{% if variant_label %}<span>{{ variant_label | escape }}</span>{% elsif product.available %}<span>Available</span>{% endif %}</div><h3 class="card-title"><a href="{% if variant %}{{ variant.url }}{% else %}{{ product.url }}{% endif %}">{{ product.title | escape }}</a></h3>{% if variant_label %}<p class="card-variant-label">{{ variant_label | escape }}</p>{% endif %}<div class="card-price" aria-label="{% if variant %}{{ variant.price | money }}{% else %}{{ product.price | money }}{% endif %}"><span>{% if variant %}{{ variant.price | money }}{% else %}{{ product.price | money }}{% endif %}</span>{% if variant %}{% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money }}</s>{% endif %}{% elsif product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div>{% assign card_available = product.available %}{% if variant %}{% assign card_available = variant.available %}{% endif %}{% if card_available %}{% form 'product', product, class: 'card-quick-add' %}<input type="hidden" name="id" value="{% if variant %}{{ variant.id }}{% else %}{{ product.selected_or_first_available_variant.id }}{% endif %}"><input type="hidden" name="quantity" value="1"><button type="submit" class="quick-add" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}{% if variant_label %} — {{ variant_label | escape }}{% endif %}">{{ 'products.product.add_to_cart' | t }}</button>{% endform %}{% endif %}</div></article>{% stylesheet %}.card{min-width:0;display:flex;flex-direction:column;height:100%;position:relative}.card:hover .card-info{transform:translateY(-1px)}.card-media-link{display:block;border-radius:10px}.card-media-link:focus-visible{outline:var(--focus);outline-offset:4px}.card-image{position:relative;overflow:hidden;aspect-ratio:4/5;background:var(--soft);border-radius:10px;isolation:isolate}.card-image img,.card-image svg{width:100%;height:100%;object-fit:cover;display:block}.card-image-secondary{position:absolute;inset:0;opacity:0}.card-media-link{position:relative}.card-media-link:hover img,.card-media-link:focus-visible img{transform:scale(1.025)}.card-media-link:hover .card-image-secondary,.card-media-link:focus-visible .card-image-secondary{opacity:1}.card-view{position:absolute;right:.75rem;bottom:.75rem;padding:.45rem .7rem;background:var(--paper);color:var(--ink);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;opacity:0;transform:translateY(4px);transition:opacity .2s ease,transform .2s ease;border-radius:999px;box-shadow:0 5px 18px rgba(23,20,17,.1)}.card-media-link:hover .card-view,.card-media-link:focus-visible .card-view{opacity:1;transform:none}.card-image img{transition:transform .25s ease,opacity .2s ease}.card-badge{position:absolute;top:.65rem;left:.65rem;padding:.38rem .62rem;background:var(--paper);color:var(--ink);font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;z-index:2;border-radius:999px}.card-badge--sale{background:var(--wine);color:#fff}.card-badge--sold-out{background:var(--soft);border:1px solid var(--line)}.card-badge--new{border:1px solid var(--ink)}.card-info{padding:.9rem 0;display:flex;flex-direction:column;flex:1;transition:transform .2s ease}.card-meta-line{display:flex;justify-content:space-between;gap:.5rem;margin-bottom:.35rem;font-size:.59rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.card-meta-line span:last-child{color:var(--accent)}.card-title{font-size:1rem;line-height:1.3;margin:0 0 .4rem;min-height:2.6em;letter-spacing:-.01em}.card-title a{color:inherit;text-decoration:none}.card-variant-label{margin:-.2rem 0 .4rem;font-size:.72rem;color:var(--muted);line-height:1.3}.card-price{display:flex;gap:.5rem;align-items:center;font-weight:650;min-height:1.4em;font-size:.92rem}.card-quick-add{margin-top:auto}.card-price s{font-size:.9em;color:var(--muted);font-weight:400}.quick-add{display:flex;position:relative;align-items:center;justify-content:center;width:100%;margin-top:.8rem;padding:.7rem .8rem;border:1px solid var(--ink);background:transparent;color:var(--ink);font:inherit;cursor:pointer;text-decoration:none;transition:background .15s ease,color .15s ease;border-radius:999px;min-height:44px}.quick-add:hover,.quick-add:focus-visible{background:var(--ink);color:var(--paper)}.quick-add--link{align-items:center}.quick-add:focus-visible{outline:var(--focus);outline-offset:2px}@media(max-width:749px){.card-image{aspect-ratio:3/4}.card-meta-line{font-size:.55rem}.quick-add{min-height:44px}.card-info{padding:.65rem 0}.card-title{font-size:.9rem}.card-variant-label{font-size:.68rem}}
{% endstylesheet %}