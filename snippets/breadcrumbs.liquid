<nav class="breadcrumbs page-width" itemscope itemtype="https://schema.org/BreadcrumbList" aria-label="{{ 'general.breadcrumbs' | t }}">
  <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
    <a href="{{ routes.root_url }}" itemprop="item"><span itemprop="name">{{ 'general.home' | t }}</span></a>
    <meta itemprop="position" content="1">
  </span><span aria-hidden="true">/</span>
  {% if template.name == 'product' %}
    {% if collection %}
      <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ collection.url }}" itemprop="item"><span itemprop="name">{{ collection.title | escape }}</span></a>
        <meta itemprop="position" content="2">
      </span><span aria-hidden="true">/</span>
      <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span aria-current="page" itemprop="name">{{ product.title | escape }}</span>
        <meta itemprop="position" content="3">
      </span>
    {% else %}
      <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span aria-current="page" itemprop="name">{{ product.title | escape }}</span>
        <meta itemprop="position" content="2">
      </span>
    {% endif %}
  {% elsif template.name == 'collection' %}
    <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span aria-current="page" itemprop="name">{{ collection.title | escape }}</span>
      <meta itemprop="position" content="2">
    </span>
  {% elsif template.name == 'page' %}
    <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span aria-current="page" itemprop="name">{{ page.title | escape }}</span>
      <meta itemprop="position" content="2">
    </span>
  {% elsif template.name == 'search' %}
    <span aria-current="page">{{ 'templates.search.eyebrow' | t }}</span>
  {% elsif template.name == 'cart' %}
    <span aria-current="page">{{ 'templates.cart.eyebrow' | t }}</span>
  {% endif %}
</nav>
{% stylesheet %}
.breadcrumbs{display:flex;align-items:center;gap:.55rem;padding-top:1rem;padding-bottom:0;font-size:.75rem;color:var(--muted);overflow:auto;white-space:nowrap}.breadcrumbs a{text-decoration:underline;text-underline-offset:3px}.breadcrumbs [aria-current="page"]{color:var(--ink);overflow:hidden;text-overflow:ellipsis}@media(max-width:749px){.breadcrumbs{padding-top:.75rem;font-size:.72rem}}
{% endstylesheet %}