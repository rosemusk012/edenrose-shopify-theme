<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="canonical" href="{{ canonical_url }}">
<title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
{% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
{{ content_for_header }}
<style>
:root{--ink:#171411;--paper:#faf7f1;--soft:#eee7dc;--muted:#756e65;--line:#ddd6ca;--accent:#9b7351;--max:1280px;--radius:2px;--focus:2px solid var(--accent)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.5}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button,a,input,select,summary{outline-offset:3px}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:var(--focus)}.page-width{max-width:var(--max);margin:auto;padding:0 24px}.skip-link{position:absolute;left:-9999px}.skip-link:focus{left:16px;top:16px;background:var(--ink);color:#fff;padding:10px;z-index:100}.announcement{background:var(--ink);color:#fff;text-align:center;padding:9px 16px;font-size:12px;letter-spacing:.08em}.site-header{position:sticky;top:0;z-index:30;background:rgba(250,247,241,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(10px)}.header-row{min-height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px}.brand{font:27px Georgia,serif;letter-spacing:.04em}.nav{display:flex;justify-content:center;gap:26px;font-size:14px}.nav a:hover{text-decoration:underline;text-underline-offset:4px}.header-actions{display:flex;justify-content:flex-end;gap:16px;font-size:14px}.hero{padding:72px 0 58px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:50px;align-items:center}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:11px;color:var(--muted);margin:0 0 14px}.hero h1{font:normal clamp(46px,7vw,88px)/.95 Georgia,serif;margin:0 0 22px}.hero p{font-size:18px;max-width:590px;color:#514b44}.button{display:inline-flex;align-items:center;justify-content:center;background:var(--ink);color:#fff;padding:14px 22px;border:1px solid var(--ink);min-height:48px;cursor:pointer;transition:transform .2s ease,opacity .2s ease}.button:hover{opacity:.88;transform:translateY(-1px)}.button--secondary{background:transparent;color:var(--ink)}.hero-art{aspect-ratio:4/5;background:var(--soft);display:flex;align-items:flex-end;padding:28px}.hero-art span{font:42px Georgia,serif}.section{padding:64px 0}.section-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:28px}.section h2{font:normal 42px Georgia,serif;margin:0}.section-head p{color:var(--muted);margin:0}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.card-image{aspect-ratio:3/4;background:var(--soft);overflow:hidden}.card-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s}.card:hover .card-image img{transform:scale(1.025)}.card-info{padding:13px 0}.card-title{font-size:14px;margin:0 0 5px}.card-price{font-size:14px}.card-price s{color:var(--muted);margin-left:6px}.collection-hero{padding:50px 0 35px;border-bottom:1px solid var(--line)}.collection-hero h1{font:normal 56px Georgia,serif;margin:0}.collection-hero p{max-width:680px;color:var(--muted)}.toolbar{display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--line);margin-bottom:28px}.toolbar select{padding:10px 12px;background:transparent;border:1px solid var(--line)}.product-page{padding:55px 0}.product-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:50px}.product-media{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.product-media img{width:100%;display:block;background:var(--soft)}.product-info{position:sticky;top:110px;align-self:start}.product-info h1{font:normal 48px/1.05 Georgia,serif;margin:0 0 12px}.product-description{color:#5b554e}.product-form{margin-top:28px}.product-form select,.product-form input{width:100%;padding:13px;border:1px solid var(--line);background:transparent;margin:7px 0 16px}.product-form button{width:100%;cursor:pointer}.trust-row{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);margin-top:24px}.trust{background:var(--paper);padding:18px;font-size:13px}.trust strong{display:block;margin-bottom:4px}.page-content,.cart{padding:60px 0}.page-content h1,.cart h1{font:normal 52px Georgia,serif}.page-content .rte{max-width:780px;color:#514b44}.cart-row{display:grid;grid-template-columns:100px 1fr auto;gap:18px;padding:18px 0;border-bottom:1px solid var(--line);align-items:center}.cart-row img{width:100px;height:125px;object-fit:cover;background:var(--soft)}.cart-summary{margin:30px 0 0 auto;max-width:360px}.cart-summary .button{width:100%;margin-top:8px}.site-footer{border-top:1px solid var(--line);padding:45px 0;margin-top:40px}.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:40px}.footer-grid h2,.footer-grid h3{font-family:Georgia,serif;font-weight:normal}.footer-note{color:var(--muted);font-size:13px}.pagination{display:flex;justify-content:center;gap:14px;padding-top:35px}@media(max-width:900px){.header-row{grid-template-columns:1fr auto;padding:12px 0}.nav{grid-column:1/-1;grid-row:2;justify-content:flex-start;overflow:auto;padding-bottom:12px}.hero-grid,.product-layout{grid-template-columns:1fr}.hero-art{max-width:520px}.product-info{position:static}.product-grid{grid-template-columns:repeat(2,1fr)}.footer-grid{grid-template-columns:1fr}.trust-row{grid-template-columns:1fr}}@media(max-width:560px){.page-width{padding:0 16px}.hero{padding-top:45px}.hero h1{font-size:52px}.section h2,.collection-hero h1,.product-info h1,.cart h1,.page-content h1{font-size:38px}.product-grid{gap:14px}.header-actions span:first-child{display:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}}img{max-width:100%;height:auto}button:disabled{cursor:not-allowed;opacity:.55}@media(max-width:560px){.page-width{padding-inline:16px}.button{min-height:50px}.section{padding-block:48px}}\n</style>
</head>
<body>
<a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
{% if settings.announcement != blank %}<div class="announcement">{{ settings.announcement | escape }}</div>{% endif %}
{% section 'header' %}
<main id="MainContent" role="main">{{ content_for_layout }}</main>
{% section 'footer' %}
</body>
</html>