<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.color_paper }}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
{%- if settings.favicon != blank %}
<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
{%- endif %}
{%- liquid
  assign body_font = settings.type_body_font
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_semibold = body_font | font_modify: 'weight', '600'
  assign heading_font = settings.type_heading_font
  assign heading_font_medium = heading_font | font_modify: 'weight', '500'
  assign heading_font_italic = heading_font | font_modify: 'style', 'italic'
%}
<link rel="preload" as="font" href="{{ body_font | font_url }}" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="{{ heading_font | font_url }}" type="font/woff2" crossorigin>
<title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
{% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
{% render 'meta-tags' %}
<style>
{{ body_font | font_face: font_display: 'swap' }}
{{ body_font_medium | font_face: font_display: 'swap' }}
{{ body_font_semibold | font_face: font_display: 'swap' }}
{{ heading_font | font_face: font_display: 'swap' }}
{{ heading_font_medium | font_face: font_display: 'swap' }}
{{ heading_font_italic | font_face: font_display: 'swap' }}
:root{--ink:{{ settings.color_ink }};--paper:{{ settings.color_paper }};--soft:{{ settings.color_soft }};--muted:{{ settings.color_muted }};--line:{{ settings.color_line }};--accent:{{ settings.color_accent }};--rose:{{ settings.color_rose }};--wine:{{ settings.color_wine }};--blush:{{ settings.color_blush }};--on-dark:#fff;--max:1280px;--radius:3px;--focus:2px solid var(--accent);--display:{{ heading_font.family }},{{ heading_font.fallback_families }};--body:{{ body_font.family }},{{ body_font.fallback_families }}}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);line-height:1.5}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button,a,input,select,summary{outline-offset:3px}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:var(--focus)}.page-width{max-width:var(--max);margin:auto;padding:0 24px}.visually-hidden{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.skip-link{position:absolute;left:-9999px}.skip-link:focus{left:16px;top:16px;background:var(--ink);color:#fff;padding:10px;z-index:100}.announcement{background:var(--wine);color:#fff;text-align:center;padding:9px 16px;font-size:11px;letter-spacing:.1em;text-transform:uppercase}.site-header{position:sticky;top:0;z-index:30;background:rgba(251,247,243,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(10px)}.header-row{min-height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px}.brand{font:500 29px var(--display);letter-spacing:.03em;white-space:nowrap}.nav{display:flex;justify-content:center;gap:26px;font-size:13px;letter-spacing:.02em}.nav a:hover{text-decoration:underline;text-underline-offset:4px}.header-actions{display:flex;justify-content:flex-end;gap:16px;font-size:13px}.hero{padding:64px 0 54px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:50px;align-items:center}.hero-copy{position:relative}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:10px;color:var(--muted);margin:0 0 14px}.hero h1{font:normal clamp(46px,7vw,88px)/.95 var(--display);margin:0 0 22px;max-width:9ch}.hero p{font-size:17px;max-width:590px;color:#5d5352}.button{display:inline-flex;align-items:center;justify-content:center;background:var(--ink);color:#fff;padding:14px 22px;border:1px solid var(--ink);min-height:48px;cursor:pointer;transition:transform .2s ease,opacity .2s ease}.button:hover{opacity:.88;transform:translateY(-2px)}.button--secondary{background:transparent;color:var(--ink)}.hero-art{aspect-ratio:4/5;background:var(--rose);display:flex;align-items:flex-end;padding:28px;position:relative;overflow:hidden}.hero-art:after{content:'EDENROSE';position:absolute;right:-12%;top:8%;font:italic 80px var(--display);opacity:.12;transform:rotate(-12deg)}.hero-art span{font:42px var(--display);position:relative;z-index:1}.section{padding:64px 0}.section-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:28px}.section h2{font:normal 42px var(--display);margin:0}.section-head p{color:var(--muted);margin:0}.page-content,.cart{padding:60px 0}.page-content h1,.cart h1{font:normal 52px var(--display)}.page-content .rte{max-width:780px;color:#514b49}@media(max-width:900px){.header-row{grid-template-columns:1fr auto;padding:12px 0}.nav{grid-column:1/-1;grid-row:2;justify-content:flex-start;overflow:auto;padding-bottom:12px}.hero-grid{grid-template-columns:1fr}.hero-art{max-width:520px}.product-info{position:static}.product-grid{grid-template-columns:repeat(2,1fr)}.footer-grid{grid-template-columns:1fr}}@media(max-width:560px){.page-width{padding-inline:16px}.hero{padding-top:45px}.hero h1{font-size:52px}.section h2,.collection-hero h1,.product-info h1,.cart h1,.page-content h1{font-size:38px}.product-grid{gap:14px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}}img{max-width:100%;height:auto}button:disabled{cursor:not-allowed;opacity:.55}@media(max-width:560px){.button{min-height:50px}.section{padding-block:48px}}
</style>
{{ content_for_header }}
<script src="{{ 'edenrose-search.js' | asset_url }}" defer></script>
</head>
<body>
<a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
{% if settings.announcement != blank %}<div class="announcement">{{ settings.announcement | escape }}</div>{% endif %}
{% sections 'header-group' %}
<main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
{% sections 'footer-group' %}
</body>
</html>
