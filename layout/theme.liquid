<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.color_paper }}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
{%- if settings.favicon != blank %}
<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
{%- endif %}
{%- liquid
  assign body_font = settings.type_body_font
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_semibold = body_font | font_modify: 'weight', '600'
  assign heading_font = settings.type_heading_font
  assign heading_font_medium = heading_font | font_modify: 'weight', '500'
  assign heading_font_italic = heading_font | font_modify: 'style', 'italic'
%}
{%- unless body_font.system? %}{{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}{% endunless %}
{%- unless heading_font.system? %}{{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}{% endunless %}
<title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
{% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
{% render 'meta-tags' %}
<style>
{{ body_font | font_face: font_display: 'swap' }}
{{ body_font_medium | font_face: font_display: 'swap' }}
{{ body_font_semibold | font_face: font_display: 'swap' }}
{{ heading_font | font_face: font_display: 'swap' }}
{{ heading_font_medium | font_face: font_display: 'swap' }}
{{ heading_font_italic | font_face: font_display: 'swap' }}
:root{--ink:{{ settings.color_ink }};--paper:{{ settings.color_paper }};--soft:{{ settings.color_soft }};--muted:{{ settings.color_muted }};--line:{{ settings.color_line }};--accent:{{ settings.color_accent }};--rose:{{ settings.color_rose }};--wine:{{ settings.color_wine }};--blush:{{ settings.color_blush }};--on-dark:#fff;--max:1280px;--radius:3px;--focus:2px solid var(--accent);--display:{{ heading_font.family }},{{ heading_font.fallback_families }};--body:{{ body_font.family }},{{ body_font.fallback_families }}}
</style>
{{ 'edenrose-base.css' | asset_url | stylesheet_tag: preload: true }}
{{ content_for_header }}
<script src="{{ 'edenrose-search.js' | asset_url }}" defer></script>
</head>
<body>
<a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
{% if settings.announcement != blank %}<div class="announcement">{{ settings.announcement | escape }}</div>{% endif %}
{% sections 'header-group' %}
<main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
{% sections 'footer-group' %}
</body>
</html>
